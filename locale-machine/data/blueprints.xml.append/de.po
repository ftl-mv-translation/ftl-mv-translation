#: src-en/data/blueprints.xml.append:11137
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"FTL_JUMPER_GOOD\"]/desc"
msgstr "Das solltest du eigentlich noch nicht sehen."

#: src-en/data/blueprints.xml.append:11146
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"SECTOR_SCANNER\"]/title"
msgstr "Sektorscanner"

#: src-en/data/blueprints.xml.append:11147
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"SECTOR_SCANNER\"]/desc"
msgstr ""
"Ermöglicht es dir, den genauen Typ eines Sektors zu sehen, selbst wenn er "
"nicht an den aktuellen angrenzt."

#: src-en/data/blueprints.xml.append:11156
msgid ""
