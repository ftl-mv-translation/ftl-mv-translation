msgstr "Sporen-Verteiler [T]"

#: src-en/data/blueprints.xml.append:12225
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"SPORE_AIR_TOXIC\"]/desc"
msgstr ""
"[AKTUELLER MODUS: Toxisch] Flutet das Schiff entweder mit toxischen oder mit verjüngenden Sporen.\n"
"\tToxisch – Feindliche Crew auf deinem Schiff bewegt sich 20% langsamer und erleidet 20% mehr Schaden aus ALLEN Quellen.\n"
"\tVerjüngend – Verbündete Crew auf deinem Schiff hat 10% mehr Gesundheit und bewegt sich 20% schneller. Ist eine Krankenstation vorhanden, regenerieren sie zudem 1hp/s."

#: src-en/data/blueprints.xml.append:12234
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"SPORE_AIR_BUFF\"]/title"
msgstr "Sporen-Verteiler [R]"

#: src-en/data/blueprints.xml.append:12235
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"SPORE_AIR_BUFF\"]/desc"
msgstr ""
"[AKTUELLER MODUS: Verjüngend] Flutet das Schiff entweder mit toxischen oder mit verjüngenden Sporen.\n"
"\tToxisch – Feindliche Crew auf deinem Schiff bewegt sich 20% langsamer und erleidet 20% mehr Schaden aus ALLEN Quellen.\n"
"\tVerjüngend – Verbündete Crew auf deinem Schiff hat 10% mehr Gesundheit und bewegt sich 20% schneller. Ist eine Krankenstation vorhanden, regenerieren sie zudem 1hp/s."

#: src-en/data/blueprints.xml.append:12245
