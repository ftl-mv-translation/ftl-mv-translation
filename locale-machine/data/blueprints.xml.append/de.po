#: src-en/data/blueprints.xml.append:11663
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"FLAGSHIP_SHIELD_FULL\"]/desc"
msgstr "Sehr mächtiger Energieschild."

