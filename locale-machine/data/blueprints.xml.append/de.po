#: src-en/data/blueprints.xml.append:12046
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"HEKTAR_GEL\"]/desc"
msgstr ""
"Eine REVOLUTIONÄRE, brandneue Variante des Slug-Reparaturgels, exklusiv hergestellt von Hektar Industries(tm), mit einer kleinen Beimischung Lizard für das unverkennbare Aroma.\n"
"\t\n"
"\tAlle Crew bewegt sich in leeren Räumen 20% langsamer, doch Verbündete erleiden darin 50% weniger Schaden aus allen Quellen und profitieren zudem von 50% Betäubungsresistenz.\n"
"\tBietet zudem eine günstigere Reparaturoption an leeren Signalpunkten."

#: src-en/data/blueprints.xml.append:12058
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"PLEASURE_GEL\"]/title"
msgstr "Verdächtiges Gel"

#: src-en/data/blueprints.xml.append:12059
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"PLEASURE_GEL\"]/desc"
msgstr ""
