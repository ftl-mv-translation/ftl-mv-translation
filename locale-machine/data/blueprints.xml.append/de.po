msgid "data/blueprints.xml.append$//augBlueprint[@name=\"SPORE_AIR_ELITE\"]/desc"
msgstr ""
"Alle Vampweeds, die du auf diesem Schiff bekommst, werden dauerhaft zu "
"Cultivators. Für jeden Cultivator an Bord verliert alle Nicht-Vampweed-Crew "
"auf deinem Schiff aufgrund der Wirksamkeit der verteilten Sporen zusätzlich "
"15% maximale Gesundheit."

#: src-en/data/blueprints.xml.append:12254
