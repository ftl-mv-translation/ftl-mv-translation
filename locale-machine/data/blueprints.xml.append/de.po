#: src-en/data/blueprints.xml.append:11689
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"ENEMY_RESIST_50\"]/desc"
msgstr "Deine Hülle hat eine 50%ige Resistenzchance."

#: src-en/data/blueprints.xml.append:11697
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"NO_GHOST\"]/title"
msgstr "Befreiungsgitter"

#: src-en/data/blueprints.xml.append:11698
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"NO_GHOST\"]/desc"
msgstr ""
"Reduziert die Sabotagegeschwindigkeit von Ghosts um 20%.\n"
"\tIst ein Türsteuerungssystem vorhanden und funktionsfähig, verlieren alle feindliche Crew und Drohnen an Bord 4hp/s, plus 1hp/s zusätzlich für jede Stufe der Türsteuerung über 1."

#: src-en/data/blueprints.xml.append:11707
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"NO_SUFFOCATE\"]/title"
msgstr "Kann nicht ersticken."

#: src-en/data/blueprints.xml.append:11708
msgid "data/blueprints.xml.append$//augBlueprint[@name=\"NO_SUFFOCATE\"]/desc"
msgstr ""
