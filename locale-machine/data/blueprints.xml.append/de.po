#: src-en/data/blueprints.xml.append:11514
msgid ""
"data/blueprints.xml.append$//weaponBlueprint[@name=\"CRYSTAL_ARMOR_PROJ_SHATTER\"]/desc"
msgstr "KRISTALL-RACHE-GESCHOSS"

#: src-en/data/blueprints.xml.append:11550
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"STORE_BEACON_SYLVAN\"]/title"
msgstr "Nexus-Signalpunkt"

#: src-en/data/blueprints.xml.append:11551
msgid ""
"data/blueprints.xml.append$//augBlueprint[@name=\"STORE_BEACON_SYLVAN\"]/desc"
msgstr ""
"Öffnet einen Riss direkt zum Nexus, wodurch du hochwertige Gegenstände "
