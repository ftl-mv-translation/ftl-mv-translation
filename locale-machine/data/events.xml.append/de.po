#: src-en/data/events.xml.append:144
msgid "data/events.xml.append$//event[@name=\"START_BEACON_TUTORIAL_SKIP\"]/text"
msgstr ""
"Bist du sicher, dass du das Tutorial überspringen willst? Das wird nur denen empfohlen, die Multiverse bereits seit Version 5.0 gespielt haben.\n"
"\t\t\t\n"
"\t\t\tDu kannst das Tutorial auch jetzt überspringen und es später zu Beginn eines neuen Durchlaufs erneut spielen."

#: src-en/data/events.xml.append:148
msgid ""
"data/events.xml.append$//event[@name=\"START_BEACON_TUTORIAL_SKIP\"]/choice[1]/text"
