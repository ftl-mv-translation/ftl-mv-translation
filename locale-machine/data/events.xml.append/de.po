#: src-en/data/events.xml.append:95
msgid "data/events.xml.append$//event[@name=\"START_BEACON_TUTORIAL\"]/text"
msgstr ""
"[TUTORIAL VERFÜGBAR!]\n"
"\tHallo! Willkommen bei FTL: Multiverse. Anscheinend ist dies dein erster Durchlauf seit Version 5.4. Ein neues Tutorial im Spiel ist verfügbar, um dich mit einigen neuen Spielmechaniken vertraut zu machen. Möchtest du es ausprobieren?\n"
"\t\n"
"\tDu kannst das Tutorial jederzeit in zukünftigen Durchläufen wiederholen."

#: src-en/data/events.xml.append:106
msgid ""
"data/events.xml.append$//event[@name=\"START_BEACON_TUTORIAL\"]/eventButton[@name=\"UI_STORAGE_CHECK_BUTTON\"]/tooltip"
msgstr "Das Inventar öffnen."

