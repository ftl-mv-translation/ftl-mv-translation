msgid ""
"data/events_sector_auto.xml$//event[@name=\"AUTO_GHOST_WANTWRECK\"]/choice[1]/event/choice[1]/event/text"
msgstr ""
"Die Vagabonds senden dir die Koordinaten des Schiffes, das du besiegen "
"sollst, und wünschen dir viel Glück."

#: src-en/data/events_sector_auto.xml:1105
msgid ""
"data/events_sector_auto.xml$//event[@name=\"AUTO_GHOST_WANTWRECK\"]/choice[1]/event/choice[2]/text"
