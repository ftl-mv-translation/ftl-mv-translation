#: src-en/data/events_sector_auto.xml:741
msgid ""
"data/events_sector_auto.xml$//event[@name=\"AUTO_PIRATE_CHOICE_AUTO_WIN\"]/text"
msgstr ""
"\"Wir hatten keine Unterstützung von einem Föderationsschiff erwartet. Um "
"ehrlich zu sein, hatte ich vor, dieses Schiff zu verschrotten. Trotzdem, ich"
" mag ein Pirat sein, aber ich bin immer noch ein Mann, der keine Schulden "
"machen will. Also, hier, nimm diesen Müll.\""

#: src-en/data/events_sector_auto.xml:745
msgid ""
"data/events_sector_auto.xml$//event[@name=\"AUTO_PIRATE_CHOICE_PIRATE_WIN\"]/text"
msgstr ""
"\"Logikfehler: Föderationsschiff hat im Kampf geholfen. Widersprüchlicher "
"interner Code... erfordert Neustart.\" Das Auto-Schiff fällt offline. Du "
"nutzt diese Gelegenheit, um es zu verschrotten."

#: src-en/data/events_sector_auto.xml:750
msgid "data/events_sector_auto.xml$//event[@name=\"AUTO_MINER\"]/text"
msgstr ""
"In diesem Asteroidenfeld an diesem Signalpunkt befindet sich eine "
"Bergbauplattform und ein automatisiertes Bergungs-Schiff. Das Bergungs-"
"Schiff bemerkt dich nicht, während es die Asteroiden abgrast."

#: src-en/data/events_sector_auto.xml:754
msgid "data/events_sector_auto.xml$//event[@name=\"AUTO_MINER\"]/choice[1]/text"
msgstr "Greife das Schiff an, um zur Plattform zu gelangen."

#: src-en/data/events_sector_auto.xml:756
msgid ""
"data/events_sector_auto.xml$//event[@name=\"AUTO_MINER\"]/choice[1]/event/text"
msgstr ""
