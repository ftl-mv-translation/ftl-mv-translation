#: src-en/data/events_sector_clan.xml:579
msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/text"
msgstr ""
"Obwohl die Gilde normalerweise in Nebel wie bei den Slugs bleibt, scheint "
"hier in dieser Lichtung ein Handelsstützpunkt eingerichtet worden zu sein, "
"um besseren Handel anzuziehen. Das scheint gut funktioniert zu haben... denn"
" ein tiefschwarzes und sehr mächtiges Slug-Schiff hält die Lodge als Geisel "
"und verlangt von den Clansleuten, ihre 'exotischen Gewürze' abzugeben. "
"Wahrscheinlich Drogen, wenn du raten müsstest."

#: src-en/data/events_sector_clan.xml:581
msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[1]/text"
msgstr "Greife das schwarze Slug-Schiff an."

#: src-en/data/events_sector_clan.xml:583
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[1]/event/text"
msgstr "Du rüstest die Waffen und greifst das seltsame Slug-Schiff an."

#: src-en/data/events_sector_clan.xml:586
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[1]/event/choice/text"
