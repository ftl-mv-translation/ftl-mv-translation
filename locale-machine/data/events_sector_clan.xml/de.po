#: src-en/data/events_sector_clan.xml:544
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_CRISIS\"]/choice[1]/event/choice[1]/event/text"
msgstr ""
"Du rüstest deine Waffen und greifst den Clansmann an. Es sieht nicht einmal "
"so aus, als würden sie versuchen, zurückzuschlagen."

#: src-en/data/events_sector_clan.xml:551
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_CRISIS\"]/choice[1]/event/choice[1]/event/choice/text"
