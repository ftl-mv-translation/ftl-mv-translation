msgstr "Gib ihnen 7 Drohnenteile."

#: src-en/data/events_sector_clan.xml:1477
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_SHELL_RADIANT\"]/choice[1]/event/choice[2]/event/choice[2]/event/text"
msgstr ""
