#: src-en/data/events_sector_clan.xml:1908
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_DISTRESS_CLAN_DUSK\"]/choice[2]/event/text"
msgstr "Du rüstest die Waffen und greifst das Clansmann-Schiff an."

#: src-en/data/events_sector_clan.xml:1911
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_DISTRESS_CLAN_DUSK\"]/choice[2]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_clan.xml:1917
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_DISTRESS_CLAN_DUSK\"]/choice[3]/text"
