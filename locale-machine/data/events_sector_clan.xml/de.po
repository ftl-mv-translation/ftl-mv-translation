#: src-en/data/events_sector_clan.xml:514
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[@req=\"LIST_CREW_CRYSTAL\"]/event/text"
msgstr ""
"\"Oh, hallo Freund! Ich nehme an, du hast ein schönes Souvenir, das du "
"unbedingt kaufen willst, aber gerade kein Kleingeld dabei hast, und ich "
"helfe dir gerne!\" Die Crystals schicken etwas Schrott, und du erwähnst "
"nicht, dass du ein Kriegsschiff bist."

#: src-en/data/events_sector_clan.xml:519
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[5]/text"
