#: src-en/data/events_sector_clan.xml:1485
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_SHELL_RADIANT\"]/choice[1]/event/choice[2]/event/choice[3]/text"
msgstr "Doch nicht."

