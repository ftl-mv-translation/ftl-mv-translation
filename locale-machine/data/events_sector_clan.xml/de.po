#: src-en/data/events_sector_clan.xml:236
msgid ""
"data/events_sector_clan.xml$//eventList[@name=\"CLAN_25_50_25_MID\"]/event[1]/text"
msgstr ""
"Die Angriffsdrohne macht ihren Job, indem sie den Hauptschlag des Ungetüms "
"abfängt und gleichzeitig selbst ordentlich Schaden anrichtet. Die Clansmens "
"können den Tag mit nur einem Verlust gewinnen."

#: src-en/data/events_sector_clan.xml:241
msgid ""
"data/events_sector_clan.xml$//eventList[@name=\"CLAN_25_50_25_MID\"]/event[1]/choice/text"
