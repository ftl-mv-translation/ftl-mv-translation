msgstr "(Gilden-Crew) Biete ihnen eine Liste von Zielen an."

#: src-en/data/events_sector_clan.xml:496
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[@req=\"LIST_CREW_CLAN\"]/event/text"
msgstr ""
"\"Oh, du bist einer von ihnen! Ich weiß dein Angebot sehr zu schätzen, aber "
"es gibt keinen Grund. Wir haben uns schon früher eine Karte gekauft, wir "
"können dir gerne eine Kopie geben!\""

#: src-en/data/events_sector_clan.xml:501
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[@req=\"weapons\"]/text"
msgstr "(Waffen-Verbesserung) Gib mir alles, was du hast, oder stirb."

#: src-en/data/events_sector_clan.xml:503
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[@req=\"weapons\"]/event/text"
msgstr ""
"\"Bei den Krypten! Kein Grund so feindselig zu sein! Wir geben dir alles, "
"was du willst!\" Die Kristalle senden einige Vorräte zu."

#: src-en/data/events_sector_clan.xml:506
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[@req=\"weapons\"]/event/choice/text"
