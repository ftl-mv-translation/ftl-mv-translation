"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_PLUSHIES\"]/choice[1]/event/choice/event/choice[1]/event/text"
msgstr ""
"\"Das ist ein G.A.Sss! Das steht für 'Giant Alien Ssspider'. Keine Ahnung, "
"wie der wissenschaftliche Begriff ist, das ist einfach nur, was alle sie "
"nennen.\""

#: src-en/data/events_sector_clan.xml:1107
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_PLUSHIES\"]/choice[1]/event/choice/event/choice[1]/event/choice[1]/text"
msgstr "Kauf das Plüschtier. [7~]"

#: src-en/data/events_sector_clan.xml:1109
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_PLUSHIES\"]/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/text"
msgstr ""
"\"Oh, danke für dein Geschäft! Das ist wahrscheinlich mein erster Gewinn "
"seit... nun ja, je. Ich glaube, einen Shop in einem Nebel einzurichten, war "
"keine gute Idee.\""

#: src-en/data/events_sector_clan.xml:1114
msgid ""
