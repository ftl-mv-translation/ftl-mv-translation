#: src-en/data/events_sector_clan.xml:2551
msgid ""
"data/events_sector_clan.xml$//ship[@name=\"SHIP_SALT_ABANDONED\"]/surrender/text"
msgstr ""
"\"Verdammt euch alle zur Hölle, ihr fauligen Schimmelsporen! Was braucht es,"
" um euch zu vertreiben? Der Boss ist nicht hier, ich sagte doch, es gibt "
"keinen Grund, uns zu töten, die Gilde kümmert sich einen Dreck um uns!\""

#: src-en/data/events_sector_clan.xml:2553
