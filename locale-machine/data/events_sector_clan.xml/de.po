"data/events_sector_clan.xml$//event[@name=\"NEBULA_LIGHT_SALT_QUEST\"]/choice[1]/event/choice[2]/text"
msgstr "Nicht das Risiko wert, ziehen wir ab."

#: src-en/data/events_sector_clan.xml:2672
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_LIGHT_SALT_QUEST\"]/choice[2]/text"
