#: src-en/data/events_sector_clan.xml:563
msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_CRISIS\"]/choice[2]/text"
msgstr "Ignoriere den Clansmann."

#: src-en/data/events_sector_clan.xml:565
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_CRISIS\"]/choice[2]/event/text"
msgstr "Wer weiß, das könnte eine Falle sein. Du ignorierst den Clansmann."

#: src-en/data/events_sector_clan.xml:567
