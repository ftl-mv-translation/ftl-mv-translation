msgid ""
"data/events_sector_clan.xml$//event[@name=\"SYLVAN_SALT_QUEST_ACCEPT\"]/text"
msgstr ""
"\"Ah! Das ist ja super, Fremder! Du Renegat, so zuverlässig. Deshalb mag ich"
" dich, Fremder. Sag mal, wie wäre es mit einem kleinen Tausch?\""

#: src-en/data/events_sector_clan.xml:2525
msgid ""
"data/events_sector_clan.xml$//event[@name=\"SYLVAN_SALT_QUEST_ACCEPT\"]/choice[1]/text"
msgstr "Zustimmen."

