"data/events_sector_clan.xml$//ship[@name=\"SHIP_SALT_ABANDONED\"]/surrender/choice[1]/event/choice/text"
msgstr "Sylvan hat uns geschickt."

#: src-en/data/events_sector_clan.xml:2561
