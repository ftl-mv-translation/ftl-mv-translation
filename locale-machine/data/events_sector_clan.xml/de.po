#: src-en/data/events_sector_clan.xml:1007
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[1]/event/choice[3]/text"
msgstr "Frag stattdessen nach diesen 'Equinoiden'."

#: src-en/data/events_sector_clan.xml:1009
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[1]/event/choice[3]/event/text"
msgstr ""
"\"Niemand weiß wirklich, wo die herkommen, aber durch das Reisen durch den "
"Weltraum wurden sie auf hundert Planeten in der Galaxie gebracht. Sie sind "
"ziemlich harmlos, solange du freundlich zu ihnen bist.\""

#: src-en/data/events_sector_clan.xml:1011
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[1]/event/choice[3]/event/choice[1]/text"
msgstr "Kau ein gezähmtes Equinoid."

#: src-en/data/events_sector_clan.xml:1020
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[1]/event/choice[3]/event/choice[2]/text"
msgstr "Kau eines ihrer jüngeren, ungezähmten Equinoiden."

#: src-en/data/events_sector_clan.xml:1029
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[1]/event/choice[3]/event/choice[3]/text"
msgstr "Interessant, aber keinen Grund, hier zu bleiben."

#: src-en/data/events_sector_clan.xml:1035
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[1]/event/choice[4]/text"
msgstr ""
"Unsere Mission ist zu wichtig, um Zeit mit einem Wettbewerb zu verschwenden."

#: src-en/data/events_sector_clan.xml:1041
msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_CLAN_RODEO\"]/choice[2]/text"
