#: src-en/data/events_sector_clan.xml:246
msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_FAUNA_MID_PYRRHIC\"]/text"
msgstr ""
"Das Ungetüm ignoriert die Drohne meistens und konzentriert sich auf die "
"weicheren Ziele, aber das war ein Fehler, denn die Drohne kann diesen Fehler"
" mit ihrem Kampfgeschick bestrafen. Leider erleidet die Slug-Jagdgruppe "
"dabei schwere Verluste."

#: src-en/data/events_sector_clan.xml:251
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_FAUNA_MID_PYRRHIC\"]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_clan.xml:257
msgid ""
"data/events_sector_clan.xml$//eventList[@name=\"CLAN_25_50_25_MID\"]/event[4]/text"
msgstr ""
"Das Ungetüm schafft es, die Drohne mit seinem Scharfsinn zu überlisten und "
"sich auf die Jagdgruppe zu konzentrieren. Leider hat die Drohne, als sie "
"endlich angreifen kann, nicht mehr genug Slugs im Rücken."

#: src-en/data/events_sector_clan.xml:262
msgid ""
"data/events_sector_clan.xml$//eventList[@name=\"CLAN_25_50_25_MID\"]/event[4]/choice/text"
