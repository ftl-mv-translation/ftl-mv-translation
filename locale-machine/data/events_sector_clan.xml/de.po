msgid ""
"data/events_sector_clan.xml$//event[@name=\"NEBULA_LIGHT_SALT_QUEST\"]/beaconType/unvisitedTooltip"
msgstr ""
"Koordinaten, die Sylvan vom vermuteten Standort des Saltman erhalten hat."

#: src-en/data/events_sector_clan.xml:2637
