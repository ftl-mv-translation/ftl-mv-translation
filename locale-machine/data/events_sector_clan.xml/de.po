msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[3]/text"
msgstr "Gehe wieder."

#: src-en/data/events_sector_clan.xml:605
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[3]/event/text"
msgstr ""
"Der Ursprung dieses neuen Slug-Schiffs muss geheim bleiben. Es ist zu "
"riskant, sich einzumischen, wenn es wichtigere Dinge zu erledigen gibt."

#: src-en/data/events_sector_clan.xml:607
msgid ""
