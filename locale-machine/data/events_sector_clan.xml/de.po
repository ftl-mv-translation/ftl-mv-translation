#: src-en/data/events_sector_clan.xml:592
msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[2]/text"
msgstr "Hilf dem schwarzen Slug-Schiff, und nimm die Drogen selbst mit."

#: src-en/data/events_sector_clan.xml:594
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[2]/event/text"
msgstr ""
"Dafür musst du die Clansmen töten, ohne ihre Station zu zerstören. Sei "
"vorsichtig!"

#: src-en/data/events_sector_clan.xml:597
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_SPICES\"]/choice[2]/event/choice/text"
