#: src-en/data/events_sector_clan.xml:2608
msgid ""
"data/events_sector_clan.xml$//ship[@name=\"SHIP_SALT_ABANDONED_CHAOS\"]/surrender/choice[1]/event/choice/event/text"
msgstr ""
"\"Der... der was hat euch hierher geschickt? Doch nicht, ich will es nicht "
