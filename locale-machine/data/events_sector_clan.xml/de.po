#: src-en/data/events_sector_clan.xml:480
msgid "data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/text"
msgstr ""
"Einige Kristalle neigen zu Xenophobie und sind feindselig, aber andere "
"können sehr freundlich und gastfreundlich sein. Kristalle wie diese findet "
"man oft an touristischen Orten."

#: src-en/data/events_sector_clan.xml:483
msgid ""
"data/events_sector_clan.xml$//event[@name=\"CLAN_TOURISTS\"]/choice[1]/text"
msgstr "Diese Kristalle sind leichte Ziele. Greif sie an!"

