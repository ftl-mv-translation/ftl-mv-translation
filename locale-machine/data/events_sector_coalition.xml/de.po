#: src-en/data/events_sector_coalition.xml:666
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_FED_AUTO_WIN\"]/choice[@req=\"LIST_CREW_ELITE\"]/text"
msgstr "(Elite Crew) Lass deinen Elite die Tür vorsichtig öffnen."

#: src-en/data/events_sector_coalition.xml:668
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_FED_AUTO_WIN\"]/choice[@req=\"LIST_CREW_ELITE\"]/event/text"
msgstr ""
"Deine Crew nähert sich der Lagerhalle und bemerkt eine raffinierte "
"Sprengfalle zur Abschreckung von Piraten. Deine Crew entschärft die Falle "
"und geht hinein."

#: src-en/data/events_sector_coalition.xml:673
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_FED_AUTO_WIN\"]/choice[3]/text"
