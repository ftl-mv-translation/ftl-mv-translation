#: src-en/data/events_sector_coalition.xml:169
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"RECON_EXPLAIN_MISSION\"]/choice[@req=\"hacking\"]/event/choice[3]/event/text"
msgstr ""
"\"Das... war's? Das ist alles, was du hinbekommen hast...? Ich schätze, wir "
"werden diese Sicherheitslücke irgendwann einfach... ausnutzen.\" Die "
"Aufklärungsdrohne kehrt an ihr Versteck zurück."

#: src-en/data/events_sector_coalition.xml:175
