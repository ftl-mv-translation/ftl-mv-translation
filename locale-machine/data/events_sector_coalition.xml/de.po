#: src-en/data/events_sector_coalition.xml:195
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"RECON_EXPLAIN_MISSION\"]/choice[@req=\"weapons\"]/text"
msgstr "(Fortgeschrittene Waffen) Voller Angriff."

#: src-en/data/events_sector_coalition.xml:197
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"RECON_EXPLAIN_MISSION\"]/choice[@req=\"weapons\"]/event/text"
msgstr ""
"Du und das Tarnschiff bombardiert die Oberfläche des Planeten mit euren "
"mächtigen Waffensystemen. Eure überwältigende Kraft zerstört die "
"Produktionsanlage, bevor sie überhaupt merken, was passiert. Der Verlust "
"dieser Anlage wird wahrscheinlich bald bemerkt, aber ihr könnt immer noch "
"etwas Schrott vom Wrack bergen."

#: src-en/data/events_sector_coalition.xml:200
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"RECON_EXPLAIN_MISSION\"]/choice[@req=\"weapons\"]/event/choice/text"
