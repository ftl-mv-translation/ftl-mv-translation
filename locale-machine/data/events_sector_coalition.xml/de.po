msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_CHECKPOINT\"]/choice[@req=\"cloaking\""
" and not(@lvl)]/text"
msgstr "(Tarnung) Versuche dich vorbeizuschleichen."

#: src-en/data/events_sector_coalition.xml:2562
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_CHECKPOINT\"]/choice[@req=\"cloaking\""
" and @lvl=\"3\"]/text"
msgstr "(Fortgeschrittene Tarnung) Unbemerkt vorbeischleichen."

#: src-en/data/events_sector_coalition.xml:2564
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_CHECKPOINT\"]/choice[@req=\"cloaking\""
" and @lvl=\"3\"]/event/text"
msgstr ""
"Die Station der Coalition hat keine Chance, dich mit deiner überlegenen "
"Tarnung zu entdecken. Du schlüpfst völlig unbemerkt vorbei."

#: src-en/data/events_sector_coalition.xml:2568
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_CHECKPOINT\"]/choice[@req=\"engines\""
" and @lvl=\"3\"]/text"
msgstr "(Verb. Triebwerke) Versuche dich vorbeizuschleichen."

#: src-en/data/events_sector_coalition.xml:2572
