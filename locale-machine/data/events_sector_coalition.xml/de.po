#: src-en/data/events_sector_coalition.xml:2711
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"NEBULA_COALITION_ABDUCTOR\"]/choice[@req=\"COMBAT_WARP_JAMMER\"]/text"
msgstr "(Störfeld) Keins, du Idiot."

#: src-en/data/events_sector_coalition.xml:2713
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"NEBULA_COALITION_ABDUCTOR\"]/choice[@req=\"COMBAT_WARP_JAMMER\"]/event/text"
