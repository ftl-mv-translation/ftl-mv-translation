#: src-en/data/events_sector_coalition.xml:1443
msgid ""
"data/events_sector_coalition.xml$//event[@name=\"COALITION_JAILER_KILL\"]/choice/text"
msgstr "Überprüfe die Gefangenen."

#: src-en/data/events_sector_coalition.xml:1449
msgid ""
"data/events_sector_coalition.xml$//eventList[@name=\"COALITION_JAILER_KILL_SLAVES\"]/event[1]/text"
msgstr ""
"Es sieht so aus, als wären die Gefangenen im Kampf nicht überlebt. Es gibt "
"nichts mehr zu tun, außer zu gehen."

