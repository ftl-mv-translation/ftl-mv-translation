#: src-en/data/events_sector_confederacy.xml:2416
msgid ""
"data/events_sector_confederacy.xml$//event[@name=\"TYEREL_QUEST\"]/choice[2]/event/text"
msgstr "Da ist keine Koalition in Sicht, also lässt du es dabei bewenden."

#: src-en/data/events_sector_confederacy.xml:2418
msgid ""
"data/events_sector_confederacy.xml$//event[@name=\"TYEREL_QUEST\"]/choice[2]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_confederacy.xml:2422
