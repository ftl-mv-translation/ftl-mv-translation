#: src-en/data/events_sector_confederacy.xml:2513
msgid ""
"data/events_sector_confederacy.xml$//event[@name=\"TY_EREL_RECRUITMENT_CHOICE\"]/choice[2]/text"
msgstr "Ty E'Rel ablehnen."

#: src-en/data/events_sector_confederacy.xml:2515
msgid ""
"data/events_sector_confederacy.xml$//event[@name=\"TY_EREL_RECRUITMENT_CHOICE\"]/choice[2]/event/text"
msgstr ""
"\"In diesem Fall nehme ich mein Schiff und mache mich vorerst auf die "
"Föderation zu. Gute Reise.\""
