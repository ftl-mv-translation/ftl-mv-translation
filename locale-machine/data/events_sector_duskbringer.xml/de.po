"data/events_sector_duskbringer.xml$//event[@name=\"DUSK_MFKHELP\"]/choice[1]/event/choice[1]/event/choice[@req=\"LIST_CREW_SLUG\"]/text"
msgstr "(Slug Crew) Helfe die Überlebenden zu verorten."

