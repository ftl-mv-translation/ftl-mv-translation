#: src-en/data/events_sector_duskbringer.xml:481
msgid "data/events_sector_duskbringer.xml$//event[@name=\"DUSK_MFKHELP\"]/text"
msgstr ""
"Eine nahegelegene Zoltan-Stadt auf der Oberfläche des nächsten Planeten "
"scheint von einem kürzlichen Angriff schwer beschädigt worden zu sein. Ein "
"MFK-Schiff steht im Orbit und beobachtet die Stadt aus sicherer Entfernung. "
"Du kannst deren Absichten nicht ganz einordnen."

#: src-en/data/events_sector_duskbringer.xml:485
msgid ""
"data/events_sector_duskbringer.xml$//event[@name=\"DUSK_MFKHELP\"]/choice[1]/text"
