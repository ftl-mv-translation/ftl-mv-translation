#: src-en/data/events_sector_duskbringer.xml:1256
msgid ""
"data/events_sector_duskbringer.xml$//event[@name=\"DUSK_TEAMUP\"]/choice[2]/event/text"
msgstr ""
"Schüsse kommen von allen Seiten, als du in den Kampf eintrittst, um gegen "
"die Duskbringer zu kämpfen."

#: src-en/data/events_sector_duskbringer.xml:1261
msgid ""
"data/events_sector_duskbringer.xml$//event[@name=\"DUSK_TEAMUP\"]/choice[2]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_duskbringer.xml:1267
msgid ""
"data/events_sector_duskbringer.xml$//event[@name=\"DUSK_TEAMUP\"]/choice[3]/text"
msgstr "Kämpfe gegen das Zoltanschiff."

#: src-en/data/events_sector_duskbringer.xml:1269
msgid ""
"data/events_sector_duskbringer.xml$//event[@name=\"DUSK_TEAMUP\"]/choice[3]/event/text"
msgstr ""
