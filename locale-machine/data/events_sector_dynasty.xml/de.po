"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_AUTOQUEST\"]/text"
msgstr ""
"Fast sofort erhältst du einen Gruß von etwas, das wie eine Auto-Station "
"wirkt und in der Nähe verweilt. \"Hallo. Dies ist eine vorab aufgezeichnete "
"Nachricht für alle nahegelegenen nicht-Dynastie-Schiffe. Die nahegelegene "
"Siedlung Ghosts hat sich für den Rebell gemacht. Erober sie zurück, und "
"diese Plattform ist berechtigt, dir eine Drohne als Belohnung zu geben.\""

#: src-en/data/events_sector_dynasty.xml:1028
msgid ""
"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_AUTOQUEST\"]/choice[1]/text"
msgstr "Die Ghosts angreifen."

#: src-en/data/events_sector_dynasty.xml:1030
