msgid ""
"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_TRINKETS_WAR\"]/text"
msgstr ""
"\"Heheh... frag bloß nicht, wie das funktioniert.\" Du kehrst zu deinem "
"Schiff zurück, unsicher, was du mit dem Objekt anfangen sollst. Du "
"entscheidest dich schließlich, es auf dein Armaturenbrett zu legen und "
"hoffst, dass es funktioniert."

#: src-en/data/events_sector_dynasty.xml:532
msgid ""
"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_TRINKETS_SPEED\"]/text"
