"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_SMUGGLER\"]/choice[1]/event/choice[@req=\"loc_dynasty_impressed\"]/event/text"
msgstr ""
"\"Oh, die Götter schenken mir eine Ehre, wie ich sie nie kannte! Eine "
"Schande, ich bin, weil ich den Retter unserer Länder nicht erkannt habe! Ja,"
" ja, wir tun alles!\" Du bittest sie freundlich, deinen "
"'schmuggler'-Freunden passieren zu lassen, und sie tun es ohne Zögern."

#: src-en/data/events_sector_dynasty.xml:987
msgid ""
"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_SMUGGLER\"]/choice[1]/event/choice[@req=\"loc_dynasty_impressed\"]/event/choice/text"
msgstr "Fortfahren..."

