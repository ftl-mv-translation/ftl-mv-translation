#: src-en/data/events_sector_dynasty.xml:539
msgid ""
"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_TRINKETS_SHIELD\"]/text"
msgstr ""
"\"Heheh... frag bloß nicht, wie das funktioniert.\" Du kehrst zu deinem "
