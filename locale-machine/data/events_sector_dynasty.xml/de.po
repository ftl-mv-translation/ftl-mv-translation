"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_SMUGGLER\"]/choice[1]/event/choice[3]/event/text"
msgstr ""
"Du bezweifelst, dass die Schmuggler dir nach dem Ganzen eine Waffe geben, "
"aber es war müheloser Schrott, und wer kann sich darüber beschweren?"

#: src-en/data/events_sector_dynasty.xml:983
msgid ""
"data/events_sector_dynasty.xml$//event[@name=\"NEBULA_DYNASTY_SMUGGLER\"]/choice[1]/event/choice[@req=\"loc_dynasty_impressed\"]/text"
msgstr "(Retter der Dynastie) Könntest du uns einen Gefallen tun?"

#: src-en/data/events_sector_dynasty.xml:985
