#: src-en/data/events_sector_empire.xml:163
msgid "data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/text"
msgstr ""
"Seltsame Radarzeichen tauchen auf, von einem orbitierenden Asteroiden, der "
"eine Art Crystal-Kiste offenbart. Ein tiefer Krater wurde mit einer dicken "
"Kristallschicht bedeckt, um das was darin ist zu schützen - es wird echt "
"viel Feuerkraft brauchen, um durchzubrechen."

#: src-en/data/events_sector_empire.xml:165
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[1]/text"
msgstr "Versuche mit den Waffen die du hast, durchzubrechen."

#: src-en/data/events_sector_empire.xml:169
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"BLUELIST_WEAPONS_HEAVY\"]/text"
msgstr "(Schwere Waffe) Nutze deine Waffe."

#: src-en/data/events_sector_empire.xml:171
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"BLUELIST_WEAPONS_HEAVY\"]/event/text"
msgstr ""
"Deine starke Waffe lässt eine massive Kristallscherbe absplittern, wodurch "
"genug Platz ist für dein Team um es zu erkunden, runter zu klettern und "
"einen Block auf das Ganze zu werfen."

#: src-en/data/events_sector_empire.xml:173
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"BLUELIST_WEAPONS_HEAVY\"]/event/choice[@req=\"LIST_CHECK_ANY_CREW\""
" and @lvl=\"1\"]/text"
msgstr "Inspiziere die Kiste."

#: src-en/data/events_sector_empire.xml:177
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"BLUELIST_WEAPONS_HEAVY\"]/event/choice[@req=\"LIST_CHECK_ANY_CREW\""
" and @lvl=\"0\"]/text"
msgstr ""
"Das war eine fantastische Darstellung von Feuerkraft, aber wer wird dort "
"reingehen und nachforschen?"

#: src-en/data/events_sector_empire.xml:179
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"BLUELIST_WEAPONS_HEAVY\"]/event/choice[@req=\"LIST_CHECK_ANY_CREW\""
" and @lvl=\"0\"]/event/text"
msgstr "Du ignorierst die Kiste und tust etwas an Bord des Schiffes."

#: src-en/data/events_sector_empire.xml:181
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"BLUELIST_WEAPONS_HEAVY\"]/event/choice[@req=\"LIST_CHECK_ANY_CREW\""
