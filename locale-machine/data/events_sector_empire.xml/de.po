#: src-en/data/events_sector_empire.xml:132
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/choice[1]/event/choice[@req=\"mind\"]/event/text"
