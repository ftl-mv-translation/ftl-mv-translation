#: src-en/data/events_sector_empire.xml:113
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/text"
msgstr ""
"Du schaust dir kurz die Karte an, bist jedoch verwirrt was du siehst. Die "
"Daten sind korrumpiert und an den meisten Stellen offensichtlich falsch. Du "
"zweifelst, dass du bösartig hintergangen wurdest, aber diese Daten sind "
"wertlos!"

#: src-en/data/events_sector_empire.xml:115
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/choice[1]/text"
msgstr "Konfrontiere sie darüber."

#: src-en/data/events_sector_empire.xml:117
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/choice[1]/event/text"
msgstr ""
"\"Was! Diese Karten sind absolut gut. Wir werden dir keine Rückerstattung "
"anbieten, für absolut gute Daten!\""

#: src-en/data/events_sector_empire.xml:119
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/choice[1]/event/choice[1]/text"
msgstr "Erhalte deine Rückerstattung mit Gewalt!"

#: src-en/data/events_sector_empire.xml:121
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/choice[1]/event/choice[1]/event/text"
msgstr ""
"Du fährst die Waffen hoch und machst dich bereit deine Rückerstattung mit "
"Gewalt zu holen, auf eine Art oder die Andere."

#: src-en/data/events_sector_empire.xml:124
msgid ""
"data/events_sector_empire.xml$//eventList[@name=\"CRYSTAL_FOREIGNER_MAP_BUY\"]/event[2]/choice/event/choice[1]/event/choice[1]/event/choice/text"
