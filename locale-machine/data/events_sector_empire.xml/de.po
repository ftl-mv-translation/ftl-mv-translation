#: src-en/data/events_sector_empire.xml:193
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"LIST_CREW_CRYSTAL\"]/text"
msgstr "(Crystal Crew) Lasse deine Crystal Crew die Waffen rekalibrieren."

#: src-en/data/events_sector_empire.xml:195
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"LIST_CREW_CRYSTAL\"]/event/text"
msgstr ""
"Dein Crystal Crew Mitglied ist in der Lage die Detonationsfrequenz deiner "
"Waffen, mit der dieser Art des Kristalls abzustimmen, sodass die Barriere "
"nur wenig Widerstand leistet."

#: src-en/data/events_sector_empire.xml:197
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[@req=\"LIST_CREW_CRYSTAL\"]/event/choice/text"
msgstr "Inspiziere die Kiste."

#: src-en/data/events_sector_empire.xml:203
msgid ""
"data/events_sector_empire.xml$//event[@name=\"CRYSTAL_CACHE_MV\"]/choice[4]/text"
