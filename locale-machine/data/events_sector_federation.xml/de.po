#: src-en/data/events_sector_federation.xml:1236
msgid ""
"data/events_sector_federation.xml$//event[@name=\"DISTRESS_FEDERATION_KNIGHTS_AND_KNAVES\"]/choice[2]/event/choice[1]/text"
