msgstr "Fortfahren..."

#: src-en/data/events_sector_federation.xml:240
msgid ""
"data/events_sector_federation.xml$//event[@name=\"FEDERATION_RANT\"]/choice[5]/event/choice[2]/text"
msgstr "Drohungen machen, damit sie aufhören."

#: src-en/data/events_sector_federation.xml:242
msgid ""
"data/events_sector_federation.xml$//event[@name=\"FEDERATION_RANT\"]/choice[5]/event/choice[2]/event/text"
msgstr ""
"Du schaltest deine Waffen ein, entschlossen, sie von ihrem Geschwafel "
