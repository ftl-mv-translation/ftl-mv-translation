#: src-en/data/events_sector_federation.xml:1234
msgid ""
"data/events_sector_federation.xml$//event[@name=\"DISTRESS_FEDERATION_KNIGHTS_AND_KNAVES\"]/choice[2]/event/text"
msgstr ""
"Du hast kein Interesse daran, was hier passiert. Sie sollen es selbst "
