#: src-en/data/events_sector_federation.xml:127
msgid ""
"data/events_sector_federation.xml$//event[@name=\"FEDERATION_FREECREW\"]/choice[2]/event/text"
msgstr ""
"\"Oh ... okay. Hoffentlich kann ich die Schilde unter Kontrolle halten, "
"damit sie nicht implodieren, bevor ein anderes Schiff eintrifft, um zu "
"helfen... \""

