#: src-en/data/events_sector_federation.xml:1247
msgid ""
"data/events_sector_federation.xml$//event[@name=\"KNIGHTS_AND_KNAVES_SURRENDER\"]/text"
msgstr ""
"Die Crew des kompromittierten Föderationsschiffs kapituliert und lässt die "
"anderen Schiffe ihre Crew gefangen nehmen. Die Captain des Leichten Kreuzers"
" lädt dich zu einem weiteren Gespräch ein."

#: src-en/data/events_sector_federation.xml:1250
msgid ""
"data/events_sector_federation.xml$//event[@name=\"KNIGHTS_AND_KNAVES_SURRENDER\"]/choice/text"
