msgid ""
"data/events_sector_federation.xml$//event[@name=\"FEDERATION_BROKEN_DRONE\"]/choice[@req=\"LIST_CREW_ENGI\"]/text"
msgstr "(Engi Crew) Repariere die Drohne."

#: src-en/data/events_sector_federation.xml:644
msgid ""
"data/events_sector_federation.xml$//event[@name=\"FEDERATION_BROKEN_DRONE\"]/choice[@req=\"LIST_CREW_ENGI\"]/event/text"
msgstr ""
"Dein Engi ist es gewohnt an Auto-Schiffen und Drohnen zu arbeiten und "
"identifiziert mit Leichtigkeit die Probleme. Sobald das Auto-Schiff "
"repariert ist liefert es dir Drohnen und repariert deine Hülle."

#: src-en/data/events_sector_federation.xml:650
msgid ""
"data/events_sector_federation.xml$//event[@name=\"FEDERATION_BROKEN_DRONE\"]/choice[@req=\"LIST_CREW_ENGINEER\"]/text"
msgstr "(Engineer Crew) Repariere die Drohne."

#: src-en/data/events_sector_federation.xml:652
