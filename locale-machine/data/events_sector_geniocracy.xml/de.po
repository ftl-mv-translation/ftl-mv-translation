#: src-en/data/events_sector_geniocracy.xml:174
msgid "data/events_sector_geniocracy.xml$//event[@name=\"ENCOUNTER_SHELL\"]/text"
msgstr ""
"Shells suchen sich normalerweise Unterschlupf in Nebeln, aber hier ist einer"
" zu weit in eine Lichtung geraten. Sie scheinen zu denken, du jagst sie, und"
" greifen sofort an!"

