#: src-en/data/events_sector_geniocracy.xml:908
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[3]/text"
msgstr "Meide die Schiffe."

#: src-en/data/events_sector_geniocracy.xml:910
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[3]/event/text"
msgstr ""
"Du weißt nicht genau, warum die Shells angreifen, aber es ist besser, wenn "
"du dich nicht einmischst."

#: src-en/data/events_sector_geniocracy.xml:912
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[3]/event/choice[1]/text"
