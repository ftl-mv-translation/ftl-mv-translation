#: src-en/data/events_sector_geniocracy.xml:1557
msgid ""
"data/events_sector_geniocracy.xml$//ship[@name=\"SHIP_SHELL_DONUTBOSS\"]/destroyed/text"
msgstr ""
"Das Labor explodiert, was zweifellos alle Crewmitglieder, einschließlich des"
" Föderationspersonals, das Tode bedeutet. Du hoffst, dass die Föderation "
"nichts von diesem Fehler erfährt..."

#: src-en/data/events_sector_geniocracy.xml:1561
msgid ""
"data/events_sector_geniocracy.xml$//ship[@name=\"SHIP_SHELL_DONUTBOSS\"]/deadCrew/text"
msgstr ""
"Du hast alle Wissenschaftler an Bord der Station getötet. Du schrottest die "
"Außenseite der Hülle."

#: src-en/data/events_sector_geniocracy.xml:1564
msgid ""
"data/events_sector_geniocracy.xml$//ship[@name=\"SHIP_SHELL_DONUTBOSS\"]/deadCrew/choice/text"
