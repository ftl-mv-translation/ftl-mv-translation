msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/text"
msgstr ""
"Du entdeckst in der Nähe ein ziviles Schiff, das von einem Shell-Entführer "
"angegriffen wird!"

#: src-en/data/events_sector_geniocracy.xml:879
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[1]/text"
msgstr "Die Shells ansprechen."

#: src-en/data/events_sector_geniocracy.xml:881
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[1]/event/text"
msgstr ""
"Du bist überrascht zu sehen, dass die Shells tatsächlich auf deine Signale "
"reagieren. „Hallo. Das sieht vielleicht schlecht aus, aber wir versprechen, "
"diesen Zivilisten keinen Schaden zuzufügen. Wir wollen nur ein paar Tests "
"mit ihnen durchführen, nichts mehr. Das ist für die Wissenschaft!“"

#: src-en/data/events_sector_geniocracy.xml:883
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[1]/event/choice[1]/text"
msgstr "Verlangen, dass sie die Zivilisten in Ruhe lassen."

#: src-en/data/events_sector_geniocracy.xml:887
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[1]/event/choice[2]/text"
msgstr "Die Situation den Zivilisten erklären."

#: src-en/data/events_sector_geniocracy.xml:891
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[1]/event/choice[3]/text"
msgstr "Sie in ihren Angelegenheiten lassen."

#: src-en/data/events_sector_geniocracy.xml:897
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[2]/text"
msgstr "Die Shells angreifen!"

#: src-en/data/events_sector_geniocracy.xml:899
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_ADBUCTION\"]/choice[2]/event/text"
