msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_UNIQUE_LAB\"]/choice[2]/text"
msgstr "Erkläre, dass du nicht die Verstärkung bist und verschwinde."

#: src-en/data/events_sector_geniocracy.xml:1533
msgid ""
"data/events_sector_geniocracy.xml$//event[@name=\"NEBULA_SHELL_UNIQUE_LAB\"]/choice[2]/event/text"
msgstr ""
"Du entschuldigst dich bei dem Föderations-Schiff und erklärst, dass du auf "
"einer wichtigeren Mission bist. Hoffentlich trifft die echte Verstärkung "
"bald ein, um ihnen zu helfen."

#: src-en/data/events_sector_geniocracy.xml:1535
msgid ""
