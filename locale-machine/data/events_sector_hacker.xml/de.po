msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKED_MILITIA\"]/choice[2]/event/text"
msgstr "Du störst das Schiff nicht, sondern machst stattdessen etwas an Bord."

#: src-en/data/events_sector_hacker.xml:259
msgid ""
