msgstr ""
"\"Danke, wir werden diese besser verstecken, falls uns wieder geräumt wird. "
"Wie können wir dir helfen?\""

#: src-en/data/events_sector_hacker.xml:198
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKER_CIVILIAN_STATION_THANK\"]/choice[1]/text"
msgstr "Wir brauchen Reparaturen."

#: src-en/data/events_sector_hacker.xml:200
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKER_CIVILIAN_STATION_THANK\"]/choice[1]/event/text"
msgstr "\"Ja, das können wir erledigen. Ich schicke sofort ein Reparaturteam!\""

#: src-en/data/events_sector_hacker.xml:205
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKER_CIVILIAN_STATION_THANK\"]/choice[2]/text"
msgstr "Wir müssen die Flotte aufhalten."

#: src-en/data/events_sector_hacker.xml:207
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKER_CIVILIAN_STATION_THANK\"]/choice[2]/event/text"
msgstr ""
"\"Ich bin nicht sicher, wie viel wir dazu beitragen können... aber wenn die "
"Flotte vorbeikommt, werden wir über deinen Standort lügen. Hoffentlich "
"glauben sie uns.\""

#: src-en/data/events_sector_hacker.xml:212
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKER_CIVILIAN_STATION_THANK\"]/choice[3]/text"
