#: src-en/data/events_sector_hacker.xml:114
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKED_CIVILIANS_FREECREW\"]/text"
msgstr ""
"Ein Schiff der Union, das vor den Hackern versteckt war, sendet dir ein "
"Signal. \"Bitte, ich kann nicht ewig versteckt bleiben. Würdest du mir "
"erlauben, an Bord deines Schiffes zu arbeiten, damit ich aus diesem blutigen"
" Sektor fliehen kann?\""

#: src-en/data/events_sector_hacker.xml:117
msgid ""
"data/events_sector_hacker.xml$//event[@name=\"HACKED_CIVILIANS_FREECREW\"]/choice[1]/text"
