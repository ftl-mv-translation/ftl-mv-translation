msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_CRIME\"]/choice[2]/text"
msgstr "Wen kümmert es, wer verantwortlich ist? Tötet die Rebellen!"

#: src-en/data/events_sector_harmony.xml:2184
msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_CRIME\"]/choice[2]/event/text"
msgstr ""
"Es spielt keine Rolle, ob die Ingenieure die Engi nicht getötet haben, sie "
"haben zweifellos viele andere getötet."

#: src-en/data/events_sector_harmony.xml:2187
