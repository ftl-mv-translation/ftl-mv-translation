#: src-en/data/events_sector_harmony.xml:2075
msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_SLAVE_FACILITY\"]/choice[1]/event/text"
msgstr ""
"Du bereitest dich auf den Angriff auf die Station vor. Die Engi können nicht"
" fliehen und haben keine andere Wahl, als zurückzuschlagen."

#: src-en/data/events_sector_harmony.xml:2078
msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_SLAVE_FACILITY\"]/choice[1]/event/choice/text"
