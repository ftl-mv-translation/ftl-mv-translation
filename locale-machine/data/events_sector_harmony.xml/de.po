#: src-en/data/events_sector_harmony.xml:2084
msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_SLAVE_FACILITY\"]/choice[@req=\"teleporter\"]/text"
msgstr "(Teleporter) Versuche, zu entern und einen Engi zu nehmen."

#: src-en/data/events_sector_harmony.xml:2086
msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_SLAVE_FACILITY\"]/choice[@req=\"teleporter\"]/event/text"
msgstr ""
"Deine Versuche, das Schiff zu entern, sind umsonst gewesen. Das Engi-"
"Sicherheitssystem ist zu gut und erkennt deine Crew fast sofort. Sie beamen "
"sie zurück und bereiten sich auf den Kampf vor."

#: src-en/data/events_sector_harmony.xml:2089
msgid ""
"data/events_sector_harmony.xml$//event[@name=\"QUEST_ENGI_SLAVE_FACILITY\"]/choice[@req=\"teleporter\"]/event/choice/text"
