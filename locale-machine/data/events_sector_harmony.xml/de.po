#: src-en/data/events_sector_harmony.xml:152
msgid ""
"data/events_sector_harmony.xml$//eventList[@name=\"ENGI_SALVAGER_EXPLAIN\"]/event[1]/text"
msgstr ""
"Du schaffst es erfolgreich, dem Lanius zu erklären, dass das Engi-Schiff "
"kein Wrack ist. Zufrieden mit dem Schrott, den sie gerade gesammelt haben, "
"springt das Lanius-Schiff fort."

#: src-en/data/events_sector_harmony.xml:154
msgid ""
"data/events_sector_harmony.xml$//eventList[@name=\"ENGI_SALVAGER_EXPLAIN\"]/event[1]/choice/text"
msgstr "Die Engi anrufen."

#: src-en/data/events_sector_harmony.xml:159
msgid ""
"data/events_sector_harmony.xml$//eventList[@name=\"ENGI_SALVAGER_EXPLAIN\"]/event[2]/text"
msgstr ""
"Deine Versuche, mit den Lanius zu kommunizieren, sind umsonst. Genug von "
"deinem unverständlichen Gejammer, beschließen die Lanius, dich als Nächstes "
"zu zerstören!"

#: src-en/data/events_sector_harmony.xml:162
msgid ""
"data/events_sector_harmony.xml$//eventList[@name=\"ENGI_SALVAGER_EXPLAIN\"]/event[2]/choice/text"
