#: src-en/data/events_sector_hektar.xml:590
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[2]/event/text"
msgstr ""
"Du bist dir nicht sicher, warum jemand versuchen würde, Sylvan nachzuahmen, "
"aber es ist nichts weiter als eine lästige Angelegenheit für dich."

#: src-en/data/events_sector_hektar.xml:592
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[2]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_hektar.xml:596
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[2]/event/choice[2]/text"
