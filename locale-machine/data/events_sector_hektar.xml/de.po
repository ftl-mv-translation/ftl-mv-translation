"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[1]/event/choice[@req=\"unique_sylvan\"]/event/text"
msgstr ""
"\"OH GOTT! ES IST DU! OH MEIN OH MEIN OH MEIN OH MEIN OH MEIN!\" Der Slug "
"verlangt praktisch, dass du ihm die Aufnahme an Bord gestattest, damit er "
"mit Sylvan zusammenarbeiten kann."

#: src-en/data/events_sector_hektar.xml:588
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[2]/text"
