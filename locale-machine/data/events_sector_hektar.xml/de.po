"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_FANATIC\"]/choice[2]/event/text"
msgstr ""
"Das sieht nach Chaos aus, der Art von Chaos, in dem du nicht stecken willst."
" Du distanzierst dich von den verrückten Zivilisten."

#: src-en/data/events_sector_hektar.xml:818
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_FANATIC\"]/choice[2]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_hektar.xml:822
