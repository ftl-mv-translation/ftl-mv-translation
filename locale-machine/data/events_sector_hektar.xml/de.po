"vorhin wieder auf. \"Komm rein, sssränger, und sieh dir meine Waren an!\""

#: src-en/data/events_sector_hektar.xml:550
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[1]/event/choice[2]/text"
msgstr ""
