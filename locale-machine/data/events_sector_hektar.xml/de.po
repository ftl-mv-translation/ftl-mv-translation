#: src-en/data/events_sector_hektar.xml:552
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[1]/event/choice[2]/event/text"
msgstr ""
"\"Ja... Ich bin mir nicht einmal sicher, wie er das geschafft hat! Jedes "
"Mal, wenn ich versuche, so viele Schilde zu installieren, bekomme ich nur "
"ein nerviges Piepen, als hätte ich ein hartcodiertes Limit oder so etwas "
"erreicht.\""

#: src-en/data/events_sector_hektar.xml:554
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[1]/event/choice[2]/event/choice[1]/text"
msgstr "Biete ihm etwas Schrott, um sein Schiff aufzupeppen."

#: src-en/data/events_sector_hektar.xml:556
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[1]/event/choice[2]/event/choice[1]/event/text"
msgstr "\"Das ist ja unglaublich großzügig, Fremder! Äh, ich meine, danke.\""

#: src-en/data/events_sector_hektar.xml:561
msgid ""
"data/events_sector_hektar.xml$//event[@name=\"NEBULA_HEKTAR_SYLVAN\"]/choice[1]/event/choice[2]/event/choice[1]/event/choice/text"
