msgstr ""
"In dem Moment, als dein Orchid an Bord geht, wird klar, dass es eine Art "
"Falle ist! Sie können es zurück zu deinem Schiff schaffen, aber es sieht "
"aus, als stünde ein Kampf bevor."

#: src-en/data/events_sector_hive.xml:1671
msgid ""
"data/events_sector_hive.xml$//eventList[@name=\"MANTIS_DERELICT_ORCHID\"]/event[3]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_hive.xml:1676
msgid ""
"data/events_sector_hive.xml$//eventList[@name=\"MANTIS_DERELICT_ORCHID\"]/event[4]/text"
