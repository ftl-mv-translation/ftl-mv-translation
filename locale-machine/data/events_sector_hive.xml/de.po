msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_SUZERAIN_COMPLEX\"]/choice[@req=\"pilot\"]/event/choice[2]/text"
msgstr "Nichts tun."

#: src-en/data/events_sector_hive.xml:1472
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_SUZERAIN_COMPLEX_WIN_STUPID\"]/text"
msgstr ""
"Du hast den Wächter besiegt, aber du weißt, dass sicher mehr unterwegs sind."
" Du schrottest schnell, was du kannst, und gehst weg."

#: src-en/data/events_sector_hive.xml:1475
msgid ""
