#: src-en/data/events_sector_hive.xml:170
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_VAMPWEED_CURIOUS\"]/choice[14]/text"
msgstr "Erzähl ihnen, was du weißt."

#: src-en/data/events_sector_hive.xml:172
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_VAMPWEED_CURIOUS\"]/choice[14]/event/text"
msgstr ""
"Du tust dein Bestes, um zu erklären, was du weißt, aber es ist klar, dass "
"dein begrenztes Wissen über die Vampweeds sie nicht interessiert."

#: src-en/data/events_sector_hive.xml:176
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_VAMPWEED_CURIOUS\"]/choice[15]/text"
