msgstr ""
"(Reparatur-Burst) Nutze die Bombe, um den Teleporter zu reparieren. [-1}]"

#: src-en/data/events_sector_hive.xml:666
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_BROKEN_TELEPORTER\"]/choice[5]/text"
msgstr "Wir können nicht helfen."

#: src-en/data/events_sector_hive.xml:672
