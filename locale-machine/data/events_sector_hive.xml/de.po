msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_MANTIS_AUTO_SITUATION_SUCCESS\"]/text"
msgstr ""
"\"Überraschend. Wir haben damit gerechnet, dass du stirbst und wir deine "
"Leiche zum Anführer bringen. Aber so funktioniert es auch.\" Du plünderst "
"das Auto-Schiff."

#: src-en/data/events_sector_hive.xml:1356
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_MANTIS_AUTO_SITUATION_SUCCESS\"]/choice/text"
msgstr "Frage nach deiner Bezahlung."

