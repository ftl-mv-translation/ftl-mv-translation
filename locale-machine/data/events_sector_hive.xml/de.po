#: src-en/data/events_sector_hive.xml:2464
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_CHASE2\"]/choice/event/text"
msgstr ""
"\"Nicht DU schon wieder! Weißt du, was die Reparaturen kosten werden? Zeit "
"für die großen Kanonen.\""

#: src-en/data/events_sector_hive.xml:2466
