msgid "data/events_sector_hive.xml$//event[@name=\"MANTIS_FLORAL_SAVED\"]/text"
msgstr ""
"\"Vielen Dank, Renegade. Ich wollte meine Gastgeber von Oro'Bache bei meinem"
" nächsten Besuch bei der Konföderation beeindrucken. Sie lieben Hive-Wein so"
" sehr, aber leider mögen diese Mantis uns Ctl'Yae nicht so sehr wie sie. "
"Hier, als Zeichen meiner Dankbarkeit.\""

#: src-en/data/events_sector_hive.xml:1555
