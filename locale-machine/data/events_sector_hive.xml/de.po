#: src-en/data/events_sector_hive.xml:762
msgid "data/events_sector_hive.xml$//event[@name=\"MANTIS_PIRATE_FAKE\"]/text"
msgstr ""
"Ein piratisches Schiff der Mantis verteidigt diesen Signalpunkt und gibt an,"
" einer der Vollstrecker des Hive zu sein. Sie verlangen, dass du ihnen "
"entweder Schrott oder einen Sklaven bezahlst, oder du wirst ausgelöscht."

#: src-en/data/events_sector_hive.xml:765
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_PIRATE_FAKE\"]/choice[1]/text"
msgstr "Ablehnen."

#: src-en/data/events_sector_hive.xml:767
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_PIRATE_FAKE\"]/choice[1]/event/text"
msgstr ""
"Du machst dem Piraten klar, dass du kein Interesse daran hast, ihnen "
"irgendetwas zu geben, außer dem Tod. Ihr bereitet euch beide eilig auf die "
"Schlacht vor."

#: src-en/data/events_sector_hive.xml:770
msgid ""
"data/events_sector_hive.xml$//event[@name=\"MANTIS_PIRATE_FAKE\"]/choice[1]/event/choice/text"
