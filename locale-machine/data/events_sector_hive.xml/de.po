"data/events_sector_hive.xml$//event[@name=\"HIVE_JAILER_CHOICE\"]/choice[@req=\"FIREARMS_AND_TELEPORT\"]/text"
msgstr "(Waffenkammer + Teleporter) Stürme den Gefangenentransporter."

#: src-en/data/events_sector_hive.xml:1381
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_JAILER_CHOICE\"]/choice[@req=\"FIREARMS_AND_TELEPORT\"]/event/text"
msgstr ""
"Deine Crew, bis an die Zähne bewaffnet, betritt das Jailer-Schiff und nimmt "
"dessen Besatzung schnell gefangen. Da die Wächter nun selbst gefangen sind, "
"befreist du alle Gefangenen, von denen du nicht denkst, dass sie dich sofort"
" umbringen."

#: src-en/data/events_sector_hive.xml:1386
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_JAILER_CHOICE\"]/choice[3]/text"
msgstr "Weiche dem Gefangenentransporter aus."

#: src-en/data/events_sector_hive.xml:1388
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_JAILER_CHOICE\"]/choice[3]/event/text"
msgstr "Der Gefangenentransporter bemerkt dich nicht und du springst weg."

#: src-en/data/events_sector_hive.xml:1390
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_JAILER_CHOICE\"]/choice[3]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

