msgstr "(Teleporter) Schick ein Entern-Team, um den Komplex zu sabotieren."

#: src-en/data/events_sector_hive.xml:1457
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_SUZERAIN_COMPLEX\"]/choice[@req=\"pilot\"]/text"
msgstr "Lass den Komplex in Ruhe."

#: src-en/data/events_sector_hive.xml:1459
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_SUZERAIN_COMPLEX\"]/choice[@req=\"pilot\"]/event/text"
msgstr ""
"Du hast wichtigere Dinge zu tun, als wichtige Mantis-Strukturen zu plündern."

#: src-en/data/events_sector_hive.xml:1461
msgid ""
"data/events_sector_hive.xml$//event[@name=\"HIVE_SUZERAIN_COMPLEX\"]/choice[@req=\"pilot\"]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

