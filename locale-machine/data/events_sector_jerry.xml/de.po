#: src-en/data/events_sector_jerry.xml:743
msgid ""
"data/events_sector_jerry.xml$//event[@name=\"JERRY_META_REBELLION\"]/choice[2]/event/text"
msgstr "Du hast keine Zeit, Fernsehsignale einer Kinder-Sendung zu jagen."

#: src-en/data/events_sector_jerry.xml:745
msgid ""
"data/events_sector_jerry.xml$//event[@name=\"JERRY_META_REBELLION\"]/choice[2]/event/choice[1]/text"
