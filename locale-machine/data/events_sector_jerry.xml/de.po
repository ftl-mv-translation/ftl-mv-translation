#: src-en/data/events_sector_jerry.xml:730
msgid ""
"data/events_sector_jerry.xml$//event[@name=\"JERRY_META_REBELLION\"]/choice[1]/event/choice[2]/event/text"
msgstr ""
"Das Schiff der Ingenieure reagiert schnell auf dein aggressives Verhalten. "
"Sieht so aus, als hättest du Ärger am Hals!"

#: src-en/data/events_sector_jerry.xml:733
