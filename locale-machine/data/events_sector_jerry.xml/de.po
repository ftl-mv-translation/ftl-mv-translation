"data/events_sector_jerry.xml$//event[@name=\"JERRY_MOCKBATTLE\"]/choice[2]/event/choice[1]/event/choice[2]/text"
msgstr ""
"Das ist ziviles Gebiet! Die Föderation hat Besseres zu tun, als diesen Ort "
"anzugreifen!"

#: src-en/data/events_sector_jerry.xml:1081
