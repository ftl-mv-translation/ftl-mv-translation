#: src-en/data/events_sector_jerry.xml:1274
msgid ""
"data/events_sector_jerry.xml$//event[@name=\"DISTRESS_JERRY_SHOOTING_STAR\"]/choice[5]/text"
msgstr ""
"Der Cache ist bereits in der Atmosphäre und fällt auf die Stadt zu. Außer "
