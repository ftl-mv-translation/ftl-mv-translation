#: src-en/data/events_sector_jerry.xml:1120
msgid "data/events_sector_jerry.xml$//event[@name=\"JERRY_REBEL_DEPRESSED\"]/text"
msgstr ""
"„Ist das ein Renegade? Ach, was bringt es... Wir werden sowieso nicht "
"gewinnen.“ Der Rebell bewegt sich nicht, um anzugreifen."

#: src-en/data/events_sector_jerry.xml:1123
msgid ""
"data/events_sector_jerry.xml$//event[@name=\"JERRY_REBEL_DEPRESSED\"]/choice[1]/text"
msgstr "Zeigen wir ihnen, dass sie recht haben. Angriff!"

#: src-en/data/events_sector_jerry.xml:1125
msgid ""
"data/events_sector_jerry.xml$//event[@name=\"JERRY_REBEL_DEPRESSED\"]/choice[1]/event/text"
msgstr ""
"Wenn die sich über ihre bevorstehende Niederlage beschweren, wer bist du, um"
" ihnen das zu verweigern?"

#: src-en/data/events_sector_jerry.xml:1128
