msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[1]/event/choice[@req=\"SLUG_NARCOTICS\"]/text"
msgstr "(Slug-Drogen) Bestiche die Ritter, damit sie aufhören zu kämpfen."

#: src-en/data/events_sector_knight.xml:1078
msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[1]/event/choice[@req=\"SLUG_NARCOTICS\"]/event/text"
msgstr ""
"Es sieht so aus, als wären die Ritter bereit, ihren Stolz zu verwerfen und "
