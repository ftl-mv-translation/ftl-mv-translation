#: src-en/data/events_sector_knight.xml:1092
msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[1]/event/choice[3]/event/text"
msgstr "Du nimmst die Waffen und greifst das Seher-Schiff an."

#: src-en/data/events_sector_knight.xml:1095
msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[1]/event/choice[3]/event/choice/text"
