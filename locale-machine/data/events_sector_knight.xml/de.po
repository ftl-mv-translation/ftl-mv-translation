#: src-en/data/events_sector_knight.xml:1103
msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[2]/text"
msgstr "Misch dich nicht ein."

#: src-en/data/events_sector_knight.xml:1105
msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[2]/event/text"
msgstr ""
"Slug waren nie für verlässliche Verbündete bekannt, also kümmerst du dich "
"nicht um irgendeine Seite."

#: src-en/data/events_sector_knight.xml:1107
msgid ""
"data/events_sector_knight.xml$//event[@name=\"NEBULA_LIGHT_KNIGHT_CHOICE\"]/choice[2]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

