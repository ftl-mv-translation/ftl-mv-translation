#: src-en/data/events_sector_lanius.xml:1789
msgid ""
"data/events_sector_lanius.xml$//event[@name=\"LANIUS_HARVESTER_MV\"]/choice[@req=\"MAGNET_ARM\"]/event/text"
msgstr ""
"Mit Hilfe deines Magnetarms schaffst du es, aus dem Trümmerfeld eine "
"ordentliche Menge Schrott zu sammeln, ohne zu nah an das Lanius-Schiff "
"heranzukommen."

#: src-en/data/events_sector_lanius.xml:1794
msgid ""
"data/events_sector_lanius.xml$//event[@name=\"LANIUS_HARVESTER_MV\"]/choice[5]/text"
msgstr "Greife das Schiff an."

#: src-en/data/events_sector_lanius.xml:1796
