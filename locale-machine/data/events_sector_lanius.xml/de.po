#: src-en/data/events_sector_lanius.xml:1845
msgid "data/events_sector_lanius.xml$//event[@name=\"LANIUS_PUN\"]/text"
msgstr ""
"Du erhältst einen Anruf von einer mysteriösen Quelle. Eine düstere Stimme "
"flüstert dir zu: „Klack... klack...“"

#: src-en/data/events_sector_lanius.xml:1847
msgid "data/events_sector_lanius.xml$//event[@name=\"LANIUS_PUN\"]/choice/text"
msgstr "W-wer ist da?"

#: src-en/data/events_sector_lanius.xml:1849
msgid ""
"data/events_sector_lanius.xml$//event[@name=\"LANIUS_PUN\"]/choice/event/text"
msgstr "\"L..a...n...i...u...s...\""

#: src-en/data/events_sector_lanius.xml:1851
msgid ""
"data/events_sector_lanius.xml$//event[@name=\"LANIUS_PUN\"]/choice/event/choice/text"
