#: src-en/data/events_sector_laststand.xml:2044
msgid ""
"data/events_sector_laststand.xml$//event[@name=\"DISTRESS_NODE17_FLAMINGFED\"]/text"
msgstr ""
"Das Notsignal an diesem Signalpunkt kommt von einer nahegelegenen "
"Versorgungsstation der Union, aber bevor du die Station selbst ansprechen "
"kannst, erhältst du einen Anruf von einem Föderationsbeamten an Bord."

#: src-en/data/events_sector_laststand.xml:2046
msgid ""
"data/events_sector_laststand.xml$//event[@name=\"DISTRESS_NODE17_FLAMINGFED\"]/choice[1]/text"
