msgid ""
"data/events_sector_laststand.xml$/FTL/event[@name=\"LAST_STAND_START_2_STANDARD\"]/text"
msgstr ""
"\"Ich fürchte, wir haben keine Zeit mehr zu plaudern. Brauchst du noch "
"etwas, bevor du dem Flaggschiff gegenüberstehst?\" Tully weist die "
"Unterstützungsschiffe an, in Bereitschaft zu bleiben, und wartet auf deinen "
"Befehl."

