#: src-en/data/events_sector_laststand.xml:668
msgid ""
"data/events_sector_laststand.xml$//event[@name=\"TRUE_LAST_STAND_START\"]/choice[@req=\"rep_comb_federation\""
" and @lvl=\"-999\"]/event/choice[@req=\"SHIP_LIMIT\"]/event/text"
msgstr ""
"Auf dem Bildschirm erscheinen mehrere Offiziere der Föderation und der Engi,"
" sowie Admiral Tully in der Mitte. Kaum sieht er euer Schiff, legt er sofort"
" auf, stellt aber kurz darauf wieder eine Verbindung her. „Nein. Das kann "
"doch nicht wahr sein. Die haben DIESES Schiff geschickt, um uns zu retten? "
"Ist das irgendein blöder Witz?“ Tully seufzt. „Nun, leider bist du die "
"letzte Hoffnung der Föderation. Versuch bitte nicht, alles zu ruinieren, "
"okay? Wir zählen jetzt auf dich.“"

#: src-en/data/events_sector_laststand.xml:670
msgid ""
"data/events_sector_laststand.xml$//event[@name=\"TRUE_LAST_STAND_START\"]/choice[@req=\"rep_comb_federation\""
