#: src-en/data/events_sector_laststand.xml:2048
msgid ""
"data/events_sector_laststand.xml$//event[@name=\"DISTRESS_NODE17_FLAMINGFED\"]/choice[1]/event/text"
msgstr ""
"\"Gott sei Dank, dass jemand rechtzeitig da ist. Unser Schiff hat in der "
"Nähe eines Klasse-M-Zwergsterns schweren Schaden genommen. Wir haben es "
"geschafft, zu dieser Station zu teleportieren, aber wir konnten die "
"Steuerungen durch die Flammen nicht erreichen... und unser nun leerstehendes"
" Schiff befindet sich auf einem Kollisionskurs mit der Station. Bitte, hilf "
"uns. Hilf uns allen.\""

#: src-en/data/events_sector_laststand.xml:2050
