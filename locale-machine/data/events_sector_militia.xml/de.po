"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_HANGARATTACK\"]/choice[2]/event/text"
msgstr ""
"Auf keinen Fall kämpfst du gegen diesen Mistkerl. Du musst so schnell wie "
"möglich evakuieren."

#: src-en/data/events_sector_militia.xml:1995
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_HANGARATTACK\"]/choice[2]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

