"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_TALK_DANIEL\"]/choice[5]/text"
msgstr "Frag Daniel nach den anderen Verdächtigen."

#: src-en/data/events_sector_militia.xml:1726
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_TALK_DANIEL\"]/choice[5]/event/text"
msgstr "Über welchen Verdächtigen möchtest du Daniel etwas fragen?"

#: src-en/data/events_sector_militia.xml:1728
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_TALK_DANIEL\"]/choice[5]/event/choice[1]/text"
msgstr "Thom."

#: src-en/data/events_sector_militia.xml:1730
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_TALK_DANIEL\"]/choice[5]/event/choice[1]/event/text"
msgstr ""
"\"Thom ist ein netter Mann. Ich war nie so eng mit ihm wie mit Henry, aber "
"wir haben viel miteinander gesprochen, und er war immer ein fröhlicher Kerl."
" Neulich hat Thom ein besonderes Interesse am Drohnensystem gezeigt und mich"
" gebeten, ihm bei der Bedienung der Drohnen zu helfen! Er lernt ziemlich "
"schnell, aber ich glaube, er lernt nur, mir etwas zu geben, womit ich mich "
"beschäftigen kann. Ich wollte schon immer einen Schüler haben...\""

#: src-en/data/events_sector_militia.xml:1732
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_TALK_DANIEL\"]/choice[5]/event/choice[1]/event/choice/text"
msgstr "Fortfahren..."

