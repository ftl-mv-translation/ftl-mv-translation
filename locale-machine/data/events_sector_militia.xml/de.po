#: src-en/data/events_sector_militia.xml:1460
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_TALK_THOM\"]/choice[4]/event/text"
msgstr ""
"\"Mit Henry habe ich nie wirklich viel gesprochen. Er war immer so ruhig und"
" zurückhaltend. Trotzdem ist es seltsam zu denken, dass er tot ist...\""

#: src-en/data/events_sector_militia.xml:1462
