#: src-en/data/events_sector_militia.xml:1180
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_EVIDENCE_MENU\"]/choice[3]/text"
msgstr "Untersuche die Station."

#: src-en/data/events_sector_militia.xml:1182
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_EVIDENCE_MENU\"]/choice[3]/event/text"
msgstr ""
"Die Station hat mehrere Systeme an Bord. Welches möchtest du dir ansehen?"

#: src-en/data/events_sector_militia.xml:1184
msgid ""
"data/events_sector_militia.xml$//event[@name=\"DETECTIVE_EVIDENCE_MENU\"]/choice[3]/event/choice[1]/text"
