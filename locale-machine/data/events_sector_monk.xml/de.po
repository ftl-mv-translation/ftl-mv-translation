"data/events_sector_monk.xml$//event[@name=\"NEBULA_MONK_HOSTAGES\"]/choice[1]/event/text"
msgstr "\"Oh, sssso willst du kämpfen? Dann mach dich bereit zu sterben!\""

#: src-en/data/events_sector_monk.xml:600
