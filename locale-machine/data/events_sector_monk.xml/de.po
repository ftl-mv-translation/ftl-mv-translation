#: src-en/data/events_sector_monk.xml:608
msgid ""
"data/events_sector_monk.xml$//event[@name=\"NEBULA_MONK_HOSTAGES\"]/choice[2]/event/text"
msgstr ""
"\"Ahhhh, lassen Sie uns doch bitte unseren vernünftigen Preis bezahlen!\" "
"Die Hacker geben die Kontrolle über das Kloster auf und springen weg."

#: src-en/data/events_sector_monk.xml:613
