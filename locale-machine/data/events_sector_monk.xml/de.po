#: src-en/data/events_sector_monk.xml:591
msgid "data/events_sector_monk.xml$//event[@name=\"NEBULA_MONK_HOSTAGES\"]/text"
msgstr ""
"Anscheinend ist das nahegelegene Kloster in Schwierigkeiten! Ein Slug-Hacker"
" hält sie als Geisel und sendet eine Nachricht an alle nahegelegenen "
"Schiffe, in der er ein absurdes Lösegeld für die Mönche fordert."

#: src-en/data/events_sector_monk.xml:595
