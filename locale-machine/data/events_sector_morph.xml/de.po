msgid ""
"data/events_sector_morph.xml$//event[@name=\"NEBULA_MORPH_PEEPEEPOOPOO\"]/choice[4]/text"
msgstr "Das ist nichts weiter als vulgär und grob."

#: src-en/data/events_sector_morph.xml:532
msgid ""
"data/events_sector_morph.xml$//event[@name=\"NEBULA_MORPH_PEEPEEPOOPOO\"]/choice[4]/event/text"
msgstr ""
"Du glaubst nicht, dass ein solcher Satz irgendeine Bedeutung haben könnte. "
"Du gibst dieses Gedankenexperiment auf und machst weiter."

#: src-en/data/events_sector_morph.xml:534
