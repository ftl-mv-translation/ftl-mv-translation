"bisschen damit, aber ein Sternenblitz trifft dein Schiff und verursacht "
"Schaden. Du gibst auf und eilst weg."

#: src-en/data/events_sector_morph.xml:362
msgid ""
"data/events_sector_morph.xml$//eventList[@name=\"MORPH_SOLAR_STUPID\"]/event[4]/text"
msgstr ""
