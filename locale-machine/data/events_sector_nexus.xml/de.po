#: src-en/data/events_sector_nexus.xml:2703
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE\"]/choice/event/choice[3]/text"
msgstr "Chips?"

#: src-en/data/events_sector_nexus.xml:2710
msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/text"
msgstr "\"NEIN! Komm schon, rate mal! Ernsthaft, Fremder!\""

#: src-en/data/events_sector_nexus.xml:2712
msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/text"
msgstr "Ich weiß es wirklich nicht."

#: src-en/data/events_sector_nexus.xml:2714
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/text"
msgstr "\"KUM JETZT! RATE MAL! RATE MAL!!!\""

#: src-en/data/events_sector_nexus.xml:2716
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/text"
msgstr "Bitte Mann, hör einfach auf."

#: src-en/data/events_sector_nexus.xml:2718
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/event/text"
msgstr "\"WAS. IST. DER. LIEBLINGS. SNACK. VON. EINEM. SLUG?!\""

#: src-en/data/events_sector_nexus.xml:2720
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/event/choice/text"
msgstr "Schau, ich weiß das echt nicht."

#: src-en/data/events_sector_nexus.xml:2722
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/event/choice/event/text"
msgstr ""
"\"RATTE! SCHEIẞ! RATTE! SCHEIẞ! WARUM WILLST DU NICHT MIT MIR REDEN?!WAS IST"
" MEIN LIEBLINGSSNACK?!WARUM MUSST DU MICH IM STICH?!\""

#: src-en/data/events_sector_nexus.xml:2724
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/event/choice/event/choice/text"
msgstr "Du machst mir Angst, bitte hör auf."

#: src-en/data/events_sector_nexus.xml:2726
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/event/choice/event/choice/event/text"
msgstr "\"ZITRONEN UND SCHLEIM! AUGH! SCHEIẞ! DU BIST NICHTS WERT!\""

#: src-en/data/events_sector_nexus.xml:2729
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_JOKE_2\"]/choice/event/choice/event/choice/event/choice/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2753
msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/text"
msgstr ""
"Du erhältst einen Gruß von einer nahegelegenen Gruppe von Sylvans. \"Ach, "
"wir haben uns gefragt, ob du auftauchen würdest, Fremder! Wir brauchen deine"
" Hilfe. Sieh mal, da ist dieser Außenseiter hier. Und er denkt irgendwie, na"
" ja... er denkt, er wäre ein Sylvan, Fremder. Aber das ist er nicht! Und "
"Sylvan Prime ist nicht glücklich, ihn hier zu lassen. Keiner von uns will "
"derjenige sein, der ihm so... könntest du dich um ihn kümmern?\""

#: src-en/data/events_sector_nexus.xml:2755
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/text"
msgstr "Klar."

#: src-en/data/events_sector_nexus.xml:2757
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/text"
msgstr ""
"Du folgst den Sylvans zu einem, was nur ein freies Mantis-Schiff zu sein "
"scheint. \"Viele Grüße, Fremder! Wie schön, dich hier zu sehen, und du "
"machst Freunde mit anderen Sylvans! Wunderbar! Ich bin ein freies Mantis-"
"Sylvan aus einer anderen Realität, und ich mache große Geschäfte! Willst du "
"auch handeln, Fremder?\""

#: src-en/data/events_sector_nexus.xml:2759
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/choice[1]/text"
msgstr "Du bist doch nicht wirklich Sylvan."

#: src-en/data/events_sector_nexus.xml:2761
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/choice[1]/event/text"
msgstr ""
"\"Was!? Was sagst du? Wie konntest du so gemein sein?\" Als die anderen "
"Sylvans anfangen zu murmeln, beginnt Free Mantis 'Sylvan' zu weinen und hebt"
" seine Waffen!"

#: src-en/data/events_sector_nexus.xml:2764
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/choice[1]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2770
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/choice[2]/text"
msgstr "Tausche einfach mit ihm."

#: src-en/data/events_sector_nexus.xml:2772
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/choice[2]/event/text"
msgstr ""
"Du kannst es nicht ertragen, dieser Typ hier die Wahrheit zu lügen. Leider "
"nehmen die anderen Sylvans das nicht gut. Als sie merken, dass du ihnen "
"nicht helfen wirst, werden sie feindselig!"

#: src-en/data/events_sector_nexus.xml:2775
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[1]/event/choice[2]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2783
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[2]/text"
msgstr "Nein."

#: src-en/data/events_sector_nexus.xml:2785
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[2]/event/text"
msgstr "\"Hmph, wenn du so sagst, Fremder.\""

#: src-en/data/events_sector_nexus.xml:2787
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[2]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_nexus.xml:2791
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS\"]/choice[2]/event/choice[2]/text"
msgstr "Nichts tun."

#: src-en/data/events_sector_nexus.xml:2798
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS_KILL\"]/text"
msgstr ""
"Nach diesem Kampf fühlst du dich schlecht. Dennoch belohnen dich die anderen"
" Sylvans für deine 'Hilfe'."

#: src-en/data/events_sector_nexus.xml:2808
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS_SAVE\"]/text"
msgstr ""
"Die Sylvans sind besiegt. Free Mantis 'Sylvan' ist verängstigt, aber "
"wenigstens lebt er. \"Oh mein Gott, die sind so albern! Mensch, sie wollen "
"doch nicht an Tod und Gewalt. Ach was. Willst du jetzt den großen Handel "
"machen?\""

#: src-en/data/events_sector_nexus.xml:2817
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_FREEMANTIS_SAVE\"]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2828
msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/text"
msgstr ""
"Ein weiterer seltsam gefärbter Sylvan fliegt vorbei, bleibt aber stehen, als"
" er dich sieht. \"Fremder, sieh dich mal an! Schämst du dich nicht, dass du "
"diese Technologie benutzt? Ich meine, ernsthaft Fremder!\""

#: src-en/data/events_sector_nexus.xml:2831
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/text"
msgstr "Was?"

#: src-en/data/events_sector_nexus.xml:2833
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/event/text"
msgstr ""
"\"Deine weiche Sci-Fi-Technologie. Du machst doch buchstäblich Gesetze der "
"Physik kaputt! Schämst du dich nicht für deinen Gebrauch von so etwas? Ich "
"meine, Teleportation ergibt keinen Sinn, es ist buchstäblich der Transfer "
"von Materie zwischen zwei völlig getrennten Punkten. Und was sind überhaupt "
"Schilde und warum stoppen sie Flak und Asteroiden, aber nicht Raketen. FTL "
"ist nicht mal möglich, Einstein hat es selbst gesagt. Das ist alles Unsinn. "
"Verdammt, mein Boden ist magnetisch! Künstliche Schwerkraft ist nicht "
"real!\""

#: src-en/data/events_sector_nexus.xml:2835
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/event/choice[1]/text"
msgstr "Hast du nicht eigentlich einen MV-Antrieb?"

#: src-en/data/events_sector_nexus.xml:2837
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/event/choice[1]/event/text"
msgstr ""
"\"I-was? Ähm, ich... Wie kannst du mich nur so beleidigen, Fremder! Ich "
"dulde keine derartigen Beleidigungen! Und ja, meine Böden sind wirklich "
"magnetisch! Abwarten und fressen!\""

#: src-en/data/events_sector_nexus.xml:2840
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/event/choice[1]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2846
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/event/choice[2]/text"
msgstr "Spiel mit."

#: src-en/data/events_sector_nexus.xml:2848
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI\"]/choice/event/choice[2]/event/text"
msgstr ""
"Sylvan brabbelt noch eine Weile weiter, wird dann aber müde und hört auf. "
"\"Nun, da du anscheinend deine Lektion gelernt hast, werde ich vielleicht "
"mit dir handeln, Fremder.\""

#: src-en/data/events_sector_nexus.xml:2856
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI_DEFEAT\"]/text"
msgstr ""
"Trotz seines nahen Todes meckert Sylvan immer noch. \"Warum hören wir "
"überhaupt die Explosionen? Das ist doch Weltraum! Im Weltraum gibt es keinen"
" Schall.\""

#: src-en/data/events_sector_nexus.xml:2868
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_HARDSCIFI_DEFEAT\"]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2879
msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/text"
msgstr ""
"Sobald du am Signalpunkt ankommst, stellst du fest, dass deine Triebwerke "
"auf fast nichts mehr begrenzt sind. Auf dem Bildschirm erscheint Obyn, der "
"sehr neugierig wirkt, da man seine Varianten selten zu Gesicht bekommt, aber"
" leider scheint dies keine freundliche Begegnung zu sein."

#: src-en/data/events_sector_nexus.xml:2883
msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_nexus.xml:2885
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/text"
msgstr ""
"\"Nyeheheheheh! Ich habe dich endlich gefangen! Nun wirst du meine ... "
"Rätsel lösen!\" Du bist verwirrt, erhältst aber eine zweite Funkverbindung "
"vom selben Schiff, und Sylvan erscheint auf dem Bildschirm. \"Hey da, "
"Sstranger. Schau, versuch einfach, meinen Obyn zu unterhalten, ja? Er kommt "
"selten mit Außenseitern in Kontakt. Das würde ihm die Welt bedeuten.\""

#: src-en/data/events_sector_nexus.xml:2887
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/text"
msgstr "Löse seine Rätsel."

#: src-en/data/events_sector_nexus.xml:2889
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/text"
msgstr ""
"\"Wunderbar! Ich, der GROẞE Obyn, fordere dich zu einem Duell im ... "
"Kreuzworträtsel heraus!\" Obyn strahlt zu deinem Schiff hinüber und reicht "
"dir ein Kreuzworträtsel. Es dauert einen Moment, aber du löst es mühelos."

#: src-en/data/events_sector_nexus.xml:2891
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/text"
msgstr "Gib ihm das Puzzle."

#: src-en/data/events_sector_nexus.xml:2893
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/text"
msgstr ""
"\"Nyehehe- warte mal. Sind das alle richtig? Hast du geschummelt? Nun gut, "
"dann zum nächsten Puzzle! Ich fordere dich zu einem Spiel von... Stein, "
"Schere, Papier!\""

#: src-en/data/events_sector_nexus.xml:2895
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/text"
msgstr "Stein, Schere, Papier spielen."

#: src-en/data/events_sector_nexus.xml:2897
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/text"
msgstr ""
"Du spielst mehrere Runden Stein, Schere, Papier, bei denen Obyn jedes Mal "
"verliert. \"Das ist nicht fair! Ich fordere dich zu einem erneuten Match! "
"Der große Obyn verliert nicht gegen einen Renegaten!\""

#: src-en/data/events_sector_nexus.xml:2899
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/text"
msgstr "Nochmal Stein, Schere, Papier spielen."

#: src-en/data/events_sector_nexus.xml:2901
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/text"
msgstr ""
"Obyn gewinnt dieses Mal ein paar Spiele, aber du schlägst ihn immer wieder. "
"Schließlich wird er müde. \"Hmhp, gut! Stein, Schere, Papier ist sowieso "
"Glück! Ich fordere dich jetzt zu einem Spiel von... Allgemeinwissen!\""

#: src-en/data/events_sector_nexus.xml:2903
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/text"
msgstr "Mit Obyn Allgemeinwissen spielen."

#: src-en/data/events_sector_nexus.xml:2905
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/text"
msgstr "\"Wer... ist der Admiral des Aufstands?\""

#: src-en/data/events_sector_nexus.xml:2907
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[1]/text"
msgstr "Adara."

#: src-en/data/events_sector_nexus.xml:2913
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/text"
msgstr "Vance."

#: src-en/data/events_sector_nexus.xml:2915
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/event/text"
msgstr ""
"\"Du... hast recht! Bah! Nächste Frage! Was ist... der Name der Kestrel?\""

#: src-en/data/events_sector_nexus.xml:2917
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/event/choice[1]/text"
msgstr "Die Osprey."

#: src-en/data/events_sector_nexus.xml:2923
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/event/choice[2]/text"
msgstr "Die Nesasio."

#: src-en/data/events_sector_nexus.xml:2929
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/event/choice[3]/text"
msgstr "Die Kestrel."

#: src-en/data/events_sector_nexus.xml:2931
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[1]/event/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/event/choice[3]/event/text"
msgstr ""
"\"Du... hast wieder recht! Bah! Nächste Frage! Was ist... die Hauptfunktion "
"von Tiiikaka?\""

