msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_CASHGRAB\"]/choice[4]/event/text"
msgstr ""
"\"Vielleicht ein anderes Mal dann, ~~~Fremder! Ich bin mir sicher, dass dies"
" nicht das Letzte ist, was wir uns sehen werden, in dieser Realität oder "
"einer anderen.\""

