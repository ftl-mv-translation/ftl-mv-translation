msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS\"]/choice/event/choice[2]/event/text"
msgstr ""
"\"Dann sssag ich's ja nicht umsonst, ssstranger.\" Obyn drängt Sylvan zur "
"Seite und befiehlt der Crew des Schiffs, das Feuer auf dich zu eröffnen."

#: src-en/data/events_sector_nexus.xml:3109
msgid ""
