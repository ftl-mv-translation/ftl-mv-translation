#: src-en/data/events_sector_nexus.xml:48
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"NEXUS_PORTAL\"]/choice[2]/text"
msgstr "Es gab wohl keinen Grund, hier her zu kommen."

#: src-en/data/events_sector_nexus.xml:50
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"NEXUS_PORTAL\"]/choice[2]/event/text"
msgstr ""
"Wie enttäuschend es auch sein mag, du kannst keinen Grund finden, hier her "
"gekommen zu sein. Das war wohl eine Zeitverschwendung. Oder vielleicht gab "
"es etwas hier, dass du einfach nicht finden konntest..."

