#: src-en/data/events_sector_nexus.xml:116
msgid "data/events_sector_nexus.xml$//event[@name=\"NEXUS_PORTAL_2\"]/text"
msgstr ""
"In der Ferne kannst du ein Schiff erkennen, welches auf dich zufliegt und du"
" bemerkst schnell, dass es Sylvan ist! \"Fremder, du ssssolltest nicht hier "
"sein... Wie hast du diessssen Ort gefunden? Oh, es ist egal. Du darfsssst "
"nicht hier bleiben, Fremder. Es isssst gefährlich!\""

#: src-en/data/events_sector_nexus.xml:118
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"NEXUS_PORTAL_2\"]/choice[1]/text"
msgstr "Was ist dieser Ort?"

#: src-en/data/events_sector_nexus.xml:120
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"NEXUS_PORTAL_2\"]/choice[1]/event/text"
msgstr ""
"\"Dassss ist keine gute Zeit, um Fragen zu stellen, Fremder. Du darfsssst "
"nicht näher kommen. Ich wünsssschte, dasssss ich es dir erklären könnte "
"Fremder, aber dassss ist ernst. Dassss ist meine letzte Warnung. Kehre um "
"oder ich habe keine Wahl, als dich zu zwingen, Fremder...\""

#: src-en/data/events_sector_nexus.xml:122
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"NEXUS_PORTAL_2\"]/choice[1]/event/choice[@req=\"challenge_level\""
" and @lvl=\"0\"]/text"
