msgid "data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS_DEFEAT\"]/text"
msgstr ""
"\"Scheint, als wär'ss vorbei, oder? Na ja. Sssee dich später, ssstranger.\""

#: src-en/data/events_sector_nexus.xml:3127
msgid ""
"data/events_sector_nexus.xml$//event[@name=\"SYLVAN_SANS_DEFEAT\"]/choice/text"
