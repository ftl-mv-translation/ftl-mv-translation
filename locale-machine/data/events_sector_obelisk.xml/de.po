#: src-en/data/events_sector_obelisk.xml:1444
msgid ""
"data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/choice[@req=\"DISTRACTION_BUOY\"]/text"
msgstr ""
"(Täuschbojen) Gib ihnen deine Daten, aber verfälsche deine Flugpläne "
"sorgfältig."

#: src-en/data/events_sector_obelisk.xml:1446
msgid ""
"data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/choice[@req=\"DISTRACTION_BUOY\"]/event/text"
msgstr ""
"\"Danke, freundlicher Hautsack! Ich weiß das sehr zu schätzen.\" Das Schiff "
"springt weg. Gut, dass die Obelisken darauf hereingefallen sind, und jetzt, "
"falls es in Hände von Rebellen fällt, werden sie es nicht gegen dich "
"benutzen können.\""

#: src-en/data/events_sector_obelisk.xml:1455
msgid ""
"data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/choice[4]/text"
msgstr "Ablehnen."

#: src-en/data/events_sector_obelisk.xml:1457
msgid ""
"data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/choice[4]/event/text"
msgstr ""
"\"Sehr unglücklich. Jetzt bin ich traurig. Auf Wiedersehen.\" Das Schiff "
"springt weg."

#: src-en/data/events_sector_obelisk.xml:1459
msgid ""
