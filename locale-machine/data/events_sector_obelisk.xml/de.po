#: src-en/data/events_sector_obelisk.xml:1433
msgid "data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/text"
msgstr ""
"\"Sterbliche Kreaturen! Eure Kultur ist sehr seltsam, aber ich bin "
"fasziniert davon! Ich möchte mehr wissen! Bitte, speise mich mit den Daten "
"eures Schiffes, und ich werde euch reich bezahlen für das Wissen!\" Das ist "
"ein verlockendes Angebot, aber du hast keine Ahnung, ob diese Daten am Ende "
"in Hände von Rebellen gelangen. Willst du das Risiko eingehen?"

#: src-en/data/events_sector_obelisk.xml:1436
msgid ""
"data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/choice[1]/text"
msgstr "Deine Daten anbieten."

#: src-en/data/events_sector_obelisk.xml:1440
msgid ""
"data/events_sector_obelisk.xml$//event[@name=\"ROYAL_DATA\"]/choice[2]/text"
