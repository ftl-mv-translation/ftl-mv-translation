#: src-en/data/events_sector_obelisk.xml:1471
msgid ""
"data/events_sector_obelisk.xml$//eventList[@name=\"ROYAL_DATA_SELL\"]/event[1]/text"
msgstr ""
"\"Danke, freundlicher Hautsack! Ich weiß das sehr zu schätzen.\" Das Schiff "
"springt weg. Hoffentlich fangen die Rebellen dieses Schiff nicht ein und "
