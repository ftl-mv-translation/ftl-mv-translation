msgid ""
"data/events_sector_origins.xml$//event[@name=\"CULTIST_CHURCH_BEGIN\"]/choice[2]/event/choice[1]/event/choice/event/choice/event/choice[1]/event/text"
msgstr "Du rast auf den gigantischen Kreuzer zu, die Waffen laden auf."

#: src-en/data/events_sector_origins.xml:1306
msgid ""
"data/events_sector_origins.xml$//event[@name=\"CULTIST_CHURCH_BEGIN\"]/choice[2]/event/choice[1]/event/choice/event/choice/event/choice[1]/event/choice/text"
