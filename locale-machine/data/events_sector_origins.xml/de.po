"data/events_sector_origins.xml$//event[@name=\"CULTIST_CHURCH_FAKE\"]/choice[@req=\"loc_emberchurch_ruwen\""
" and @lvl=\"0\"]/text"
msgstr "Fortfahren..."

#: src-en/data/events_sector_origins.xml:1212
msgid ""
"data/events_sector_origins.xml$//event[@name=\"CULTIST_CHURCH_FAKE\"]/choice[@req=\"loc_emberchurch_ruwen\""
" and @lvl=\"0\"]/event/text"
msgstr "Es ist ein ziemlicher Anblick, aber es gibt nicht viel zu tun."

#: src-en/data/events_sector_origins.xml:1214
msgid ""
"data/events_sector_origins.xml$//event[@name=\"CULTIST_CHURCH_FAKE\"]/choice[@req=\"loc_emberchurch_ruwen\""
" and @lvl=\"0\"]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_origins.xml:1218
