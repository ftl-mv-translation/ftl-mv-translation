"data/events_sector_origins.xml$//eventList[@name=\"ORIGINS_ATTACKERS_LIST\"]/event[3]/text"
msgstr ""
"Anscheinend ist der Angreifer ein Rebell-Schiff. Du bereitest dich auf einen"
" Angriff vor."

#: src-en/data/events_sector_origins.xml:1006
msgid ""
"data/events_sector_origins.xml$//eventList[@name=\"ORIGINS_ATTACKERS_LIST\"]/event[3]/choice/text"
