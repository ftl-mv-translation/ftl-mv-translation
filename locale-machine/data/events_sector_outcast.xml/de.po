#: src-en/data/events_sector_outcast.xml:1256
msgid "data/events_sector_outcast.xml$//event[@name=\"QUEST_SSLG_MISTAKE\"]/text"
msgstr ""
"\"Abtrünniger! Normalerweise würde ich mich nicht mit eurer Art aufhalten, "
"aber ich habe einen schrecklichen Fehler gemacht! Ich hatte Informationen "
"über den Standort einer Rockman-Siedlung erhalten. Ich habe unser Schiff "
"angewiesen, sie von der Theokratie zu befreien, aber es scheint, dass ich "
"voreilig gehandelt habe. Es war eigentlich eine Siedlung der Verstoßenen, "
"keine der Theokratie. Bitte, du musst meine Leute kontaktieren, bevor es zu "
"spät ist! Du musst ihnen sagen, dass sie die Siedlung schützen und nicht "
"angreifen sollen.\""

#: src-en/data/events_sector_outcast.xml:1259
msgid ""
"data/events_sector_outcast.xml$//event[@name=\"QUEST_SSLG_MISTAKE\"]/choice[1]/text"
msgstr "Akzeptieren."

