"data/events_sector_outcast.xml$//event[@name=\"DISTRESS_OUTCAST_TENSIONS\"]/choice/event/choice[2]/event/choice[2]/text"
msgstr "Nichts tun."

#: src-en/data/events_sector_outcast.xml:1083
msgid ""
"data/events_sector_outcast.xml$//eventList[@name=\"OUTCAST_TENSIONS_TALK\"]/event[1]/text"
msgstr ""
"Sowohl der Kristall als auch der Rockman schauen dich verwirrt an. Du "
"versuchst, ihnen deine Sichtweise zu erklären. Sie machen dich jedoch "
"einfach stumm und schreien weiter. Das wird nichts."

#: src-en/data/events_sector_outcast.xml:1085
msgid ""
"data/events_sector_outcast.xml$//eventList[@name=\"OUTCAST_TENSIONS_TALK\"]/event[1]/choice[1]/text"
