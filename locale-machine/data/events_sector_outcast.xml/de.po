#: src-en/data/events_sector_outcast.xml:83
msgid ""
"data/events_sector_outcast.xml$//event[@name=\"OUTCAST_STORIES\"]/choice[1]/event/choice[1]/event/choice[5]/text"
msgstr "Ich weiß nicht, wer Tuco ist."

#: src-en/data/events_sector_outcast.xml:85
msgid ""
"data/events_sector_outcast.xml$//event[@name=\"OUTCAST_STORIES\"]/choice[1]/event/choice[1]/event/choice[5]/event/text"
msgstr ""
"\"Aha, ich verstehe. Tuco ist eine Legende, ein Held, aber vor allem nicht "
"nur eine Person, sondern viele. Es ist ein Titel, der durch Ehre und "
"Umstände weitergegeben wird. Wir Ausgestoßenen gedenken der vielen Tucos in "
"der Geschichte, die immer im Namen der Gerechtigkeit standen, ob gegen das "
"gefallene Rock-Crystal-Reich vor langer Zeit oder gegen die moderne "
"Theokratie. Da du dies nun weißt, möchtest du eine meiner Geschichten "
"hören?\""

