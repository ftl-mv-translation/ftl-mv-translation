#: src-en/data/events_sector_pirate.xml:3358
msgid ""
"data/events_sector_pirate.xml$//eventList[@name=\"CASINO_GAMBLE\"]/event[1]/text"
msgstr ""
"Drei goldene 7er blinken auf dem Bildschirm, gefolgt von einer lauten "
"Fanfare und Konfetti. Die Maschine brüllt in einer lauten Stimme: "
"„GLÜCKWUNSCH! Du hast verloren!“"

