msgstr "Randolph"

#: src-en/data/events_sector_rebel.xml:175
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"REBEL_TURNCOAT_AFTERMATH\"]/choice[2]/text"
msgstr "Zustimmen, ihn stattdessen im Gebiet der Föderation absetzen."

#: src-en/data/events_sector_rebel.xml:177
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"REBEL_TURNCOAT_AFTERMATH\"]/choice[2]/event/text"
msgstr ""
"Der Ex-Rebell dankt dir für deine Gnade und verspricht, von deinem guten "
