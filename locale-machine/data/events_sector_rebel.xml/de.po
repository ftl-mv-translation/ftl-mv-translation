msgid ""
"data/events_sector_rebel.xml$//event[@name=\"REBEL_TURNCOAT\"]/choice[4]/text"
msgstr "Das muss ein Trick sein. Halte Abstand von dem Shuttle."

#: src-en/data/events_sector_rebel.xml:93
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"REBEL_TURNCOAT\"]/choice[4]/event/text"
msgstr ""
"Sobald der Rebell merkt, dass du Abstand hältst, flieht er und blickt nicht "
"zurück."

#: src-en/data/events_sector_rebel.xml:95
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"REBEL_TURNCOAT\"]/choice[4]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

