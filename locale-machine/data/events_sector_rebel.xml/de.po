msgstr "Ignoriere die Nachricht."

#: src-en/data/events_sector_rebel.xml:146
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"MERCENARY_CHASING_REBEL_TURNCOAT\"]/choice[4]/event/text"
msgstr ""
"Das Schiff wartet auf deine Antwort, scheint aber kein Interesse mehr daran "
"zu haben, seine Zeit mit dir zu verschwenden, und springt woanders hin."

#: src-en/data/events_sector_rebel.xml:149
msgid ""
