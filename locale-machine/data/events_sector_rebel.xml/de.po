#: src-en/data/events_sector_rebel.xml:155
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"MERCENARY_CHASING_REBEL_TURNCOAT\"]/choice[5]/text"
msgstr "Greife das Syndikat-Schiff an."

#: src-en/data/events_sector_rebel.xml:157
msgid ""
"data/events_sector_rebel.xml$//event[@name=\"MERCENARY_CHASING_REBEL_TURNCOAT\"]/choice[5]/event/text"
msgstr ""
"Du bewaffnest dein Schiff und bereitest dich auf den Kampf vor. \"Also du "
"warst in diesen Verräter verwickelt. Diese Auszahlung wird sogar besser "
"sein, als wir gehofft haben!\""

#: src-en/data/events_sector_rebel.xml:160
