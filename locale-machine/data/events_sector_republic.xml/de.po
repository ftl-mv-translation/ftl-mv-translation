#: src-en/data/events_sector_republic.xml:519
msgid ""
"data/events_sector_republic.xml$//event[@name=\"LEECH_TAVERN\"]/choice[1]/event/choice[3]/event/text"
msgstr ""
"Diese Idioten können so viel diskutieren, wie sie wollen. Du lässt sie "
"weiter diskutieren und setzt dich mit ein paar Freunden hin, die du vorher "
"gesehen hattest und redest mit ihnen über nach einer kurzen Zeit über das "
"Handeln."

#: src-en/data/events_sector_republic.xml:526
msgid ""
