msgid ""
"data/events_sector_theocracy.xml$//event[@name=\"ROCK_ITEM_SONG_CONTEST\"]/choice[@req=\"LIST_CREW_ELLIE_COSTUME\"]/text"
msgstr "(Ellie) Ellie singt ihr Motto!"

#: src-en/data/events_sector_theocracy.xml:551
msgid ""
"data/events_sector_theocracy.xml$//event[@name=\"ROCK_ITEM_SONG_CONTEST\"]/choice[@req=\"LIST_CREW_ELLIE_COSTUME\"]/event/text"
msgstr ""
"Ellie singt ihr Motto enthusiastisch und trabt dabei über die Bühne. Der "
"Moderator ist von der Songwahl irritiert. „Nun... ich weiß nicht, was ich "
"von Fremden erwartet habe.“"

#: src-en/data/events_sector_theocracy.xml:553
