"data/events_sector_theocracy.xml$//event[@name=\"ROCK_APOLOGY\"]/choice[3]/text"
msgstr "Ignoriere sie."

#: src-en/data/events_sector_theocracy.xml:117
msgid ""
"data/events_sector_theocracy.xml$//event[@name=\"ROCK_APOLOGY\"]/choice[3]/event/text"
msgstr ""
"Das Flehen des Rockman dauert eine Weile an, aber du ignorierst es einfach "
