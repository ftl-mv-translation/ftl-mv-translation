#: src-en/data/events_sector_theocracy.xml:699
msgid ""
"data/events_sector_theocracy.xml$//event[@name=\"ROCK_ITEM_SONG_CONTEST\"]/choice[25]/event/text"
msgstr ""
"Der Wettbewerb ist ziemlich unterhaltsam, viele Rock-Performer sind hier, um"
" mitzumachen. In der Zwischenzeit könnte deine Crew etwas an Bord machen, "
"während sie zuhört."

#: src-en/data/events_sector_theocracy.xml:701
msgid ""
"data/events_sector_theocracy.xml$//event[@name=\"ROCK_ITEM_SONG_CONTEST\"]/choice[25]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_theocracy.xml:705
msgid ""
"data/events_sector_theocracy.xml$//event[@name=\"ROCK_ITEM_SONG_CONTEST\"]/choice[25]/event/choice[2]/text"
