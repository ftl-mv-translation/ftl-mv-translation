#: src-en/data/events_sector_unexplored.xml:632
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_SEPARATIST_ONLY\"]/choice[3]/event/text"
msgstr ""
"Das andere einsame Schiff bewegt sich nicht, was dir die Gelegenheit gibt, "
"etwas an deinem Schiff zu tun."

#: src-en/data/events_sector_unexplored.xml:634
msgid ""
