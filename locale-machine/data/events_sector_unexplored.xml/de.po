#: src-en/data/events_sector_unexplored.xml:182
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER_SMUGGLER\"]/choice[@req=\"loc_settlement_exists\""
" and @lvl=\"0\"]/event/choice[2]/event/text"
msgstr ""
"\"...War das nur ein vorbeikommender Schmuggler? Bist du sicher...? Nun, "
"wenn du das so sagst, denke ich. Wenn sie sich gegen uns wenden, dann ist "
"das deine Sache, Partner.“"

#: src-en/data/events_sector_unexplored.xml:189
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER_SMUGGLER\"]/choice[@req=\"loc_settlement_exists\""
" and @lvl=\"1\"]/text"
msgstr "Erzähle ihnen von den Siedlern, um ihre Reaktion abzuschätzen."

#: src-en/data/events_sector_unexplored.xml:191
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER_SMUGGLER\"]/choice[@req=\"loc_settlement_exists\""
" and @lvl=\"1\"]/event/text"
msgstr ""
"\"Ja, und? Warum sollte es uns interessieren? Schau uns mal an, Freund. Wir "
"Schmuggler vermeiden es, Aufmerksamkeit zu erregen.\" In diesem Moment "
"merkst du, dass der Planet, um den das Schiff kreist, ein kleines Versteck "
"hat. „Die wollen unsere Nachbarn sein? Dann sind wir leise. Willst du jetzt "
"etwas kaufen oder nicht?“"

#: src-en/data/events_sector_unexplored.xml:193
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER_SMUGGLER\"]/choice[@req=\"loc_settlement_exists\""
