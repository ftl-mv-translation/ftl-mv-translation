msgstr ""
"Das einsame Schiff bewegt sich nicht, was dir die Gelegenheit gibt, etwas "
"Eigenständiges zu tun."

#: src-en/data/events_sector_unexplored.xml:607
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_SEPARATIST_ONLY\"]/choice[1]/event/choice[7]/event/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_sector_unexplored.xml:611
