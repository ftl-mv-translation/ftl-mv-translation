msgstr ""
"„Nein, nein, nein!“ Die Piraten geraten in Panik bei dem Gedanken, gegen "
"Sylvan kämpfen zu müssen."

#: src-en/data/events_sector_unexplored.xml:1279
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"NEBULA_SLUG_HUNTER\"]/choice[1]/event/choice[@req=\"LIST_CREW_SYLVAN\"]/event/choice[1]/event/choice/text"
