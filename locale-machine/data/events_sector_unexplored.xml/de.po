"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER\"]/choice[5]/text"
msgstr "Sie ihrem eigenen Gut überlassen."

#: src-en/data/events_sector_unexplored.xml:127
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER\"]/choice[5]/event/text"
msgstr ""
"Die Stimme am anderen Ende murmelt. „Man kann sich auf niemanden verlassen, "
"ich schätze...“"

#: src-en/data/events_sector_unexplored.xml:129
msgid ""
"data/events_sector_unexplored.xml$//event[@name=\"UNEXPLORED_FRONTIER\"]/choice[5]/event/choice[1]/text"
