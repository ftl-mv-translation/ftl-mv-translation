#: src-en/data/events_sector_union.xml:1707
msgid ""
"data/events_sector_union.xml$//eventList[@name=\"DISTRESS_UNION_LANIUS_CONTACT\"]/event[1]/text"
msgstr ""
"Du sendest den Lanius Nachricht um Nachricht, um eine sinnvolle Antwort zu "
"provozieren. Die Antwort, die du bekommst, reicht von Schreien bis zu "
"Piepsgeräuschen. So sehr du dich anstrengst, könnt ihr euch nicht verstehen,"
" obwohl die Lanius keine aggressiven Bewegungen machen zu wollen scheinen. "
"Im Grunde stecken sie fest und wollen nur handeln, weil sie hungrig sind."

#: src-en/data/events_sector_union.xml:1709
msgid ""
"data/events_sector_union.xml$//eventList[@name=\"DISTRESS_UNION_LANIUS_CONTACT\"]/event[1]/choice/text"
msgstr "Informiere die Station."

#: src-en/data/events_sector_union.xml:1711
