#: src-en/data/events_sector_union.xml:2545
msgid ""
"data/events_sector_union.xml$//event[@name=\"QUEST_GATLING_BASE\"]/choice[1]/event/choice[2]/event/text"
msgstr ""
"Du fängst an zu graben, um herauszufinden, dass du recht hattest! Im Grab "
"ist die Gatling-Basis! Du lässt deine Crew sie zurück zum Schiff schleppen."

#: src-en/data/events_sector_union.xml:2548
msgid ""
"data/events_sector_union.xml$//event[@name=\"QUEST_GATLING_BASE\"]/choice[1]/event/choice[2]/event/choice/text"
