"data/events_sector_vagabond.xml$//event[@name=\"NEBULA_GHOST_ANGERY_SLUG\"]/choice[1]/event/text"
msgstr ""
"\"Hättest wissen müssen, dass du das versuchen würdest. Ich zerstöre dein "
"Schiff lieber, als dass die Ghossstsss es selbst beanspruchen.\""

#: src-en/data/events_sector_vagabond.xml:1021
msgid ""
"data/events_sector_vagabond.xml$//event[@name=\"NEBULA_GHOST_ANGERY_SLUG\"]/choice[1]/event/choice/text"
