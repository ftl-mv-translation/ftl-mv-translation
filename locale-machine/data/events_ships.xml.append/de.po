msgstr "\"ENDLICH. Gott sei Dank.\""

#: src-en/data/events_ships.xml.append:2925
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_AUTO_ZOLTAN_FACILITY\"]/destroyed/choice/event/choice[1]/event/choice[1]/event/choice[1]/event/choice[2]/text"
msgstr "Nimm die Waffe und verlass den Ort."

#: src-en/data/events_ships.xml.append:2933
