#: src-en/data/events_ships.xml.append:6206
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/surrender/text"
msgstr ""
"\"Wir geben auf! Wir finden woanders einen Ort zum Leben. Wenn wir hier "
"zerstört werden, sind die Flüchtlinge hilflos!\""

#: src-en/data/events_ships.xml.append:6208
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/surrender/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_ships.xml.append:6211
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/surrender/choice[1]/event/text"
msgstr ""
"Nachdem sie dir ihr Kapitulationsangebot gemacht haben, schalten die "
"Flüchtlingseskorte ihre Waffen ab und treiben ab, um sich zu reparieren, "
"bevor sie gehen."

#: src-en/data/events_ships.xml.append:6214
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/surrender/choice[1]/event/choice/text"
msgstr "Sprich mit der Milizpatrouille."

#: src-en/data/events_ships.xml.append:6225
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/destroyed/text"
msgstr ""
"Das verstoßene Schiff zerfällt bei deinem anhaltenden Angriff. Das "
"Flüchtlingsschiff flieht, als es zerstört wird."

#: src-en/data/events_ships.xml.append:6228
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/destroyed/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_ships.xml.append:6233
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_REFUGEE_ESCORT\"]/deadCrew/text"
msgstr ""
