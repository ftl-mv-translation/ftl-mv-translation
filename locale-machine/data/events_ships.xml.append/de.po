#: src-en/data/events_ships.xml.append:6181
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_MAKESHIFT_SLAVER\"]/destroyed/text"
msgstr "Die Sklavenhändler sind tot. Du machst aus ihrem Schiff Schrott."

#: src-en/data/events_ships.xml.append:6184
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_MAKESHIFT_SLAVER\"]/destroyed/choice/text"
msgstr "Befreie die Sklaven."

#: src-en/data/events_ships.xml.append:6186
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_MAKESHIFT_SLAVER\"]/destroyed/choice/event/text"
msgstr ""
"Du befreist alle Sklaven, die die Sklavenhändler im Lager gefangen gehalten "
"hatten. Die meisten lässt du einfach in einem nahegelegenen Outcast-Dorf "
"frei, aber einer bietet an, bei deiner Mission zu helfen."

#: src-en/data/events_ships.xml.append:6192
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_MAKESHIFT_SLAVER\"]/deadCrew/text"
