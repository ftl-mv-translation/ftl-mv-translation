"Schiff zu besiegen."

#: src-en/data/events_ships.xml.append:2394
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_ENGINEER_CHASED_BY_MILITIA\"]/gotaway/choice/text"
