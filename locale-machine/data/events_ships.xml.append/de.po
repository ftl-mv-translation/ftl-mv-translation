"mit ihnen untergeht. Ihr Schiff liefert kaum eine Belohnung."

#: src-en/data/events_ships.xml.append:4370
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_MONK_WEAPON\"]/deadCrew/text"
msgstr ""
