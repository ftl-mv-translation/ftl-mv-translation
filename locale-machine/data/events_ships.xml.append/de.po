" Angebot an, deiner Crew beizutreten."

#: src-en/data/events_ships.xml.append:12814
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_SLAVER_DEAD_SLAVES\"]/surrender/text"
