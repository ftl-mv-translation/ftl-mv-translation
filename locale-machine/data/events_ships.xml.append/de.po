"data/events_ships.xml.append$//ship[@name=\"SHIP_SLAVER_MINISTRY\"]/deadCrew/text"
msgstr ""
"Die Sklavenhändler verstummen, als du das letzte ihrer Crew niederstreckst. "
"Mit den Piraten tot kannst du ihr Schiff nach Gefangenen und Vorräten "
"durchsuchen."

#: src-en/data/events_ships.xml.append:12864
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_SLAVER_MINISTRY\"]/deadCrew/choice/text"
msgstr "Durchsuche das Schiff..."

