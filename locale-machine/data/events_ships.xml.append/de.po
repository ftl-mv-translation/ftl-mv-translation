"data/events_ships.xml.append$//ship[@name=\"SHIP_VAMPWEED_AMBASSADOR\"]/surrender/choice[2]/text"
msgstr "Ablehnen und die Station endgültig zerstören."

#: src-en/data/events_ships.xml.append:9800
