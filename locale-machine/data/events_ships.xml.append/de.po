msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_VAGABOND_OUTLAWS\"]/surrender/text"
msgstr ""
"\"Obwohl mein Ehemann mir mitteilt, dass dies unser Untergang sein wird, "
"möchte ich nicht sterben. Bitte, lass uns leben. Wir werden uns stellen.\""

#: src-en/data/events_ships.xml.append:11785
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_VAGABOND_OUTLAWS\"]/surrender/choice[1]/text"
