"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_MAKESHIFT_SLAVER\"]/deadCrew/choice/text"
msgstr "Befreie die Sklaven."

#: src-en/data/events_ships.xml.append:6197
