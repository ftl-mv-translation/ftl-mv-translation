msgstr ""
"Ex-Rebell oder nicht, wir lassen keine Güter in die Hände der Duskbringer "
"fallen!"

#: src-en/data/events_ships.xml.append:4565
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_DUSK_SNEAKYREBEL\"]/surrender/choice[2]/text"
