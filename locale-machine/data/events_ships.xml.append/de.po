"data/events_ships.xml.append$//ship[@name=\"SHIP_SLAVER_VIGILANTE\"]/destroyed/text"
msgstr ""
"Der Wächter der Basis wird in Stücke gesprengt. Du hoffst, dass sich keine "
"Sklaven an Bord befanden, aber angesichts des Zwecks dieses Schiffes ist das"
" unwahrscheinlich."

#: src-en/data/events_ships.xml.append:12902
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_SLAVER_VIGILANTE\"]/destroyed/choice/text"
