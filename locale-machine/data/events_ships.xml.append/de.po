#: src-en/data/events_ships.xml.append:4548
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_DUSK_SNEAKYREBEL\"]/surrender/choice[1]/event/text"
msgstr ""
"\"Schau, wir stammen nicht aus Universum 1. Nicht alle von uns unterstützen "
"diese genozidalen Realitätsspringer. Ich bin während des Bürgerkriegs zur "
"Rebellion gestoßen, weil ich dachte, Vance würde der Galaxie endlich "
"dauerhaften Frieden bringen – aber das hier? Das ist einfach zu weit. Wir "
"sind auf dem Weg, Vorräte an einen Duskbringer-Stützpunkt in diesem Sektor "
"zu liefern. Wir könnten etwas von den Vorräten abgeben, wenn das dich "
"zufriedengibt.\""

#: src-en/data/events_ships.xml.append:4550
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_DUSK_SNEAKYREBEL\"]/surrender/choice[1]/event/choice[1]/text"
