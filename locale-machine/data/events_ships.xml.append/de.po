"data/events_ships.xml.append$//ship[@name=\"SHIP_DUSK_SNEAKYREBEL\"]/surrender/text"
msgstr ""
"\"Halt, halt! Wir sind nicht eure Feinde! Hört auf zu feuern und wir können "
"es erklären!\""

#: src-en/data/events_ships.xml.append:4546
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_DUSK_SNEAKYREBEL\"]/surrender/choice[1]/text"
