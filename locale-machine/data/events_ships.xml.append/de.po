#: src-en/data/events_ships.xml.append:6091
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_OUTCAST_LOSTCARGO_INQUISITION\"]/deadCrew/choice/event/text"
msgstr ""
"Anscheinend waren die einzigen Schiffe, die nicht entkommen sind, ein paar "
"beschädigte Transportschiffe, die sich ergeben und dir eine Waffe aus ihrem "
