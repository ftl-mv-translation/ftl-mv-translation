#: src-en/data/events_ships.xml.append:127
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_UNION_INFORMANT\"]/gotaway/text"
msgstr ""
"Das Zivilistenschiff springt weg. Sie werden ohne Zweifel ihre Intentionen "
"erfüllen und die Rebellen informieren, besonders da du sie angegriffen hast."

#: src-en/data/events_ships.xml.append:131
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_UNION_INFORMANT\"]/destroyed/text"
msgstr ""
"Die Zivilisten wurden besiegt. Du bist nicht wirklich stolz, aber wenigstens"
" wissen die Rebellen jetzt nicht, wo du bist."

#: src-en/data/events_ships.xml.append:135
msgid ""
"data/events_ships.xml.append$//ship[@name=\"SHIP_UNION_INFORMANT\"]/deadCrew/text"
