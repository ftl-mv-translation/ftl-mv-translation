msgid ""
"data/events_special_curator.xml$//event[@name=\"CURA_DRAWING\"]/choice/event/choice[2]/event/choice[1]/event/text"
msgstr ""
"\"Freut mich, Geschäfte mit dir gemacht zu haben, Spinner. Und falls du mal "
"nette Müllhaufen findest – hier ist meine Nummer!\""

