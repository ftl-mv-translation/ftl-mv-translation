msgstr "(Waffen verbessern) Bedrohe den Leech."

#: src-en/data/events_special_curator.xml:537
msgid ""
"data/events_special_curator.xml$//event[@name=\"CURA_DRAWING\"]/choice/event/choice[2]/event/choice[@req=\"weapons\"]/event/text"
msgstr ""
"\"Uhuh... du willst mich wegen so einem Baumkram mit Buntstiftkratzern "
"umbringen? Mist, und ich dachte, die Koalition wäre manchmal schon "
"aufdringlich. Egal, Mann, ich sterbe nicht wegen irgendwas, was ich aus "
"einem umgekippten Mülleimer gezogen habe.\""

#: src-en/data/events_special_curator.xml:539
