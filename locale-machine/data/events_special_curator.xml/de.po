#: src-en/data/events_special_curator.xml:2118
msgid ""
"data/events_special_curator.xml$//event[@name=\"CURA_OUTPOST\"]/choice[@req=\"unique_turzil\"]/text"
msgstr "(Turzil) Bitte um das Tagebuch."

#: src-en/data/events_special_curator.xml:2120
msgid ""
"data/events_special_curator.xml$//event[@name=\"CURA_OUTPOST\"]/choice[@req=\"unique_turzil\"]/event/text"
msgstr ""
"\"General Turzil?\" Die Föderationsbeamten salutieren Turzil. \"Brauchen Sie etwas?\"\n"
"            \n"
"\t\t\t\"Wichtige Mission: Die -Bergung- des Tagebuchs von Vance Wentworth.\"\n"
"            \n"
"\t\t\t\"Jawohl, Sir. Benötigen Sie eine Kopie oder das Original?\"\n"
"            \n"
"\t\t\t\"Unklar. Das Original zu bergen, erscheint -logisch-.\"\n"
"            \n"
"\t\t\t\"Selbstverständlich. Sofort. Und, die Erlaubnis, frei zu sprechen?\"\n"
"            \n"
"\t\t\t\"Gewährt.\"\n"
"            \n"
"\t\t\t\"Es ist gut zu sehen, dass du noch am Leben bist.\"\n"
"            \n"
"\t\t\tWährend Turzil das Tagebuch holt, repariert der Föderationsposten dein Schiff und versorgt dich mit einigen Ressourcen."

