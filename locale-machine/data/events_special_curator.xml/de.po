#: src-en/data/events_special_curator.xml:791
msgid ""
"data/events_special_curator.xml$//event[@name=\"CURA_TOILET\"]/choice/event/choice/event/choice/event/text"
msgstr ""
"\"Nun, du hast Glück! Weil ich es weiß! Sag mir nur, wonach du suchst!\" Du "
"übergibst die besorgniserregend ausführlichen Details, die C.U.R.A. dir "
"gegeben hat, und in nur wenigen Minuten hat der Slug die gesuchte Toilette "
"bereits gefunden. \"Alles klar... das müsste es sein! Das macht 15 "
"Schrott.\""

