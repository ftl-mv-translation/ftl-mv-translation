#: src-en/data/events_special_defeat.xml:593
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_AUTO\"]/text[4]"
msgstr ""
"Es ist schwer, die Form dessen zu erkennen, was einst das Auto-Schiff war, "
"aus den Überresten deiner Zerstörung. Du magst es so besser."

