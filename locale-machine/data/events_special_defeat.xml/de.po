#: src-en/data/events_special_defeat.xml:14
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[1]"
msgstr "Schalte sie stumm und beende es."

#: src-en/data/events_special_defeat.xml:15
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[2]"
msgstr "Es wird keine Gnade geben."

#: src-en/data/events_special_defeat.xml:16
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[3]"
msgstr "Ignoriere ihre Rufe."

#: src-en/data/events_special_defeat.xml:17
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[4]"
msgstr "Lehne die Kapitulation ab."

#: src-en/data/events_special_defeat.xml:18
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[5]"
msgstr "Töte sie."

#: src-en/data/events_special_defeat.xml:19
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[6]"
msgstr "Setze deinen Angriff fort."

#: src-en/data/events_special_defeat.xml:20
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[7]"
msgstr "Zeige keine Gnade."

#: src-en/data/events_special_defeat.xml:21
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[8]"
msgstr "Ignoriere ihre Rufe."

#: src-en/data/events_special_defeat.xml:22
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[9]"
msgstr "Beende die Konversation und setze dem Kampf ein Ende."

#: src-en/data/events_special_defeat.xml:23
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[10]"
msgstr "Wir werden keine Gnade zeigen."

#: src-en/data/events_special_defeat.xml:24
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[11]"
msgstr "Wir werden sie begraben."

#: src-en/data/events_special_defeat.xml:25
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[12]"
msgstr "Heute wird es keine Gnade geben."

#: src-en/data/events_special_defeat.xml:26
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[13]"
msgstr "Lehne ihre Bitte von Vergebung ab."

#: src-en/data/events_special_defeat.xml:27
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[14]"
msgstr "Schenke ihnen keine Beachtung und kämpfe weiter."

#: src-en/data/events_special_defeat.xml:28
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[15]"
msgstr "Lass ihre Rufe unbeantwortet."

#: src-en/data/events_special_defeat.xml:29
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[16]"
msgstr "Führe den Angriff fort."

#: src-en/data/events_special_defeat.xml:30
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[17]"
msgstr "Verschone sie nicht."

#: src-en/data/events_special_defeat.xml:31
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[18]"
msgstr "Lass ihre Schreie durch deine Waffen verstummen."

#: src-en/data/events_special_defeat.xml:32
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[19]"
msgstr "Dieser Kampf kann nur mit ihren Tod enden."

#: src-en/data/events_special_defeat.xml:33
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[20]"
msgstr "Schalte sie stumm und kämpfe weiter."

#: src-en/data/events_special_defeat.xml:34
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"GENERIC_SURRENDER_CHOICE_NOMERCY\"]/text[21]"
msgstr "Sie werden nicht überleben, um einen anderen Tag zu sehen."

#: src-en/data/events_special_defeat.xml:45
msgid "data/events_special_defeat.xml$//event[@name=\"DESTROYED_TRAPPER\"]/text"
msgstr ""
"Beim Zerlegen des Fallensteller-Schiff findest du in der Mitte des Wracks "
"einen funktionalen treibenden Minenwerfer."

#: src-en/data/events_special_defeat.xml:51
msgid "data/events_special_defeat.xml$//event[@name=\"DEAD_CREW_TRAPPER\"]/text"
msgstr ""
"Der Trapper wurde von Gegner befreit. Währen du ihn zerlegst, findest du "
"einen Minenwerfer im Laderaum."

#: src-en/data/events_special_defeat.xml:64
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REINFORCEMENTS\"]/text"
msgstr ""
"Du sammelst die Überreste der Verstärkung, kannst jedoch nicht viel länger "
"bleiben, wegen der ASB."

#: src-en/data/events_special_defeat.xml:67
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REINFORCEMENTS\"]/choice[@req=\"MAGNET_ARM\"]/text"
msgstr "(Magnet Arm) Verschrotte das Wrack noch mehr."

#: src-en/data/events_special_defeat.xml:73
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REINFORCEMENTS\"]/choice[2]/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_defeat.xml:78
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DEADCREW_REINFORCEMENTS\"]/text"
msgstr ""
"Du sammelst die Überreste der Verstärkung, kannst jedoch nicht viel länger "
"bleiben, wegen der ASB."

#: src-en/data/events_special_defeat.xml:81
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DEADCREW_REINFORCEMENTS\"]/choice[@req=\"MAGNET_ARM\"]/text"
msgstr "(Magnet Arm) Verschrotte das Wrack noch mehr."

#: src-en/data/events_special_defeat.xml:87
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DEADCREW_REINFORCEMENTS\"]/choice[2]/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_defeat.xml:128
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_UNION\"]/text[1]"
msgstr ""
"Die Union ist in den Augen vieler das Herz der Föderation. Auf ihre Schiffe "
"zu feuern, wird die öffentliche Meinung der Renegades wahrscheinlich nicht "
"verbessern."

#: src-en/data/events_special_defeat.xml:129
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_UNION\"]/text[2]"
msgstr ""
"Der Kapitän der Union lässt ein letztes Fluchwort hören, als das Schiff "
"zerstört wird."

#: src-en/data/events_special_defeat.xml:130
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_UNION\"]/text[3]"
msgstr ""
"Die leuchtend rote Hülle des Union-Schiffs zerstreut sich im Weltraum. Du "
"stürzt ein, um die Überreste zu bergen."

#: src-en/data/events_special_defeat.xml:131
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_UNION\"]/text[4]"
msgstr ""
"Das Union-Schiff explodiert und löscht alles Leben darin aus. Deine Crew "
"meidet die Überreste, während sie die Schiffsteile bergen."

#: src-en/data/events_special_defeat.xml:132
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_UNION\"]/text[5]"
msgstr ""
"Du hörst einen statischen Schrei über die Kommunikation. Der Kapitän der "
"Union klammert sich an die zerbröckelnde Hülle seines Schiffes, als es "
"explodiert und ihn und seine Crew in den Vakuum des Weltraums schleudert."

#: src-en/data/events_special_defeat.xml:140
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_UNION\"]/text[1]"
msgstr ""
"\"Dein Blutdurst... wird eines Tages dein Untergang sein, Renegade. Du bist "
"nur ein Beweis dafür... dass die Föderation... nicht besser ist als der "
"Aufstand...\""

#: src-en/data/events_special_defeat.xml:141
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_UNION\"]/text[2]"
msgstr ""
"\"Selbst im Tod grüße ich dich. Ich hoffe nur, deine Mission war diesen "
"Massakern wert. Gott eilig, Metzger.\""

#: src-en/data/events_special_defeat.xml:142
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_UNION\"]/text[3]"
msgstr ""
"\"Der Kapitalismus hat mich im Stich gelassen! In meinen letzten Momenten "
"werde ich ein Kommunist werden...\" Der sterbende Kapitän der Union grübelt "
"über seine plötzliche Meinungsänderung. \"Nein, verpiss dich. Ich bin immer "
"noch Kapitalist. Verpiss dich, Arschloch. Agh!\""

#: src-en/data/events_special_defeat.xml:143
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_UNION\"]/text[4]"
msgstr ""
"Ohne ein Wort fällt der Kapitän der Union zu Boden und keucht nach Luft, als"
" das Leben aus seinen Augen erlischt. Du berestigst die Hülle seines "
"Schiffes."

#: src-en/data/events_special_defeat.xml:144
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_UNION\"]/text[5]"
msgstr ""
"\"Das wirst du bereuen! Karma holt immer bei Leuten wie dir nach. Verdammt "
"sei dir, Renegaten... Die Union wäre mit der Rebellion besser aufgehoben "
"gewesen...\""

#: src-en/data/events_special_defeat.xml:150
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_UNION\"]/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_special_defeat.xml:160
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_UNION\"]/text[1]"
msgstr ""
"\"Bitte! Die Union ist immer noch Teil der Föderation, derselben Föderation,"
" die du beschworen zu beschützen! Du kannst uns nicht töten!\""

#: src-en/data/events_special_defeat.xml:161
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_UNION\"]/text[2]"
msgstr ""
"\"Wie kannst du vorgeben, ein Agent der Einheit oder des Friedens zu sein, "
"wenn du Zivilisten masacrierst?! Wenn du irgendeine Hoffnung auf Erlösung "
"hast, lass uns sofort in Ruhe!\""

#: src-en/data/events_special_defeat.xml:162
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_UNION\"]/text[3]"
msgstr ""
"Der Kapitän der Union fleht dich an, sie leben zu lassen. \"Bitte, meine "
"Familie! Sie brauchen mich, ich bin ihre einzige Einkommensquelle! Ich gebe "
"dir alles, was ich kann, wenn du mich leben lässt!\""

#: src-en/data/events_special_defeat.xml:163
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_UNION\"]/text[4]"
msgstr ""
"Du erhältst einen Ruf aus einem anderen Teil des Union-Schiffs, wo ein "
"anderes Crewmitglied leise spricht. \"Bitte, wenn du aufhören zu feuern, "
"gebe ich dir alles, was noch im Frachtraum ist. Unser Kapitän ist stur, aber"
" der Rest der Crew will nicht sterben!\""

#: src-en/data/events_special_defeat.xml:164
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_UNION\"]/text[5]"
msgstr ""
"\"Oh bitte, bitte, bitte töte uns nicht! Ich erzähle niemandem davon, ich "
"gebe dir alles, was wir haben, lass uns nur leben!\""

#: src-en/data/events_special_defeat.xml:179
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_MILITIA\"]/text[1]"
msgstr ""
"Du hörst ein bedrohliches Knurren vom Kapitän der Miliz, als die Hülle "
"seines Schiffes reißt – und ihn für immer zum Schweigen bringt."

#: src-en/data/events_special_defeat.xml:180
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_MILITIA\"]/text[2]"
msgstr ""
"Während du die Überreste des Schiffes der Miliz einsammelst, ist klar, wie "
"hervorragend die Handwerkskunst ihres Schiffes war."

#: src-en/data/events_special_defeat.xml:181
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_MILITIA\"]/text[3]"
msgstr ""
"In einem Wirbel aus Funken und Explosionen stürzt die Hülle des Milizschiffs"
" ein. Du schrottest schnell die Überreste, die immer noch in gutem Zustand "
"zu sein scheinen."

#: src-en/data/events_special_defeat.xml:182
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_MILITIA\"]/text[4]"
msgstr ""
"Die Miliz ist zwar eine zivile Truppe, aber dennoch ein kompetentes und "
"fähiges militärisches Gut. Ein solches Schiff außer Gefecht zu setzen, ist "
"wirklich eine Leistung."

#: src-en/data/events_special_defeat.xml:190
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_MILITIA\"]/text[1]"
msgstr ""
"\"Ich... aber...\" Der Kapitän der Miliz klammert sich an seinen sterbenden "
"Körper und versucht, diesen Verrat zu rationalisieren. Ohne letzte Worte "
"fällt er zu Boden."

#: src-en/data/events_special_defeat.xml:191
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_MILITIA\"]/text[2]"
msgstr ""
"\"Als ich mich für diesen Job gemeldet habe, kannte ich die Risiken. Ich "
"wusste, dass ich wahrscheinlich sterben würde. Ich dachte nur, es wären "
"Rebellen oder Piraten, nicht ein Agent der Föderation.\""

#: src-en/data/events_special_defeat.xml:192
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_MILITIA\"]/text[3]"
msgstr ""
"\"Nun, bis in die Hölle, ich schätze.\" Der Kapitän der Miliz gibt in seinen"
" letzten Momenten einen vorgetäuschten Salut."

#: src-en/data/events_special_defeat.xml:193
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_MILITIA\"]/text[4]"
msgstr ""
"\"Um ehrlich zu sein... das war weit über meinem... Gehalt...\" Der Kapitän "
"der Miliz hält sich an die Brust und bricht zusammen."

#: src-en/data/events_special_defeat.xml:199
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_MILITIA\"]/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_special_defeat.xml:209
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_MILITIA\"]/text[1]"
msgstr ""
"\"Schützen und dienen, mein Arsch! Ich bin fertig! Nimm alles, was ich habe,"
" und lass mich einfach leben!\""

#: src-en/data/events_special_defeat.xml:210
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_MILITIA\"]/text[2]"
msgstr ""
"\"Du bist der Grund, warum die Miliz überhaupt existiert! Ich habe gehört, "
"Renegaten hassen das Wort Söldner, und du hast recht! Du bist doch nur "
"gewöhnlicher Piratenmüll! Ich kann nicht glauben, dass ich für einen Piraten"
" die weiße Flagge hisse...\""

#: src-en/data/events_special_defeat.xml:211
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_MILITIA\"]/text[3]"
msgstr ""
"Zögernd grüßt dich der Kapitän der Miliz und bietet Kapitulation an, wenn du"
" seine Crew unversehrt lässt."

#: src-en/data/events_special_defeat.xml:212
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_MILITIA\"]/text[4]"
msgstr ""
"\"Und ich dachte, ihr Renegaten solltet Unschuldige wie mich beschützen! "
"Wenn ihr auch nur einen Funken Menschlichkeit in euch habt, lasst uns "
"gehen.\""

#: src-en/data/events_special_defeat.xml:213
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_MILITIA\"]/text[5]"
msgstr ""
"Die Kommunikation des Militärschiffs scheint Probleme zu haben, aber ihr "
"Kapitän winkt verzweifelt, dass ihr anhalten sollt, und hält ein Blatt "
"Papier mit dem Symbol für Schrott hoch."

#: src-en/data/events_special_defeat.xml:228
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION\"]/text[1]"
msgstr ""
"\"MAYDAY! MAYDAY! MAY-\" Der verzweifelte Hilferuf des Föderationskapitäns "
"wird plötzlich durch die Zerstörung seines Schiffes verstummt."

#: src-en/data/events_special_defeat.xml:229
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION\"]/text[2]"
msgstr ""
"Wenn zukünftige Schiffe auf diese Wrackstelle stoßen, werden die Leute "
"wahrscheinlich davon ausgehen, dass das die Arbeit von Rebellen oder Piraten"
" war. Aber die Spur wird irgendwann zu euch führen."

#: src-en/data/events_special_defeat.xml:230
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION\"]/text[3]"
msgstr ""
"Schade, die brandneuen Modelle der Föderation so schnell außer Gefecht zu "
"setzen. Als die Föderation mit der Herstellung von aktualisierten Designs "
"Druck machte, hatten sie Konflikte mit Rebellen im Hinterkopf ... aber nicht"
" unbedingt mit ihren eigenen Angestellten, den Renegaten."

#: src-en/data/events_special_defeat.xml:231
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION\"]/text[4]"
msgstr ""
"Du bekommst ein unheimliches Gefühl, als du zusiehst, wie ein "
"Föderationsschiff in Schrott zerfällt – aber wenigstens war es nicht deins."

#: src-en/data/events_special_defeat.xml:232
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION\"]/text[5]"
msgstr ""
"Eine letzte Explosion markiert das Ende des Föderationskapitäns, als sein "
"Schiff auseinandergerissen wird."

#: src-en/data/events_special_defeat.xml:240
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_FEDERATION\"]/text[1]"
msgstr ""
"Eine Föderationscrew ist ausgefallen. Als du ihre Hülle verschrottest, "
"merkst du, dass ihre Funkgeräte noch aktiv sind und der Kommandant ruft "
"immer noch, versucht herauszufinden, was los ist. Du schaltest das Radio "
"stumm und machst weiter."

#: src-en/data/events_special_defeat.xml:241
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_FEDERATION\"]/text[2]"
msgstr ""
"\"Mann down, Mann down! Agh!\" Die Schreie des Crewmitglieds bleiben "
"ungehört, als er zusammen mit dem Rest seiner Crew niedergeschlagen wird."

#: src-en/data/events_special_defeat.xml:242
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_FEDERATION\"]/text[3]"
msgstr ""
"\"Mein Tod bedeutet den Tod der Föderation.\" Der sterbende Kapitän hält "
"inne, als jemand im Hintergrund ihn anschreit. \"Ich überreagiere NICHT! "
"Verdammt... du musstest meine letzten Momente ruinieren...\""

#: src-en/data/events_special_defeat.xml:243
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_FEDERATION\"]/text[4]"
msgstr ""
"\"Mein Name wird in einem Denkmal für meinen Dienst am Multiverse "
"eingemeißelt werden... deiner wird für die kriminell Verrückten auf einer "
"Beobachtungsliste eingraviert...\""

#: src-en/data/events_special_defeat.xml:244
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_FEDERATION\"]/text[5]"
msgstr ""
"\"Ich habe nicht einmal... meine Beförderung bekommen! Ich bin nicht bereit "
"zu sterben!\" Der Föderationskapitän weint in die Hände, während seine Crew "
"eines nach dem anderen fällt und er als Letzter folgt."

#: src-en/data/events_special_defeat.xml:250
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_FEDERATION\"]/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_special_defeat.xml:264
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_FEDERATION\"]/text[1]"
msgstr "\"Das weiterzuführen, wäre Wahnsinn – wir sind auf derselben Seite!\""

#: src-en/data/events_special_defeat.xml:265
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_FEDERATION\"]/text[2]"
msgstr ""
"Das Föderationsschiff ist in Trümmern. Du könntest an dieser Stelle "
"wahrscheinlich ihre Kapitulation aushandeln."

#: src-en/data/events_special_defeat.xml:266
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_FEDERATION\"]/text[3]"
msgstr ""
"\"Bitte, wir müssen das nicht! Wir sind bereit, dir alles zu geben, nur "
"damit wir gehen können!\""

#: src-en/data/events_special_defeat.xml:267
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_FEDERATION\"]/text[4]"
msgstr ""
"\"Vernichtet uns nicht! Wir sind Föderation! Lasst uns wenigstens "
"kapitulieren!\""

#: src-en/data/events_special_defeat.xml:268
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_FEDERATION\"]/text[5]"
msgstr ""
"\"Nehmt alles mit, was wir haben, geht einfach und kein weiteres Blut muss "
"fließen!\""

#: src-en/data/events_special_defeat.xml:269
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_FEDERATION\"]/text[6]"
msgstr ""
"Das Schiff ruft dich wiederholt an und bettelt dich an, den Angriff "
"einzustellen und sie gehen zu lassen."

#: src-en/data/events_special_defeat.xml:277
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_STATION\"]/text[1]"
msgstr ""
"\"MAYDAY! MAYDAY! MA-\" Der verzweifelte Hilferuf des Föderationskapitäns "
"wird durch die Zerstörung der Station abrupt unterbrochen."

#: src-en/data/events_special_defeat.xml:278
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_STATION\"]/text[2]"
msgstr ""
"Wenn zukünftige Schiffe auf diese Wrackstelle stoßen, werden die Leute "
"wahrscheinlich davon ausgehen, dass das die Arbeit von Rebellen oder Piraten"
" war. Aber die Spur wird irgendwann zu euch führen."

#: src-en/data/events_special_defeat.xml:279
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_STATION\"]/text[3]"
msgstr ""
"Schade, die brandneuen Modelle der Föderation so schnell außer Gefecht zu "
"setzen. Als die Föderation mit der Herstellung von aktualisierten Designs "
"Druck machte, hatten sie Konflikte mit Rebellen im Hinterkopf ... aber nicht"
" unbedingt mit ihren eigenen Angestellten, den Renegaten."

#: src-en/data/events_special_defeat.xml:294
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_AUTO\"]/text[1]"
msgstr ""
"\"F-Fehler: Verrat.\" Das Auto-Schiff explodiert. Du empfindest viel weniger"
" Reue, als wäre es ein bemanntes Föderations-Schiff gewesen, aber trotzdem "
"fühlst du dich ein wenig schuldig."

#: src-en/data/events_special_defeat.xml:295
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_AUTO\"]/text[2]"
msgstr ""
"Es ist weniger befriedigend, eine der Kreationen der Föderation zu zerstören"
" als die der Rebellion, aber Schrott ist Schrott."

#: src-en/data/events_special_defeat.xml:296
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_AUTO\"]/text[3]"
msgstr ""
"Während du das Auto-Schiff zerstörst, sendet es eine letzte Nachricht: "
"\"Entschuldigung...\""

#: src-en/data/events_special_defeat.xml:297
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_FEDERATION_AUTO\"]/text[4]"
msgstr ""
"Die Drohne zerbricht unter deinem Feuer. Nun ja, wenigstens war es kein "
"Schiff mit echter Föderations-Crew."

#: src-en/data/events_special_defeat.xml:320
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[1]"
msgstr ""
"Das feurige Rot der Explosionen passt perfekt zur orangefarbenen Hülle des "
"Rebellenschiffs. Zufrieden mit deiner Arbeit, verschrottest du das Schiff."

#: src-en/data/events_special_defeat.xml:321
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[2]"
msgstr ""
"Das Rebellenschiff wird in Flammen gehüllt, die fast sofort erlöschen, als "
"die Hülle aufbricht und den Innenraum dem Vakuum des Weltraums aussetzt. "
"Sobald die Leichen vom Schiff entfernt wurden, verschrottest du den Rest."

#: src-en/data/events_special_defeat.xml:322
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[3]"
msgstr ""
"Das Rebellenschiff explodiert, seine vielen lebenswichtigen Systeme werden "
"zu bloßem Schrottmaterial. Schrottmaterial, das du mitnehmen kannst."

#: src-en/data/events_special_defeat.xml:323
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[4]"
msgstr ""
"Jedes Schiff voller Rebellensauerei, das du zerstörst, macht die Galaxis ein"
" Stückchen sicherer. Es ist nicht viel, aber es ist ehrliche Arbeit."

#: src-en/data/events_special_defeat.xml:324
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[5]"
msgstr ""
"Du erhältst einen Ruf von dem Rebellenschiff, genau in dem Moment, in dem es"
" explodiert, aber es ist zu spät. Das Gesicht des Kapitäns, der um sein "
"Leben fleht, flackert dir kurz vor Augen, bevor er in der Flamme "
"verschwindet."

#: src-en/data/events_special_defeat.xml:325
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[6]"
msgstr ""
"Du weißt, dass die Rebellen auch Familien haben müssen, aber sie sind "
"wahrscheinlich nicht die besten. Oder zumindest hoffst du das."

#: src-en/data/events_special_defeat.xml:326
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[7]"
msgstr ""
"Ein letzter Schuss deiner Waffen hat die Hülle des Rebellenschiffs "
"lahmgelegt. Ein großer Teil an Schrott wartet darauf, von dir mitgenommen zu"
" werden."

#: src-en/data/events_special_defeat.xml:327
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[8]"
msgstr ""
"Der Tod deiner Gegner ist selten so befriedigend wie bei einem "
"Rebellenschiff. Endlich, deine Rache für all das Inferno, das sie der "
"Föderation bereitet haben."

#: src-en/data/events_special_defeat.xml:328
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_REBEL\"]/text[9]"
msgstr ""
"Das Rebellenschiff explodiert und hinterlässt eine ordentliche Menge an "
"nutzbarem Schrottmaterial."

#: src-en/data/events_special_defeat.xml:331
msgid "data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/text"
msgstr ""
"Kurz bevor das Rebellenschiff explodiert, wird eine Rettungskapsel davon "
"abgeworfen. Leider kommt sie nicht weit, bevor du sie einsammelst und an "
"Bord bringst. Du öffnest sie und ziehst den Rebellengefallenen heraus. Er "
"fleht dich an, ihn in Leben zu lassen."

#: src-en/data/events_special_defeat.xml:334
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[@req=\"LIST_CREW_JERRY\"]/text"
msgstr "(Jerry) Willkommen an Bord."

#: src-en/data/events_special_defeat.xml:336
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[@req=\"LIST_CREW_JERRY\"]/event/text"
msgstr ""
"\"Jerry? Wir hätten niemals gekämpft, wenn wir gewusst hätten, dass er an "
"Bord ist. Was auch immer Jerry gerade tut, ich wäre stolz darauf, zu "
"helfen.\""

#: src-en/data/events_special_defeat.xml:341
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[@req=\"LIST_CHECK_ANY_CREW\""
" and @lvl=\"1\"]/text"
msgstr "Lasse sie auf dein Schiff."

#: src-en/data/events_special_defeat.xml:345
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[@req=\"LIST_CHECK_ANY_CREW\""
" and @lvl=\"0\"]/text"
msgstr ""
"Den Rebellen ohne weitere Sicherheiten für seine Loyalität zu akzeptieren, "
"ist zu riskant."

#: src-en/data/events_special_defeat.xml:349
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[@req=\"mind\"]/text"
msgstr ""
"(Gedankenkontrolle) Halte die Gedankenkontrolle aktiv, falls sie sich "
"verdächtig verhalten."

#: src-en/data/events_special_defeat.xml:357
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[5]/text"
msgstr "Setz den Rebell frei und lass ihn gehen."

#: src-en/data/events_special_defeat.xml:361
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[6]/text"
msgstr "Entleere sie."

#: src-en/data/events_special_defeat.xml:363
msgid ""
"data/events_special_defeat.xml$//event[@name=\"DESTROYED_REBEL_POD\"]/choice[6]/event/text"
msgstr ""
"Während du den Rebell an den Armen packst und in die Luftschleuse ziehst, "
"leistet er kaum Widerstand. Eine Träne läuft seine Wange hinab, als er sich "
"aufrichtet und seinem Schicksal entgegenblickt. Du schließt die Luftschleuse"
" erneut, sobald seine Leiche einen sicheren Abstand zum Schiff erreicht hat."

#: src-en/data/events_special_defeat.xml:369
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_ACCEPT\"]/event[1]/text"
msgstr ""
"Der Rebell ist dir dankbar, dass du ihn verschont hast, obwohl das bedeutet,"
" dass er seine ursprüngliche Sache verraten muss."

#: src-en/data/events_special_defeat.xml:373
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_ACCEPT\"]/event[2]/text"
msgstr ""
"Der Rebell gibt sich dankbar, doch diese Fassade zerbricht schnell, als er "
"ein Laserwaffe zieht und eines deiner Crewmitglieder beschießt! Er schreit "
"„Rebellion für immer!“, bevor er zurückbeschossen wird. Du ziehst die "
"leblose Leiche zur Luftschleuse und schleudert sie in das endlose Vakuum des"
" Weltraums."

#: src-en/data/events_special_defeat.xml:376
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_ACCEPT\"]/event[2]/removeCrew/text"
msgstr ""
"Glücklicherweise wird dein toter Crewmitglied gerade zum Klonen gebracht."

#: src-en/data/events_special_defeat.xml:382
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_MIND\"]/event[1]/text"
msgstr ""
"Der Rebell ist dir dankbar, dass du ihn verschont hast, obwohl das bedeutet,"
" dass er seine ursprüngliche Sache verraten muss. Sieht so aus, als "
"bräuchten wir die Gedankensteuerung doch nicht mehr."

#: src-en/data/events_special_defeat.xml:386
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_MIND\"]/event[2]/text"
msgstr ""
"Der Rebell gibt sich dankbar, doch diese Fassade zerbricht schnell, als er "
"eine Laserwaffe zieht und schießen will! Zum Glück stoppt ihn die "
"Gedankensteuerung, und er sinkt zu Boden. Du eilst herbei, um ihn aus der "
"Luftschleuse zu ziehen."

#: src-en/data/events_special_defeat.xml:391
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_SAVE\"]/event[1]/text"
msgstr ""
"Zuerst glaubt er, dass es ein Trick ist, aber sobald der Rebell sicher ist, "
"dass du ihn nicht in den Rücken stechen wirst, bietet er dir ein paar Güter "
"an, welcher er geborgen hat, als Dankeschön. Es scheint nicht jeder Rebell "
"ist kaltherzig."

#: src-en/data/events_special_defeat.xml:395
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_SAVE\"]/event[2]/text"
msgstr ""
"Zuerst glaubt er, dass es ein Trick ist, aber sobald der Rebell sicher ist, "
"dass du ihn nicht in den Rücken stechen wirst, bietet er dir ein paar Güter "
"an, welcher er geborgen hat, als Dankeschön. Es scheint nicht jeder Rebell "
"ist kaltherzig."

#: src-en/data/events_special_defeat.xml:399
msgid ""
"data/events_special_defeat.xml$//eventList[@name=\"DESTROYED_REBEL_POD_SAVE\"]/event[3]/text"
msgstr ""
"Der Rebell macht deine Entscheidung nicht leicht, da er dich weiter aus dem "
"Frachtraum heraus beschimpft, bis du ihn freigegeben hast. Es ist fast "
"sicher, dass er dich verraten wird, aber du bist kein Mörder, wenn du eine "
"Wahl hast."

#: src-en/data/events_special_defeat.xml:409
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_REBEL\"]/text[1]"
msgstr ""
"Für jeden Rebell, den du tötest, denkst du an alle Föderationsbeamten und "
"Zivilisten, die du indirekt gerettet hast. Eine ganze Crew von Rebellen tot,"
" eine ganze Crew Unschuldiger, die du gerettet hast."

#: src-en/data/events_special_defeat.xml:410
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_REBEL\"]/text[2]"
msgstr ""
"Als der Kapitän des Rebellenschiffs vor deinen Augen knieend zusammenbricht,"
" winkt er dich näher. Er flüstert: „Verdammt... du...“ und fällt leblos zu "
"Boden."

#: src-en/data/events_special_defeat.xml:411
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_REBEL\"]/text[3]"
msgstr ""
"Da das Rebellenschiff nun ohne Crew ist, kannst du die Überreste beliebig "
"zerlegen."

#: src-en/data/events_special_defeat.xml:412
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_REBEL\"]/text[4]"
msgstr ""
"Die Schreie der Rebellencrew sind endlich verstummt. Du fühlst fast Mitleid."
" Fast."

#: src-en/data/events_special_defeat.xml:413
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_REBEL\"]/text[5]"
msgstr ""
"Während du durch das Innere des Rebellenschiffs gehst, siehst du immer noch "
"die zuckenden Leichen der Soldaten. Es ist ziemlich makaber, aber du fühlst "
"überhaupt nichts."

#: src-en/data/events_special_defeat.xml:414
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DEAD_CREW_REBEL\"]/text[6]"
msgstr ""
"Du empfindest keinerlei Mitleid für die nun toten Rebellen und zerlegst ihr "
"Schiff voller Verachtung."

#: src-en/data/events_special_defeat.xml:421
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_ESCAPE_REBEL\"]/text[1]"
msgstr ""
"Du hörst, wie der Rebellenchef Befehle an seine Crew gibt. „Verdammt das! "
"Leite so viel Energie wie nötig auf die Triebwerke um. Wir müssen hier "
"raus!“"

#: src-en/data/events_special_defeat.xml:422
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_ESCAPE_REBEL\"]/text[2]"
msgstr ""
"Du bemerkst, wie die Triebwerke des Rebellenschiffs aufleuchten. Die "
"versuchen zu fliehen!"

#: src-en/data/events_special_defeat.xml:423
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_ESCAPE_REBEL\"]/text[3]"
msgstr ""
"Es ist selten, dass Rebellen versuchen, vor einer Schlacht zu fliehen, aber "
"dieses Schiff priorisiert sein Überleben."

#: src-en/data/events_special_defeat.xml:424
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_ESCAPE_REBEL\"]/text[4]"
msgstr ""
"An dem massiven Anstieg der Triebwerksleistung des Feindes merkst du, dass "
"das Schiff versucht zu fliehen."

#: src-en/data/events_special_defeat.xml:437
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_GOTAWAY_REBEL\"]/text[1]"
msgstr ""
"Der Rebellenchef lacht, als er wegspringt und dich allein bei dem "
"Signalpunkt zurücklässt."

#: src-en/data/events_special_defeat.xml:438
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_GOTAWAY_REBEL\"]/text[2]"
msgstr "\"Das wirst du bereuen!\" Das Rebellenschiff springt davon."

#: src-en/data/events_special_defeat.xml:439
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_GOTAWAY_REBEL\"]/text[3]"
msgstr ""
"Du fluchst leise, als die Triebwerke des Rebellenschiffs ein letztes Mal "
"aufflackern und es davonspringt."

#: src-en/data/events_special_defeat.xml:440
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_GOTAWAY_REBEL\"]/text[4]"
msgstr ""
"Das Rebellenschiff entkommt. Du konzentrierst dich auf die Reparaturen, die "
"nach diesem erfolglosen Kampf nötig sind."

#: src-en/data/events_special_defeat.xml:443
msgid ""
"data/events_special_defeat.xml$//event[@name=\"GOTAWAY_REBEL_REMAINS\"]/text"
msgstr ""
"Das Rebellenschiff springt davon. Zuerst bist du enttäuscht, aber dann "
"merkst du, dass ein Teil von Schrott vom Kampf zurückgeblieben ist. Es ist "
"nicht viel, aber es mildert den Schlag deines Misserfolgs ein wenig."

#: src-en/data/events_special_defeat.xml:459
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_REBEL_GENERIC\"]/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_special_defeat.xml:468
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[1]"
msgstr ""
"Der Rebellenchef meldet sich bei dir. Im Hintergrund siehst du das Chaos, "
"das deine Waffen angerichtet haben. \"Na gut, du gewinnst. Wir "
"kapitulieren.\""

#: src-en/data/events_special_defeat.xml:469
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[2]"
msgstr ""
"Es ist selten, dass ein Rebellenschiff sich einer Föderation-Einheit ergibt,"
" aber das scheint einer dieser Fälle zu sein."

#: src-en/data/events_special_defeat.xml:470
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[3]"
msgstr ""
"\"Na gut, wir kapitulieren! Wenn deine Behauptungen, die Föderation sei eine"
" so wohlwollende Macht, stimmen, dann musst du unsere Kapitulation "
"akzeptieren!\""

#: src-en/data/events_special_defeat.xml:471
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[4]"
msgstr ""
"\"Bah, fein. Angesichts dessen, wie korrupt ihr Föderationsbeamten seid, "
"kann vielleicht ein bisschen Schrott überzeugen, dass ihr uns gehen lässt?\""

#: src-en/data/events_special_defeat.xml:472
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[5]"
msgstr ""
"Das Rebellenschiff ist am Ende seines Treibstoffs. Der Rebellenchef fleht "
"keuchend darum, dass sie leben dürfen."

#: src-en/data/events_special_defeat.xml:473
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[6]"
msgstr ""
"\"Na gut, du hast bewiesen, dass du im Kampf überlegen bist. Jetzt beweise "
"uns, dass du so verzeihend bist, wie du sagst.\""

#: src-en/data/events_special_defeat.xml:474
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[7]"
msgstr ""
"Endlich scheint das Rebellenschiff nachzugeben. Sie bieten ihre Kapitulation"
" an."

#: src-en/data/events_special_defeat.xml:475
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[8]"
msgstr ""
"\"Mist, ich kann nicht glauben, dass ich das diesen Föderations-Schrott "
"sage... wenn wir dir das aus unserem Vorrat geben, lässt du uns leben?\""

#: src-en/data/events_special_defeat.xml:476
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[9]"
msgstr ""
"\"In Ordnung, in Ordnung! Du gewinnst. Das Kommando wird uns nie verzeihen, "
"dass wir dich gehen lassen, aber wenigstens werden wir am Leben sein, um "
"unseren eigenen Dienst zu verabschieden. Willst du unsere Kapitulation "
"akzeptieren?\""

#: src-en/data/events_special_defeat.xml:477
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[10]"
msgstr ""
"Das Schiff der Rebellen hat keine Lust mehr auf Kämpfe. Sie grüßen dich "
"verzweifelt."

#: src-en/data/events_special_defeat.xml:478
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_GENERIC\"]/text[11]"
msgstr ""
"\"Das Kommando muss nicht wissen, dass wir dich hier getroffen haben. Lass "
"uns einfach gehen, und wir geben dir, was wir haben.\""

#: src-en/data/events_special_defeat.xml:483
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_REBEL_DEMAND\"]/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_special_defeat.xml:492
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_DEMAND\"]/text[1]"
msgstr ""
"\"Das ist kein Scherz. Du bist zu weit gegangen. Weißt du, wer ich bin? Ich "
"bin für die Rebellion von entscheidender Bedeutung. Ich fordere, dass du "
"mich leben lässt!\""

#: src-en/data/events_special_defeat.xml:493
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_DEMAND\"]/text[2]"
msgstr ""
"Das Schiff der Rebellen grüßt dich. \"Keine weiteren Spiele. Du lässt uns "
"leben, oder du wirst den Zorn der Rebellion erfahren!\""

#: src-en/data/events_special_defeat.xml:494
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_DEMAND\"]/text[3]"
msgstr ""
"\"Die Rebellion wird niemals sterben! Jedes Rebellen-Schiff, das du tötest, "
"wird eure Bestrafung nur nach unserem unvermeidlichen Sieg größer machen. "
"Lass uns gehen.\""

#: src-en/data/events_special_defeat.xml:499
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_REBEL_FLEET\"]/choice[1]/text"
msgstr ""
"Akzeptiere ihre Kapitulation. [Verlangsamt die Flotte um zwei Sprünge]"

#: src-en/data/events_special_defeat.xml:501
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_REBEL_DELAY\"]/text"
msgstr ""
"Die Rebellen versprechen, die Flotte aufzuhalten und dann zu springen."

#: src-en/data/events_special_defeat.xml:512
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_FLEET\"]/text[1]"
msgstr ""
"\"Schau mal, vielleicht können wir beide etwas aus dieser Situation machen. "
"Ich weiß, dass die Flotte ein Problem für dich ist. Wenn du uns leben lässt,"
" können wir der Flotte etwas über deinen Standort belügen. Die werden es nie"
" erfahren, bis es zu spät ist.\""

#: src-en/data/events_special_defeat.xml:513
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_FLEET\"]/text[2]"
msgstr ""
"Das Schiff der Rebellen kapituliert und verspricht, die Flotte aufzuhalten, "
"wenn du sie leben lässt."

#: src-en/data/events_special_defeat.xml:514
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_FLEET\"]/text[3]"
msgstr ""
"\"Wenn du uns tötest, gewinnst du nichts als ein bisschen nutzlosen Schrott."
" Wir sind für dich am Leben viel nützlicher. Lass uns gehen, und wir können "
"die Flotte für dich aufhalten.\""

#: src-en/data/events_special_defeat.xml:528
msgid ""
"data/events_special_defeat.xml$//event[@name=\"SURRENDER_REBEL_STATION_GENERIC\"]/choice[1]/text"
msgstr "Akzeptiere ihre Kapitulation."

#: src-en/data/events_special_defeat.xml:537
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[1]"
msgstr ""
"Der Rebellenchef meldet sich bei dir. Im Hintergrund siehst du das Chaos, "
"das deine Waffen angerichtet haben. \"Na gut, du gewinnst. Wir "
"kapitulieren.\""

#: src-en/data/events_special_defeat.xml:538
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[2]"
msgstr ""
"Es ist selten, dass Rebellen ihren Stolz verwerfen und sich einem Gegner der"
" Föderation ergeben, aber das scheint eines dieser Male zu sein."

#: src-en/data/events_special_defeat.xml:539
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[3]"
msgstr ""
"\"Na gut, wir kapitulieren! Wenn deine Behauptungen, die Föderation sei eine"
" so wohlwollende Macht, stimmen, dann musst du unsere Kapitulation "
"akzeptieren!\""

#: src-en/data/events_special_defeat.xml:540
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[4]"
msgstr ""
"\"Ach, gut. Angesichts dessen, wie korrupt ihr Föderationsbeamten seid, "
"könnte vielleicht ein bisschen Schrott euch überzeugen, uns in Ruhe zu "
"lassen?\""

#: src-en/data/events_special_defeat.xml:541
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[5]"
msgstr ""
"Die Rebellenstation hat katastrophale Schäden erlitten. Der Rebellenchef "
"keucht schwer und fleht dich an, sie in Leben zu lassen."

#: src-en/data/events_special_defeat.xml:542
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[6]"
msgstr ""
"\"Na gut, du hast bewiesen, dass du im Kampf überlegen bist. Jetzt beweise "
"uns, dass du so verzeihend bist, wie du sagst.\""

#: src-en/data/events_special_defeat.xml:543
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[7]"
msgstr ""
"Endlich scheint die Rebellenstation nachzugeben. Sie bieten ihre "
"Kapitulation an."

#: src-en/data/events_special_defeat.xml:544
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_SURRENDER_REBEL_STATION_GENERIC\"]/text[8]"
msgstr ""
"\"Mist, ich kann nicht glauben, dass ich das diesen Föderations-Schrott "
"sage... wenn wir dir das aus unserem Vorrat geben, lässt du uns leben?\""

