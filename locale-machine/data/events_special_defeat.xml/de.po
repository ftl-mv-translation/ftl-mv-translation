msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_AUTO\"]/text[2]"
msgstr ""
"Auto-Schiffe zu zerstören, wird eines der wenigen Dinge sein, die du "
"vermissen wirst, wenn die Rebellion verschwunden ist. Wenn sie jemals "
"verschwunden sind, das ist."

#: src-en/data/events_special_defeat.xml:592
msgid ""
"data/events_special_defeat.xml$//textList[@name=\"TEXT_DESTROYED_AUTO\"]/text[3]"
