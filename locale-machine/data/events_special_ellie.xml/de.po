#: src-en/data/events_special_ellie.xml:338
msgid ""
"data/events_special_ellie.xml$//event[@name=\"ELLIE_HUEGHEY_2\"]/choice/event/choice[2]/event/text"
msgstr ""
"Ellie dreht sich ungläubig zu dir um. Du sagst ihr, dass sich das alles "
"nicht lohnt, aber sie scheint dich nicht zu hören. Du bist gezwungen, sie "
"aus dem Gebäude zu zerren, und zwar schnell. Als der Sicherheitsdienst "
"eintrifft, bist du schon weg."

#: src-en/data/events_special_ellie.xml:349
msgid ""
"data/events_special_ellie.xml$//event[@name=\"ELLIE_HUEGHEY\"]/choice[@req=\"LIST_CREW_ELLIE\""
" and @lvl=\"1\"]/event/choice[2]/text"
