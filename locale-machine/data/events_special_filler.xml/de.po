msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_QUEST_ESCORT\"]/choice[3]/event/text"
msgstr ""
"Die Zivilisten sind schockiert über deine plötzliche Feindseligkeit, haben "
"aber keine Chance zu entkommen."

#: src-en/data/events_special_filler.xml:5101
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_QUEST_ESCORT\"]/choice[3]/event/choice/text"
