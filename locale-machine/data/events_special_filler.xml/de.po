"data/events_special_filler.xml$//event[@name=\"QUEST_STORE_RESCUE_MV\"]/beaconType/unvisitedTooltip"
msgstr "Ein Rebell-Schiff belästigt einen Raumhafen an diesen Koordinaten."

#: src-en/data/events_special_filler.xml:5289
msgid ""
"data/events_special_filler.xml$//event[@name=\"QUEST_STORE_RESCUE_MV\"]/text"
msgstr ""
"Sobald du am Signalpunkt angekommen bist, entdeckst du einen Späher der "
