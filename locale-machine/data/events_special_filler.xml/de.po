msgid "data/events_special_filler.xml$//event[@name=\"FILLER_EXPLODED\"]/text"
msgstr ""
"In der Nähe ist ein kritisch beschädigtes ziviles Frachtschiff. Scans "
"zeigen, dass ihre Lebenserhaltungssysteme außer Funktion sind und sie nicht "
"lange überleben werden."

#: src-en/data/events_special_filler.xml:1996
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_EXPLODED\"]/choice[1]/text"
