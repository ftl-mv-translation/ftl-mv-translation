"das Schiff vollständig einsatzbereit ist."

#: src-en/data/events_special_filler.xml:2214
msgid ""
"data/events_special_filler.xml$//eventList[@name=\"FILLER_GHOSTSHIP_BOARDING\"]/event[2]/choice[1]/event/choice/text"
