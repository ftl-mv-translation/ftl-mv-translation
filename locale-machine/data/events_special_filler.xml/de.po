#: src-en/data/events_special_filler.xml:3515
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_DISTRESS_COMBAT\"]/choice[@req=\"FLARE_DISTRACTION\"]/event/text"
msgstr ""
