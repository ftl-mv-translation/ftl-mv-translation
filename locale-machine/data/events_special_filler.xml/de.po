"data/events_special_filler.xml$//event[@name=\"FILLER_QUEST_ESCORT\"]/choice[2]/event/text"
msgstr ""
"\"Wir verstehen das. Nicht jeder traut sich zu, in diesen feindseligen "
"Zeiten zu überleben, geschweige denn die Verantwortung für den Schutz "
"anderer zu übernehmen.\""

#: src-en/data/events_special_filler.xml:5086
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_QUEST_ESCORT\"]/choice[2]/event/choice[1]/text"
