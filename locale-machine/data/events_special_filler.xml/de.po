#: src-en/data/events_special_filler.xml:2010
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_EXPLODED\"]/choice[4]/event/text"
msgstr ""
"Die Zivilisten haben nach dieser Explosion keine Chance überlebt. Du machst "
"weiter."

#: src-en/data/events_special_filler.xml:2012
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_EXPLODED\"]/choice[4]/event/choice[1]/text"
