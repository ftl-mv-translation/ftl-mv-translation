#: src-en/data/events_special_filler.xml:5600
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_INFORMANT\"]/choice[2]/text"
msgstr "Versuch, mit ihnen zu reden."

#: src-en/data/events_special_filler.xml:5602
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_INFORMANT\"]/choice[2]/event/text"
msgstr ""
"\"Die Föderation ist in ihren Philosophien veraltet! Der Aufstand wird uns "
"eine glorreiche Galaxie... nein, ein Multiversum frei von xeno Schrott "
"bieten!\""

#: src-en/data/events_special_filler.xml:5604
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_INFORMANT\"]/choice[2]/event/choice[@req=\"LIST_CREW_JERRY\"]/text"
msgstr "(Jerry) Überzeuge sie weiter."

#: src-en/data/events_special_filler.xml:5606
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_INFORMANT\"]/choice[2]/event/choice[@req=\"LIST_CREW_JERRY\"]/event/text"
msgstr ""
"Jerry weiß, wie es ist, ein Rebell gewesen zu sein, und enthüllt den "
"Zivilisten die Brutalität und Heuchelei des Aufstands. Sie sind so verblüfft"
" von diesen Informationen, dass sie sogar Vorräte für deine Sache anbieten."

#: src-en/data/events_special_filler.xml:5611
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_INFORMANT\"]/choice[2]/event/choice[@req=\"human_mfk\"]/text"
msgstr "(MFK Ace Crew) Überzeuge sie weiter."

#: src-en/data/events_special_filler.xml:5613
msgid ""
"data/events_special_filler.xml$//event[@name=\"FILLER_INFORMANT\"]/choice[2]/event/choice[@req=\"human_mfk\"]/event/text"
msgstr ""
