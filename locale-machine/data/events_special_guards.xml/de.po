msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS\"]/choice[2]/text"
msgstr "Versuche zu kommunizieren."

#: src-en/data/events_special_guards.xml:11957
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS\"]/choice[@req=\"LIST_CREW_LANIUS_SWARM\"]/text"
msgstr "(Lanius Crew) Kommunizieren."

#: src-en/data/events_special_guards.xml:11961
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS\"]/choice[4]/text"
msgstr "Gib ihnen etwas Schrott, vielleicht ist das, was sie wollen?"

#: src-en/data/events_special_guards.xml:11963
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS\"]/choice[4]/event/text"
msgstr ""
"Das Lanius-Schiff lässt ein paar Lanius-Soldaten aussteigen, die den Schrott"
" aufheben und dann zurück in ihr Schiff gezogen werden."

#: src-en/data/events_special_guards.xml:11968
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS\"]/choice[4]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_guards.xml:11970
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS\"]/choice[4]/event/choice/event/text"
msgstr ""
"\"Alle wach, danke ja. Spende, Akzeptiere Rückgabe.\" Ein Flakwerfer wird "
"aus ihrem Schiff ausgeworfen."

#: src-en/data/events_special_guards.xml:11980
msgid ""
"data/events_special_guards.xml$//eventList[@name=\"GUARD_LANIUS_COMMUNICATE\"]/event[1]/text"
msgstr ""
"Du weißt nicht, ob du die Lanius versehentlich mit etwas gesagt hast, sie "
"beleidigt hast, indem du versuchst, Kontakt aufzunehmen, oder ob sie immer "
"feindselige Absichten hatten, aber der Lanius-Wächter verschwendet keine "
"Zeit mehr und greift dich an."

#: src-en/data/events_special_guards.xml:11983
msgid ""
"data/events_special_guards.xml$//eventList[@name=\"GUARD_LANIUS_COMMUNICATE\"]/event[1]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_guards.xml:11988
