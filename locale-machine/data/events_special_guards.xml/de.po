msgid ""
"data/events_special_guards.xml$//event[@name=\"REINFORCEMENTS_LANIUS\"]/beaconType/unvisitedTooltip"
msgstr "Ein unbesuchter Ort."

#: src-en/data/events_special_guards.xml:12061
