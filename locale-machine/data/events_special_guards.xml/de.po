msgid ""
"data/events_special_guards.xml$//event[@name=\"START_SPIDER\"]/choice/event/choice/event/choice/event/choice[1]/event/text"
msgstr ""
"\"In der Nähe gibt es einen Handelsstützpunkt, der dir helfen wird, dich "
"einzurichten, bevor du losziehst. Sei vorsichtig, diese riesigen "
"außerirdischen Spinnen ... die sind kein Spaß.\""

#: src-en/data/events_special_guards.xml:3545
