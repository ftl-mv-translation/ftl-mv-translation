#: src-en/data/events_special_guards.xml:10877
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_HIVE\"]/choice[@req=\"unique_kaz\"]/event/text"
msgstr ""
"\"Wir... wir sind endlich im Hive? Ich hätte nicht gedacht, dass ich diesen "
"Ort noch einmal sehen würde. Wenn wir hier sind... bedeutet das, dass ich "
