#: src-en/data/events_special_guards.xml:11373
msgid "data/events_special_guards.xml$//event[@name=\"GUARD_ROCKHOME\"]/text"
msgstr ""
"Dieser Signalpunkt wird von einer Elite-Rock-Wache beschützt, gesteuert von "
"Rockman-Kreuzrittern und Kristallwesen. \"Außenstehende sind hier nicht "
"willkommen! Die heiligen Schriften gebieten, dass Häretiker aus dieser "
"Existenzebene entfernt werden müssen.\""

#: src-en/data/events_special_guards.xml:11375
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCKHOME\"]/choice[1]/text"
msgstr "Nun... vielleicht sind die heiligen Schriften falsch?"

#: src-en/data/events_special_guards.xml:11377
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCKHOME\"]/choice[1]/event/text"
msgstr ""
"\"Wie kannst du es wagen, die Worte der Ältesten zu verspotten! Welche Lügen"
" wurden dir eingepflanzt, damit du solch falsche Gedanken hast?\""

#: src-en/data/events_special_guards.xml:11379
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCKHOME\"]/choice[1]/event/choice[1]/text"
msgstr "Ihr seid diejenigen, die Lügen gefüttert bekommen habt."

#: src-en/data/events_special_guards.xml:11381
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCKHOME\"]/choice[1]/event/choice[1]/event/text"
msgstr ""
"\"Ihr seid einfältig und töricht. Es seid solche wie ihr, die dem Aufbruch "
"verwehren, den uns unsere kristallinen Götter versprochen haben! Die "
"Inquisition wird euch schnell erledigen.\""

#: src-en/data/events_special_guards.xml:11384
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCKHOME\"]/choice[1]/event/choice[1]/event/choice/text"
