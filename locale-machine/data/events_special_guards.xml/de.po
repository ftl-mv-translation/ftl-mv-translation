"data/events_special_guards.xml$//eventList[@name=\"GUARD_HACKED_QUESTION\"]/event[2]/choice[2]/event/text"
msgstr ""
"Ein Hacker-Schiff tarnt sich in der Nähe. \"Ihr Föderationsleute seid "
"einfach zu stur, um mitzuspielen, oder?\""

#: src-en/data/events_special_guards.xml:6649
msgid ""
"data/events_special_guards.xml$//eventList[@name=\"GUARD_HACKED_QUESTION\"]/event[2]/choice[2]/event/choice/text"
