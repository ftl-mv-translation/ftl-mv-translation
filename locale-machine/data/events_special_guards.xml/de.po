msgid "data/events_special_guards.xml$//event[@name=\"GUARD_ZOLTAN_DEMAND\"]/text"
msgstr ""
"\"Ein unüberlegter Akt. Warum sollte das Ministerium seinen Sitz in der "
"Föderation behalten, wenn es uns nur den Respektlosigkeit der Schlächter aus"
