msgstr "Entschuldigen und trennen."

#: src-en/data/events_special_guards.xml:7129
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and @lvl=\"-999\"]/event/choice[2]/event/choice[3]/event/text"
msgstr "Du hast jetzt etwas Zeit, um etwas auf dem Schiff zu tun."

#: src-en/data/events_special_guards.xml:7131
