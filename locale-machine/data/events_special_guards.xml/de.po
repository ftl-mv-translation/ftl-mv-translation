"data/events_special_guards.xml$//event[@name=\"GUARD_UNION_COREWORLDS\"]/choice[@req=\"LIST_CREW_FEDERATION_ELITE_EASTER\"]/event/text"
msgstr ""
"Dein Crewmitglied lässt dich schnell durch die Sicherheitskontrolle, und mit"
" ein bisschen zusätzlicher Verhandlung überzeugt er die Schiffe der Miliz, "
"deine Hülle zu reparieren."

#: src-en/data/events_special_guards.xml:7817
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_UNION_COREWORLDS\"]/choice[@req=\"unique_haynes\"]/text"
msgstr ""
