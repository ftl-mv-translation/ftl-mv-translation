#: src-en/data/events_special_guards.xml:11684
msgid ""
"data/events_special_guards.xml$//event[@name=\"REINFORCEMENTS_CRYSTALHOME\"]/beaconType/undiscoveredTooltip"
msgstr "Ein unbesuchter Ort."

#: src-en/data/events_special_guards.xml:11686
msgid ""
"data/events_special_guards.xml$//event[@name=\"REINFORCEMENTS_CRYSTALHOME\"]/text"
msgstr ""
"\"Außenseiter, wir wussten, dass ihr barbarisch seid, aber als wir "
"hierherzogen, ahnten wir nicht, dass ihr unseren Sektor betreten und unsere "
"Lebensweise mit solch gewalttätigen Akten bedrohen würdet! Wir werden für "
"unsere gefallenen Brüder auf dem Wächter-Schiff rache nehmen, das ihr so "
"rücksichtslos zerstört habt!\""

#: src-en/data/events_special_guards.xml:11690
msgid ""
"data/events_special_guards.xml$//event[@name=\"REINFORCEMENTS_CRYSTALHOME\"]/choice/text"
