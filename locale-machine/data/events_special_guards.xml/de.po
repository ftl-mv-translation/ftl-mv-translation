msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_UNION_COREWORLDS\"]/choice[@req=\"LIST_CREW_FEDERATION_ELITE_EASTER\"]/text"
msgstr ""
"(Elite-Crew der Föderation) Gib schnell deine Föderations-ID ab und fordere "
"Reparaturen an."

