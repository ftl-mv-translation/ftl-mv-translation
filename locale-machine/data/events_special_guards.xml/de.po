#: src-en/data/events_special_guards.xml:7115
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and @lvl=\"-999\"]/event/choice[2]/event/text"
msgstr ""
"Der Wächter sieht verwirrt aus. \"Was willst du denn noch? Ich habe dir "
"gesagt, du kannst kostenlos passieren.\""

#: src-en/data/events_special_guards.xml:7117
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and @lvl=\"-999\"]/event/choice[2]/event/choice[1]/text"
msgstr "Nach Nachschub fragen."

#: src-en/data/events_special_guards.xml:7119
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and @lvl=\"-999\"]/event/choice[2]/event/choice[1]/event/text"
msgstr ""
"Der Wächter lacht verächtlich. \"Hier gibt's keine kostenlosen Geschenke, "
"Renegade. Hör auf, meine Zeit zu verschwenden, und beweg dich weiter.\""

#: src-en/data/events_special_guards.xml:7123
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and @lvl=\"-999\"]/event/choice[2]/event/choice[2]/text"
msgstr "Nachschub fordern."

#: src-en/data/events_special_guards.xml:7127
