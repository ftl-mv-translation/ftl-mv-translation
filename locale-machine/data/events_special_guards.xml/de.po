msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HUNTGROUNDS\"]/choice[@req=\"mantis_free\"]/text"
msgstr "(Free Mantis Crew) Überzeuge sie, dir den Weg freizumachen."

#: src-en/data/events_special_guards.xml:8450
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HUNTGROUNDS\"]/choice[@req=\"mantis_free\"]/event/text"
msgstr ""
"Dein Free Mantis spricht kurz mit dem Wächter, aber es sieht so aus, als "
"hätten sie ihn bereits überzeugt, dich ohne weitere Fragen passieren zu "
"lassen."

#: src-en/data/events_special_guards.xml:8454
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HUNTGROUNDS\"]/choice[@req=\"mantis_warlord\"]/text"
msgstr ""
