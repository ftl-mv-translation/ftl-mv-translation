"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS_FOLLOWUP\"]/text"
msgstr ""
"Indem du den Lanius-Wächter getötet hast, hast du mit ziemlicher Sicherheit,"
" dass sie Verstärkung entsenden, um dich aufzuspüren. Pass gut auf, während "
"du den Sektor erkundest."

#: src-en/data/events_special_guards.xml:12048
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_LANIUS_FOLLOWUP\"]/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_special_guards.xml:12052
