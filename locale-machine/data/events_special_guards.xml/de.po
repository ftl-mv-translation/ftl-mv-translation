#: src-en/data/events_special_guards.xml:4161
msgid "data/events_special_guards.xml$//event[@name=\"GUARD_ROCK\"]/text"
msgstr ""
"Der Wächter grüßt dich. \"Du wagst es, in das heilige Land des Älteren "
"einzudringen? Wir werden euch vernichten!\""

#: src-en/data/events_special_guards.xml:4163
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCK\"]/choice[1]/text"
msgstr "Mach dich bereit zum Kampf!"

#: src-en/data/events_special_guards.xml:4165
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_ROCK\"]/choice[1]/event/text"
msgstr ""
"Ihr rennt zu den Verteidigungspositionen, als die Wache bedrohlich näher "
"kommt."

#: src-en/data/events_special_guards.xml:4168
