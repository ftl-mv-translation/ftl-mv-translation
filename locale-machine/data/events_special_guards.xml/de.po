#: src-en/data/events_special_guards.xml:12812
msgid "data/events_special_guards.xml$//event[@name=\"GUARD_HEKTAR\"]/text"
msgstr ""
"\"Grüß euch, geschätzte Kundschaft! Willkommen im Hektar Industrie-Straßen "
"(™) MEGA-MARKT (™) von Hektar. Es ist immer wunderbar, neue Schuldner in "
"diesen Teilen zu sehen!\""

#: src-en/data/events_special_guards.xml:12814
msgid "data/events_special_guards.xml$//event[@name=\"GUARD_HEKTAR\"]/choice/text"
msgstr "Danke – Moment, hast du uns gerade Schuldner genannt?"

#: src-en/data/events_special_guards.xml:12816
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HEKTAR\"]/choice/event/text"
msgstr ""
"\"Oh je, schon wieder einer! Ihr frischgebackenen seid immer so überrascht. "
"Ja, ich fürchte, ihr habt riesige Schulden bei Hektar Industrie! Wusstet ihr"
" denn nicht, dass jeder U.W.U.-Punkt, den ihr sammelt, mit einer Gebühr von "
"625 Schrott verbunden ist? Jawohl, ihr schuldet uns jetzt insgesamt 2500 "
"Schrott! Ein ziemliches Dilemma...\""

#: src-en/data/events_special_guards.xml:12818
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HEKTAR\"]/choice/event/choice/text"
msgstr "Nun, was machen wir denn bloß?"

#: src-en/data/events_special_guards.xml:12820
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HEKTAR\"]/choice/event/choice/event/text"
msgstr ""
"\"Ach, das ist ganz einfach. Ihr zahlt es, oder ihr bleibt hier für immer. "
"Mach dir keine Sorgen, falls du bleiben musst, Hektar Industrie verkauft "
"praktisch alles, was du brauchst, um ein schmerzhaft ausreichendes Leben als"
" Mindestlohnarbeiter zu führen! Viel Glück!\""

#: src-en/data/events_special_guards.xml:12822
msgid ""
"data/events_special_guards.xml$//event[@name=\"GUARD_HEKTAR\"]/choice/event/choice/event/choice[1]/text"
msgstr "Sicher gibt es IRGENDEIS, was wir tun können!"

