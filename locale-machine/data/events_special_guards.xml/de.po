#: src-en/data/events_special_guards.xml:7141
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and @lvl=\"-999\"]/event/choice[2]/event/choice[@req=\"unique_ivar\"]/text"
msgstr "(Ivar) Lass Ivar ran."

#: src-en/data/events_special_guards.xml:7143
msgid ""
"data/events_special_guards.xml$//event[@name=\"START_ASTEROID_VAMPWEED\"]/choice[@req=\"rep_comb_vampweed\""
" and "
"@lvl=\"-999\"]/event/choice[2]/event/choice[@req=\"unique_ivar\"]/event/text"
msgstr ""
"\"Was wollen wir? Nun, wir durchqueren nur – wir bräuchten nur ein bisschen Hilfe mit dem.\" \n"
"\n"
"\"Premier?? Ich hätte nicht erwartet, dass du hier bist. Was genau willst du, dass wir machen?\"\n"
"\n"
"\"Die Rebellenflotte kommt. Wenn du sie für uns aufhalten könntest, wäre das sehr hilfreich.\"\n"
"\n"
"\"Ich schätze, das können wir. Gute Reise.\" "

#: src-en/data/events_special_guards.xml:7154
