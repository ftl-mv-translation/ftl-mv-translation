#: src-en/data/events_special_multiverse.xml:832
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"THE_JUDGES_ZOLTAN\"]/choice[@req=\"slug_knight\"]/text"
msgstr "Präsentiere einen Nachtritter."

#: src-en/data/events_special_multiverse.xml:834
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"THE_JUDGES_ZOLTAN\"]/choice[@req=\"slug_knight\"]/event/text"
msgstr ""
"\"Der Klügste aller Slugs... die Nachtritter repräsentieren das Beste... die"
" Paradebeispiele jeder Tugend – und jeder Sünde –, die die Slugs schätzen. "
"Ein solches Crew könnte als... Anklage betrachtet werden... aber ich bin "
"einfach nur beeindruckt. Gut gemacht, Reisender. Erwarte... Belohnungen vor "
"deiner nächsten Reise.\""

#: src-en/data/events_special_multiverse.xml:838
