#: src-en/data/events_special_multiverse.xml:4542
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_MISSILES\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, jeder selbstrespektierende Renegade weiß, dass er "
"ein bisschen Ausrüstung braucht, um zu überleben.\""

#: src-en/data/events_special_multiverse.xml:4552
msgid "data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_TRASH\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, als Renegade weißt du doch genau, wie nützlich Müll "
"auf deinem eigenen Schiff ist! Ja, ich verkaufe dir Müll. Sei nicht sauer.\""

#: src-en/data/events_special_multiverse.xml:4562
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_ATTRIBUTES\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, jeder selbstrespektierende Renegade weiß, dass er "
"ein bisschen Ausrüstung braucht, um zu überleben.\""

#: src-en/data/events_special_multiverse.xml:4572
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_STATUS\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, was ist ein kleines Kriegsverbrechen während des "
"Krieges, eh? Ich habe meine Tentakel an ein bisschen neuer Technik, komm mal"
" schauen!\""

#: src-en/data/events_special_multiverse.xml:4582
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_UTILITY\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, nicht jede Waffe muss tödlich sein. Ich weiß, du "
"stimmst wahrscheinlich nicht zu, aber ohh Fremder, ich habe an ein paar "
"Unterstützungswaffen, die dich interessieren könnten.\""

#: src-en/data/events_special_multiverse.xml:4592
msgid "data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_RACE\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, ich war in ein paar verschiedenen Sektoren, und habe"
" ein paar seltene Waffen gefunden, die dich interessieren könnten.\""

#: src-en/data/events_special_multiverse.xml:4602
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_MINELAUNCHERS\"]/text"
msgstr ""
"\"Vertrau mir, Fremder, ich habe auf meinen Reisen eine ziemlich "
"umfangreiche Sammlung von Minenwerfern gesammelt. Man kann sie sogar "
"benutzen, um Verfolger aufzuhalten, obwohl man sich zurückhalten sollte. "
"Schau mal!\""

#: src-en/data/events_special_multiverse.xml:4613
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_HEKTAR\"]/text"
msgstr ""
"\"Vertrau mir, Fremder, ich werde nicht von Hektar Industries gesponsert. "
"Dennoch stellen sie, so schattig sie auch sind, einige feine Waffen her. Ich"
" habe ein paar extra Waffen und Module in meinem Lager, komm mal schauen!\""

#: src-en/data/events_special_multiverse.xml:4623
msgid "data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_RARE\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, ich habe ein paar seltene Sachen zu verkaufen, "
"Fremder!\""

#: src-en/data/events_special_multiverse.xml:4633
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_DRONES\"]/text"
msgstr ""
"\"Ach. Fremder Fremder, normalerweise verkaufe ich Waffen, aber ich habe in "
"letzter Zeit einen ziemlich großen Vorrat an Drohnen gesammelt. Vielleicht "
"könntest du eine benutzen?\""

#: src-en/data/events_special_multiverse.xml:4643
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_ANCIENT\"]/text"
msgstr ""
"\"Aaaaah. Fremd, fremd, hab vor einer Weile diese spooky Ruine gefunden, und"
" drinnen war Tech, die weder du noch ich je gesehen haben! Komm, sieh es dir"
" an.\""

