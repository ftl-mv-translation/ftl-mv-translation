msgid "data/events_special_multiverse.xml$//event[@name=\"NEMESIS_SPEECH\"]/text"
msgstr ""
"\"Wir treffen uns wieder, mein Erzfeind! Mwahaha! Ich bin es, Leah die "
"Zerstörerin, die Vorbote des Chaos, die Verdammnis der Unwürdigen! Die Macht"
" der Rebellion, das Zentrum ihrer Stärke.\""

