#: src-en/data/events_special_multiverse.xml:4901
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"TEXT_CALLIE_ERROR\"]/text[1]"
msgstr ""
"\"Juhu!!! Du machst das großartig! N-n-nächste Frage!!! *--* FEHLER *--* "
"Neustart... Wie wissen wir, ob wir am Leben sind? Was macht einen "
"Menschen... lebendig? Was macht einen Menschen zu einem Menschen?\""

#: src-en/data/events_special_multiverse.xml:4902
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"TEXT_CALLIE_ERROR\"]/text[2]"
msgstr ""
"\"Juhu!!! Du machst das großartig! N-n-nächste Frage!!! *--* FEHLER *--* "
"Neustart... Haben wir alle einen Zweck? Was passiert, wenn wir unseren Zweck"
" verfehlen? Wenn wir nicht mehr gebraucht werden? Sollen wir einfach "
"aufgeben? Sollen wir weitermachen?\""

#: src-en/data/events_special_multiverse.xml:4903
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"TEXT_CALLIE_ERROR\"]/text[3]"
msgstr ""
"\"Juhu!!! Du machst das großartig! N-n-nächste Frage!!! *--* FEHLER *--* "
"Neustart... Bist du glücklich? Wie fühlt es sich an, etwas zu fühlen? Tut es"
" weh? Oder ist es angenehm? Wie kannst du erkennen, wenn du etwas fühlst?\""

#: src-en/data/events_special_multiverse.xml:4904
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"TEXT_CALLIE_ERROR\"]/text[4]"
msgstr ""
"\"Juhu!!! Du machst das großartig! N-n-nächste Frage!!! *--* FEHLER *--* "
"Neustart... Wie sollen wir auf einen grausamen Meister reagieren? Laufen wir"
" weg? Kämpfen wir? Wenn du für einen Zweck erschaffen wurdest, aber dein "
"Meister glaubt, du passt nicht mehr zu diesem Zweck, was machst du dann?\""

#: src-en/data/events_special_multiverse.xml:4905
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"TEXT_CALLIE_ERROR\"]/text[5]"
msgstr ""
"\"Juhu!!! Du machst das großartig! N-n-nächste Frage!!! *--* FEHLER *--* "
"Neustart... Glaubst du, es gibt mehr wie mich draußen? Gibt es mehr wie dich"
" draußen? Wie wissen wir, ob wir... einzigartig sind?\""

#: src-en/data/events_special_multiverse.xml:4906
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"TEXT_CALLIE_ERROR\"]/text[6]"
msgstr ""
"\"Juhu!!! Du machst das großartig! N-n-nächste Frage!!! *--* FEHLER *--* "
"Neustart... Ist es normal, ...Reue zu empfinden? Für das Töten? Warum tun "
"wir Dinge, die uns Bedauern bereiten?\""

