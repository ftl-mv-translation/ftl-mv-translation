#: src-en/data/events_special_multiverse.xml:1999
msgid "data/events_special_multiverse.xml$//event[@name=\"NEMESIS_ESTATE\"]/text"
msgstr ""
"\"Ich hab mich gefragt, ob ich dich hier sehen würde, Mistkerl! Nicht cool, "
"so in meinem Papi's Zuhause aufzutauchen! Wenn du dich mit den Wentworths "
"anlegst, läufst du mit mir, Mistkerl!\""

#: src-en/data/events_special_multiverse.xml:2002
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"NEMESIS_ESTATE\"]/choice/text"
msgstr "Vance ist dein Vater?!"

#: src-en/data/events_special_multiverse.xml:2004
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"NEMESIS_ESTATE\"]/choice/event/text"
msgstr ""
"\"Äh... na ja, nein... Ich nenn ihn einfach Papi. Weil äh, jaaaa. Wir sind "
"wie Familie. Naja, wir wären es. Wahrscheinlich. Ich hab ihn nie wirklich "
"getroffen, haha... Aber wir würden uns total verstehen. Wir haben, wie "
"gesagt, die gleiche Persönlichkeit und alles. Außerdem sind sein Neffe und "
"ich wie beste Freunde. Ja. Schau nicht drauf. Oh, und halt die Klappe, "
"Mistkerl! Jetzt lass mich dich umbringen!\""

#: src-en/data/events_special_multiverse.xml:2006
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"NEMESIS_ESTATE\"]/choice/event/choice[1]/text"
msgstr "Jetzt geht das schon wieder los."

