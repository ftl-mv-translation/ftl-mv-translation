"NAME]?\""

#: src-en/data/events_special_multiverse.xml:4967
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"ENCOUNTER_CALLIE_ANOMALY\"]/choice[2]/event/choice/text"
