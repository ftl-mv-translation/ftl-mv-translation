#: src-en/data/events_special_multiverse.xml:2041
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"NEMESIS_JERRY_NOCREW\"]/choice/event/text"
msgstr ""
"\"Hah, spiel nicht so verlegen! Jerry, Admirals Vances Neffe! Der ist wie "
"mein Bruder! Naja, nicht wirklich, mein richtiger Bruder ist ein Arschloch. "
"Aber Jerry, Mann? Wir kennen uns ewig. Wie, beste Freunde. Beste Freunde für"
" immer, das ist es! Hahaha... ja. Frag bloß nicht danach. Das ist wahr. Ich "
"schwör's dir. Wie auch immer, nicht cool, Beyatch! Zum Glück für Jerry war "
"ich, sein definitiv bester Freund, hier, um dich aufzuhalten!\""

#: src-en/data/events_special_multiverse.xml:2043
