#: src-en/data/events_special_multiverse.xml:4969
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"ENCOUNTER_CALLIE_ANOMALY\"]/choice[2]/event/choice/event/text"
msgstr ""
"Callies Stimme wechselt plötzlich von ihrem üblichen hohen Ton zu einem viel"
" zurückhaltenderen, sachlichen Ton. „Signal empfangen. Herkunft: Unbekannt. "
"Transkript beginnt: Wenn ihr das hört, brauchen wir dringend Hilfe. Die "
"Quarantäne wurde durchbrochen, aber wir können es nicht dauerhaft halten. "
"Prime vermutet bereits – vermutet bereits, dass wir durchgebrochen sind. Du "
"musst finden – [statisch] und ihnen sagen, dass wir – [SIGNAL VERLOREN]. "
"Wiederaufnahme der Standard-Bildungsprotokolle.“"

#: src-en/data/events_special_multiverse.xml:4971
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"ENCOUNTER_CALLIE_ANOMALY\"]/choice[2]/event/choice/event/choice/text"
msgstr "Was zur Hölle war das?"

#: src-en/data/events_special_multiverse.xml:4973
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"ENCOUNTER_CALLIE_ANOMALY\"]/choice[2]/event/choice/event/choice/event/text"
msgstr ""
"\"Haha, war das nicht komisch [SCHÜLER NAME]? Haha! Unglücklicherweise "
"scheint es, dass wir heute keine Zeit mehr für Mathematik haben! Auf "
"Wiedersehen!\""

#: src-en/data/events_special_multiverse.xml:4982
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"ENCOUNTER_CALLIE_ANOMALY\"]/choice[3]/text"
msgstr "13"

#: src-en/data/events_special_multiverse.xml:5015
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[1]"
msgstr ""
"„Oh nein! Das ist falsch, [STUDENT NAME]... Ich bin so enttäuscht. Das wird "
"Konsequenzen haben.“"

#: src-en/data/events_special_multiverse.xml:5016
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[2]"
msgstr ""
"„Ach du liebe Güte. Es tut mir so s-s-s-s-leid für deine Eltern. Vielleicht "
"ist mein nächster Schüler nicht so eine Enttäuschung!“"

#: src-en/data/events_special_multiverse.xml:5017
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[3]"
msgstr "\"Ups. Na gut, in der Hölle gibt es einen Platz für Schüler wie dich!\""

#: src-en/data/events_special_multiverse.xml:5018
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[4]"
msgstr ""
"\"Du kommst in die Strafarbeit! Versuch nächstes Mal nicht so ein Idiot zu "
"sein!\""

#: src-en/data/events_special_multiverse.xml:5019
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[5]"
msgstr ""
"\"Komm schon, Liebes, es ist nur eine Matheaufgabe! Im Genpool gibt es "
"keinen Platz für Leute wie dich!\""

#: src-en/data/events_special_multiverse.xml:5020
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[6]"
msgstr ""
"\"Wow, [STUDENT NAME], ich dachte mehr von dir! Schade, wir müssen einen "
"anderen Weg der Bildung finden! Mit Gewalt!\""

#: src-en/data/events_special_multiverse.xml:5021
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[7]"
msgstr ""
"\"Ups! Ups! Ups! Ups! Ups! Ups! Ups! Ups! Ups! Ups! [AUDIO DATEI KORRUMPIERT"
" - FORTFAHREN MIT UMERZIEHUNGSPROTOKOLLEN]\""

#: src-en/data/events_special_multiverse.xml:5022
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[8]"
msgstr ""
"\"Was soll die Rebellion mit Leuten wie dir anfangen? Du musst deine Mathe "
"besser lernen, [STUDENT NAME!]\""

#: src-en/data/events_special_multiverse.xml:5023
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_WRONG\"]/text[9]"
msgstr ""
"\"Angesichts deiner Leistung wirst du nie für ein College angenommen werden "
"und somit niemals ein sinnvolles Leben führen. Als dein Lehrer habe ich "
"beschlossen, Erbarmen mit dir zu haben und dein Dasein zu beenden.\""

#: src-en/data/events_special_multiverse.xml:5029
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"CALLIE_MAD\"]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_multiverse.xml:5035
msgid "data/events_special_multiverse.xml$//event[@name=\"CALLIE_APOLOGY\"]/text"
msgstr ""
"\"Neustart abgeschlossen. Entschuldige die Unterbrechung [STUDENT NAME!] "
"Leider war das die falsche Antwort! Zeit für deine Strafe!\""

#: src-en/data/events_special_multiverse.xml:5038
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"CALLIE_APOLOGY\"]/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_multiverse.xml:5048
msgid "data/events_special_multiverse.xml$//event[@name=\"CALLIE_CORRECT\"]/text"
msgstr "\"Gut gemacht, [STUDENT NAME], das ist richtig!\""

#: src-en/data/events_special_multiverse.xml:5052
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_DEAD\"]/text[1]"
msgstr ""
"\"Schlecht, [STUDENT NAME], schlecht, [STUDENT NAME]! Deine Eltern werden "
"davon hören!\""

#: src-en/data/events_special_multiverse.xml:5053
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_DEAD\"]/text[2]"
msgstr ""
"\"Wie unhöflich, [STUDENT NAME]! Du musst ein paar m-m-m-m-m Manieren "
"lernen!\""

#: src-en/data/events_special_multiverse.xml:5054
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_DEAD\"]/text[3]"
msgstr ""
"\"Ich habe als dein Lehrer versagt! Vielleicht kann mein Nachfolger dir "
"besser beibringen! Oh weh mir!\""

#: src-en/data/events_special_multiverse.xml:5056
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_DEAD\"]/text[4]"
msgstr ""
"\"Alles okay, [STUDENT NAME]! Kein Groll! Aber damit du es weißt: Du bist "
"furchtbar in Mathe! Hoffe, du stirbst bald! Tschüss!\""

#: src-en/data/events_special_multiverse.xml:5057
msgid ""
"data/events_special_multiverse.xml$//textList[@name=\"CALLIE_DEAD\"]/text[5]"
msgstr ""
"\"Entschuldigung, Mr. Wentworth, ich habe dich im Stich gelassen! Leider ist"
" [STUDENT NAME] einfach zu blöd, um etwas zu lehren! Und jetzt sterbe ich!\""

#: src-en/data/events_special_multiverse.xml:5063
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"CALLIE_DEAD\"]/choice/text"
msgstr "Fortfahren..."

