#: src-en/data/events_special_multiverse.xml:1979
msgid "data/events_special_multiverse.xml$//event[@name=\"NEMESIS_SPIDER\"]/text"
msgstr ""
"\"Hahahah! Ich dachte, ich finde dich hier! Dachtest du, du könntest vor mir"
" weglaufen, dein Erzfeind? Nun, du hast dich geirrt! Und ich habe eine "
"besondere Überraschung für dich... Ich habe gerade eine ARMY außerirdischer "
"Spinnen gekauft, die ich gegen deine Crew entfesseln und euch vernichten "
"werde!\""

#: src-en/data/events_special_multiverse.xml:1982
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"NEMESIS_SPIDER\"]/choice/text"
msgstr "Woher hast du Spinnen?"

#: src-en/data/events_special_multiverse.xml:1984
msgid ""
"data/events_special_multiverse.xml$//event[@name=\"NEMESIS_SPIDER\"]/choice/event/text"
msgstr ""
"\"Oh, dieser Brut-Typ hat sie mir verkauft. Und noch reduziert! Die Kästen "
"waren irgendwie zu klein. Aber das ist egal... mach dich bereit, dein Ende "
"zu sehen, Mistkerl!\""

#: src-en/data/events_special_multiverse.xml:1987
