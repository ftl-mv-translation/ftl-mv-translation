msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"SYLVAN_GIFT_LASTSTAND\"]/text"
msgstr ""
"\"Ssstranger, Ssstranger, das ist es also, oder? Nun, ich würde das nie mit "
"jemand anderem machen... aber ich mag dich, Ssstranger. Und du hast gerade "
"viel Druck auf dir. Hier, ein bisschen Schrott, gratis. Das wäre erledigt, "
"möchtest du handeln?\""

