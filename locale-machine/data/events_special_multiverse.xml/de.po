#: src-en/data/events_special_multiverse.xml:14
msgid ""
"data/events_special_multiverse.xml$/FTL/event[@name=\"DOOR_OPEN_SONG_NEW\"]/choice/event/text"
msgstr ""
"\"Das ist das Lied vom Öffnen der Tür! Die Kultur der Echsen beinhaltet "
"viele Tänze und Gesänge. Auf die Art, wie du an der Tür klopfst, um "
"einzutreten, tanzen wir das Lied vom Öffnen der Tür! Es ist ein Lied sowohl "
"zum Bittgebet um eintreten als auch um Dank für die Erlaubnis. Sehr heilig, "
"sehr wichtig.\""

#: src-en/data/events_special_multiverse.xml:17
