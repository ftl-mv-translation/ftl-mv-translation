#: src-en/data/events_special_standard.xml:2392
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_FED_AUTO\"]/choice[2]/event/text"
msgstr ""
"Solange sie nicht voller Föderations-Crew ist, wird dich nichts davon "
"abhalten, dieses Schiff zu plündern. Ehrlich gesagt, selbst wenn sie voller "
"Crew wäre, würde dich das wahrscheinlich auch nicht abhalten."

#: src-en/data/events_special_standard.xml:2395
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_FED_AUTO\"]/choice[2]/event/choice/text"
