#: src-en/data/events_special_standard.xml:2407
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_FED_MARKET\"]/text"
msgstr ""
"In diesem System wurde ein großer ziviler Markt eingerichtet. Verbündete "
"Föderationsschiffe patrouillieren das Gebiet, um sicherzustellen, dass sich "
"keine Rebellen oder Piraten einschleichen."

#: src-en/data/events_special_standard.xml:2409
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_FED_MARKET\"]/choice[1]/text"
msgstr "Betrete den Markt."

#: src-en/data/events_special_standard.xml:2413
