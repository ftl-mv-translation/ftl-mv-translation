#: src-en/data/events_special_standard.xml:2415
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_FED_MARKET\"]/choice[2]/event/text"
msgstr ""
"Die Föderationssoldaten sind froh über eine Pause, und ihre Führung willigt "
"ein, dich Wache halten zu lassen. Deine Schicht dauert einen Sprungzyklus – "
"hoffentlich passiert nichts Schlimmes."

#: src-en/data/events_special_standard.xml:2418
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_FED_MARKET\"]/choice[2]/event/choice/text"
msgstr "Warte …"

