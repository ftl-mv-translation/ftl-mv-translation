#: src-en/data/events_special_standard.xml:4003
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ORCHID_FIRE\"]/text"
msgstr ""
"Kaum bist du beim nahegelegenen Planeten angekommen, bemerkst du gewaltige "
"Rauchschwaden, die von gut der Hälfte des nahegelegenen Marktes aufsteigen. "
"Ein Orchid-Händler ruft dich, ziemlich panisch wirkend. \"K-kein Grund zur "
"Sorge wegen des Feuers. Ist keine große Sache. Kommt rein und kauft ein!\""

