"data/events_special_standard.xml$//event[@name=\"STOREEVENT_WEATHER_STUCK\"]/choice[1]/event/choice[2]/event/text"
msgstr ""
"Nach kurzem Suchen findest du einen Markt, obwohl die Geschäfte anscheinend "
"schlecht laufen. Der Ladenbesitzer scheint es eilig zu haben, für die Nacht "
"abzuschließen, lässt dich aber kurz umsehen."

#: src-en/data/events_special_standard.xml:2286
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_WEATHER_STUCK\"]/choice[1]/event/choice[2]/event/choice/text"
