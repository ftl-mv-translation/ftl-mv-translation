#: src-en/data/events_special_standard.xml:13038
msgid ""
"data/events_special_standard.xml$//event[@name=\"EMPTY_AUTO\"]/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_special_standard.xml:13042
msgid ""
"data/events_special_standard.xml$//event[@name=\"EMPTY_AUTO\"]/choice[2]/text"
msgstr "Nichts tun."

#: src-en/data/events_special_standard.xml:13047
msgid "data/events_special_standard.xml$//textList[@name=\"EMPTY_AUTO\"]/text[1]"
msgstr ""
"In einer fernen Entfernung liegt eine verlassene Werft. Sie scheint nicht "
"lohnend genug für eine Bergung zu sein."

#: src-en/data/events_special_standard.xml:13048
msgid "data/events_special_standard.xml$//textList[@name=\"EMPTY_AUTO\"]/text[2]"
msgstr ""
"Die leere Hülle eines einstigen Auto-Schiffs treibt in der Nähe, von Piraten"
" bis zur Unbrauchbarkeit zerlegt."

#: src-en/data/events_special_standard.xml:13049
msgid "data/events_special_standard.xml$//textList[@name=\"EMPTY_AUTO\"]/text[3]"
msgstr ""
"Dieser Signalpunkt ist überraschend leer, einer der wenigen, die die "
"Rebellen noch nicht mit ihrer Autotechnik geplündert haben."

#: src-en/data/events_special_standard.xml:13050
msgid "data/events_special_standard.xml$//textList[@name=\"EMPTY_AUTO\"]/text[4]"
msgstr ""
"Es scheint, als hätte sich das automatisierte Gebiet der Werft noch nicht "
"bis zu diesem Signalpunkt ausgebreitet."

#: src-en/data/events_special_standard.xml:13051
msgid "data/events_special_standard.xml$//textList[@name=\"EMPTY_AUTO\"]/text[5]"
msgstr ""
"Abgesehen von einigen entfernten Gerüsten ist dieser Signalpunkt völlig leer"
" und bietet nichts von Interesse."

#: src-en/data/events_special_standard.xml:13057
msgid ""
"data/events_special_standard.xml$//event[@name=\"EMPTY_MANTIS\"]/choice[1]/text"
msgstr "Tue etwas an Bord des Schiffs."

#: src-en/data/events_special_standard.xml:13061
msgid ""
"data/events_special_standard.xml$//event[@name=\"EMPTY_MANTIS\"]/choice[2]/text"
