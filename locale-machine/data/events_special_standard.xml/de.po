#: src-en/data/events_special_standard.xml:3009
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_SMITH\"]/text"
msgstr ""
"Die Engi können unglaubliche Dinge vollbringen, mit nur einem Haufen "
"Schrott. Der Engi Drohnenhersteller, im kleinen Markt in der Nähe, bietet an"
" Drohnenblaupausen herzustellen, falls die nötige Bezahlung vorhanden ist."

#: src-en/data/events_special_standard.xml:3011
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_SMITH\"]/choice[@req=\"LIST_CREW_ENGI\"]/text"
msgstr "(Engi-Crew) Bitte um ein paar kostenlose Drohnenteile."

#: src-en/data/events_special_standard.xml:3013
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_SMITH\"]/choice[@req=\"LIST_CREW_ENGI\"]/event/text"
