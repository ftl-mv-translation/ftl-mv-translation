msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_WEATHER_STUCK\"]/choice[2]/event/text"
msgstr ""
"Während du wartest, bis der FTL-Antrieb geladen ist, bemerkst du einen "
"Asteroidensturm, der sich dem Mond nähert. Gut, dass du dich entschieden "
"hast, nicht näher heranzufliegen."

#: src-en/data/events_special_standard.xml:2325
msgid ""
