#: src-en/data/events_special_standard.xml:3050
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_ENGINES\"]/text"
msgstr ""
"Ein Engi-Schiff ruft: \"Triebwerks-Verbesserung notwendig für Reise nach "
"Hause. Verkauf von Ausrüstung notwendig für Triebwerks-Verbesserung.\""

#: src-en/data/events_special_standard.xml:3054
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_ENGINES\"]/choice[1]/text"
msgstr "Sieh dir an, was zum Verkauf steht."

#: src-en/data/events_special_standard.xml:3058
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_ENGINES\"]/choice[2]/text"
msgstr "Das ist der perfekte Zeitpunkt für einen Angriff!"

#: src-en/data/events_special_standard.xml:3060
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_ENGINES\"]/choice[2]/event/text"
msgstr ""
"Zum Pech dieser Engi werden sie nicht nach Hause kommen, ohne vorher an dir "
"vorbeizukommen."

#: src-en/data/events_special_standard.xml:3063
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ENGI_ENGINES\"]/choice[2]/event/choice/text"
