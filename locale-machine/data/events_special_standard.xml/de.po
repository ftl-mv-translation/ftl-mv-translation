msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ORCHID_FIRE\"]/choice[2]/event/text"
msgstr ""
"\"Oh … das brennt schon seit Tagen. Wir haben alles getan, was wir mit "
"unseren Mitteln konnten, um es einzudämmen … was nicht viel ist …\""

