msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ORCHID_FIRE\"]/choice[1]/text"
msgstr "Sieh dir den Markt an."

#: src-en/data/events_special_standard.xml:4010
msgid ""
"data/events_special_standard.xml$//event[@name=\"STOREEVENT_ORCHID_FIRE\"]/choice[2]/text"
msgstr "Biete Hilfe beim Feuer an."

