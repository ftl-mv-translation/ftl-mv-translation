#: src-en/data/events_special_storage.xml:39009
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_vampweed\"]/text"
msgstr "Konföderations-Kreuzer"

#: src-en/data/events_special_storage.xml:39011
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_vampweed\"]/event/text"
msgstr ""
"KLASSE: Confederate-Kreuzer\n"
"\t\t\tFRAKTION: Die Vampweed Confederacy\n"
"\t\t\t\n"
"\t\t\tAls die deutlich militaristischere Orchideen-Fraktion entwickelte die Confederacy Kreuzerklasse-Schiffe schon lange vor der Gathering. Obwohl die Vampweeds kaum die Absicht hatten, ihre Floral-Gegenstücke auszulöschen, konnte ihre stärkere Flotte trotz des Bevölkerungsunterschieds das Kräfteverhältnis zwischen den Orchideen-Fraktionen ausgleichen – zumindest bis das Eingreifen der Theocracy den Florals einen gewaltigen Vorteil verschaffte. Jahre später leisteten Kreuzer wie diese der Hive im Föderation-Mantis-Krieg erhebliche Unterstützung. Heutzutage sind sie ein selteneres Bild, da noch ausgefeiltere Vampweed-Kreuzer sie zunehmend verdrängen."

#: src-en/data/events_special_storage.xml:39017
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_vampweed\"]/event/choice/text"
