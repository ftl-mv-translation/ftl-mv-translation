#: src-en/data/events_special_storage.xml:38995
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_orchid\"]/text"
msgstr "Gathering-Kreuzer"

#: src-en/data/events_special_storage.xml:38997
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_orchid\"]/event/text"
msgstr ""
"KLASSE: Gathering-Kreuzer\n"
"\t\t\tFRAKTION: Die Floral Gathering\n"
"\t\t\t\n"
"\t\t\tObwohl die Gathering mehrere Gartenwelten besitzt, auf denen sie ihre Flotten heranzüchten, sind nur wenige davon groß genug, um solche Kreuzer wachsen zu lassen. Selbst die frühesten Modelle dieser Kreuzer nutzten die FTL-Antriebstechnologie, welche die Gathering ursprünglich von der Theocracy erhielt, und waren gut genug bewaffnet, um jede potenzielle Vampweed-Offensive abzuwehren. Auch wenn Schiffe wie diese der normalerweise pazifistischen Art der Florals zu widersprechen scheinen, ist es tatsächlich der beeindruckenden Stärke ihrer Kreuzer zu verdanken, dass ihre friedliche Lebensweise der Stärke ihrer Feinde standhalten kann."

#: src-en/data/events_special_storage.xml:39003
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_orchid\"]/event/choice/text"
