#: src-en/data/events_special_storage.xml:38827
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_separatist\"]/text"
msgstr "Separatisten-Kreuzer"

#: src-en/data/events_special_storage.xml:38829
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_separatist\"]/event/text"
msgstr ""
"KLASSE: Separatisten-Kreuzer\n"
"\t\t\tFRAKTION: Engi-Separatisten\n"
"\t\t\t\n"
"\t\t\tDie Schiffe der Engi-Separatisten ähneln denen der Engi-Harmony, sogar bis hin zu Gerüchten, dass sich besagte Schiffe \"paaren\" und dabei größere Schiffe bilden. Es wird debattiert, ob die geringere Crew-Kapazität dieser Schiffe auf die Vorlieben der Separatisten zurückgeht oder ihre Crew-Drohnen-Technologie besser unterstützen soll. Bislang hat diese Debatte keine klare Antwort geliefert. Das Design des Kreuzers unterscheidet sich deutlich von dem der Harmony-Kreuzer, was ein Zeichen für die Stärke der separatistischen Bewegung sein könnte."

#: src-en/data/events_special_storage.xml:38835
msgid ""
