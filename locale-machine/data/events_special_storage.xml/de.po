#: src-en/data/events_special_storage.xml:38911
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_rock\"]/text"
msgstr "Theocracy-Kreuzer"

#: src-en/data/events_special_storage.xml:38913
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_rock\"]/event/text"
msgstr ""
"KLASSE: Theocracy-Kreuzer\n"
"\t\t\tFRAKTION: Die Rock-Theocracy\n"
"\t\t\t\n"
"\t\t\tIm Vergleich zu den meisten Fraktionen entwickelte die Theocracy schon deutlich früher Schiffe der Kreuzerklasse. Über die Gründe wird viel spekuliert, wobei oft angenommen wird, dass die Ältesten jener Zeit überkompensierten, um zu verhindern, dass andere aufstrebende Zivilisationen ihre Vormachtstellung über die Rock-Gesellschaft bedrohen könnten. Dieser Kreuzer ist keines dieser früheren Modelle, sondern ein kompakteres Design, das sich als leichter in Serie produzierbar erwiesen hat – weshalb es nicht nur von der Spitze des Theocracy-Militärs eingesetzt wird."

#: src-en/data/events_special_storage.xml:38919
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_rock\"]/event/choice/text"
