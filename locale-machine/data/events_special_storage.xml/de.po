#: src-en/data/events_special_storage.xml:38939
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_crystal\"]/text"
msgstr "Imperial-Kreuzer"

#: src-en/data/events_special_storage.xml:38941
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_crystal\"]/event/text"
msgstr ""
"KLASSE: Imperial-Kreuzer\n"
"\t\t\tFRAKTION: Kristallines Reich\n"
"\t\t\t\n"
"\t\t\tDie Ursprünge des ursprünglichen Designs des Imperial-Kreuzers liegen im Dunkel der Geschichte, auch wenn manche Historiker (oder angehende Grabräuber) behaupten, sie seien tief in der uralten Gruft des längst verstorbenen Kaisers Ycathine versiegelt, errichtet unter Wria, den Kristallinen Heimatwelten. Kaum jemand glaubt das wirklich, da das Gewölbe wahrscheinlich gar nicht existiert, und zahlreiche Leute sind schon aufgetaucht, die behaupteten, Nachfahren des ursprünglich verantwortlichen Ingenieurs zu sein. Darunter ein paar Kristall-Aristokraten, eine 20-fach entfernte Cousine von Kaiserin Dianesh und einmal sogar ein ziemlich wahnhafter Leech."

#: src-en/data/events_special_storage.xml:38947
msgid ""
