"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_dessius\"]/text"
msgstr "Dessius der Reaper"

#: src-en/data/events_special_storage.xml:39675
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_dessius\"]/event/text"
msgstr ""
"PROFIL: Dessius Yan Tartodicus\n"
"\t\t\tTitel: Erster Reaper der Spectral Dynasty\n"
"\t\t\tSpezies: Phantom Alpha - Alter: 784 - Geschlecht: k. A.\n"
"\t\t\t\n"
"\t\t\tDessius ist der 16. Erste Reaper und schon sehr lange dabei. So lange, dass er sich noch an eine Zeit vor der Föderation erinnern kann. Die Wahrheit ist, er weiß, dass hinter der Auto-Bedrohung mehr steckt, als dass sie bloß 'Dämonen' sind, doch er kann sein Volk nicht ohne massive Panik davon in Kenntnis setzen. Er hat sein Vertrauen in dein Wissen über CICA und das Flaggschiff gesetzt, und wenn deine Informationen stimmen, könntest du endlich Frieden zwischen der Dynasty und der Föderation stiften."

#: src-en/data/events_special_storage.xml:39682
