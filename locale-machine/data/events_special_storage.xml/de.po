#: src-en/data/events_special_storage.xml:39299
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_a55\"]/text"
msgstr "Captain A5540L3"

#: src-en/data/events_special_storage.xml:39301
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_a55\"]/event/text"
msgstr ""
"PROFIL: Captain A5540L3\n"
"\t\t\tTitel: Piratenkönig\n"
"\t\t\tSpezies: Cognitive - Alter: 8 - Geschlecht: Männlich\n"
"\t\t\t\n"
"\t\t\tA55 ist eines von nur drei bekannten Cognitives in der Galaxis, neben CICA und der Harmony. Von der Rebellion nach dem Bürgerkrieg geschaffen, um CICA nachzubilden, begannen die Ingenieure ihn A5540L3 zu nennen – bis die KI rebellierte und aus der Gefangenschaft entkam, wobei sie ihren Titel behielt. Wie er zum Piratenkönig wurde, liegt etwas im Dunkeln, und A55 selbst scheint da widersprüchliche Geschichten zu erzählen, aber am Ende zählt nur, dass er auf deiner Seite steht – und nicht auf der der Rebellion."

#: src-en/data/events_special_storage.xml:39308
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_a55\"]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_storage.xml:39314
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_jerry\"]/text"
msgstr "Jerry"

#: src-en/data/events_special_storage.xml:39316
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_jerry\"]/event/text"
msgstr ""
"PROFIL: Jerome Wentworth\n"
"\t\t\tTitel: Rebellenoffizier\n"
"\t\t\tSpezies: Mensch - Alter: 23 - Geschlecht: Männlich\n"
"\t\t\t\n"
"\t\t\tJerome, oder \"Jerry\", wie er lieber genannt wird, ist der Neffe von niemand anderem als Admiral Vance selbst. Früher wollte er unbedingt wie sein Onkel werden, doch nach einer unschönen Erfahrung bei einem Überfall auf Orchideen-Raum änderte sich das. Bevor er dich traf, war er nicht selbstbewusst genug, um sich Vance entgegenzustellen – jetzt aber hofft er, an die gute Seite appellieren zu können, von der er weiß, dass sie noch in ihm steckt, und diesem Krieg vielleicht ein Ende zu setzen."

#: src-en/data/events_special_storage.xml:39323
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_jerry\"]/event/choice/text"
