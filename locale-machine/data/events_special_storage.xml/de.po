"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_ruwen\"]/text"
msgstr "Ruwen"

#: src-en/data/events_special_storage.xml:39555
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_CREW\"]/choice[@req=\"ach_crew_ruwen\"]/event/text"
msgstr ""
"PROFIL: Sir Ruwen Argote\n"
"\t\t\tTitel: Auswärtiger Botschafter des Kristallinen Reiches\n"
"\t\t\tSpezies: Crystal - Alter: ??? - Geschlecht: Männlich\n"
"\t\t\t\n"
"\t\t\tRuwen ist der offizielle Botschafter des Kristallinen Reiches gegenüber der Außenwelt. Aufgrund seiner einzigartigen Rolle an Bord des Schiffs, das das ursprüngliche Flaggschiff besiegte, für diesen Posten ausgewählt, hat Ruwen beide Seiten kennengelernt. Mach dir keine Illusionen – Ruwens Loyalität gilt stets zuerst dem Reich, doch er teilt bei weitem nicht die gleiche fremdenfeindliche Haltung wie viele andere Crystals."

#: src-en/data/events_special_storage.xml:39562
