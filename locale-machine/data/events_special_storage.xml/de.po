"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_coalition\"]/event/choice/text"
msgstr "Fortfahren..."

#: src-en/data/events_special_storage.xml:39066
msgid ""
"data/events_special_storage.xml$//event[@name=\"STORAGE_CHECK_STATUS_MV\"]/choice[@req=\"ach_mv_equinoid\"]/text"
