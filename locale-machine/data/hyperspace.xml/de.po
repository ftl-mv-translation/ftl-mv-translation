#: src-en/data/hyperspace.xml:20643
msgid ""
"data/hyperspace.xml$//race[@name=\"orchid_praetor\"]/powerEffect/buttonText"
msgstr "SPOREN"

#: src-en/data/hyperspace.xml:20644
